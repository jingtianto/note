<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Excel批量关键词检索工具</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: "Microsoft Yahei", sans-serif;
        }
        body {
            padding: 20px;
            background-color: #f5f7fa;
        }
        .container {
            max-width: 1400px;
            margin: 0 auto;
            background: #fff;
            padding: 24px;
            border-radius: 10px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        }
        .title {
            font-size: 20px;
            margin-bottom: 20px;
            color: #1f2937;
        }
        .input-area {
            margin-bottom: 16px;
        }
        .input-desc {
            font-size: 14px;
            color: #6b7280;
            margin-bottom: 8px;
        }
        #keywordInput {
            width: 100%;
            height: 140px;
            padding: 12px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-size: 14px;
            resize: vertical;
        }
        .btn-group {
            display: flex;
            gap: 12px;
            margin: 16px 0;
            align-items: center;
        }
        button {
            padding: 10px 24px;
            border-radius: 6px;
            border: none;
            font-size: 14px;
            cursor: pointer;
            transition: 0.2s;
        }
        #startBtn {
            background-color: #2563eb;
            color: white;
        }
        #startBtn:disabled {
            background-color: #94a3b8;
            cursor: not-allowed;
        }
        #clearResBtn {
            background-color: #e5e7eb;
            color: #374151;
        }
        #stopScanBtn {
            background-color: #f87171;
            color: white;
            display: none;
        }
        .folder-select-wrap {
            margin: 12px 0;
        }
        #folderTip {
            color: #2563eb;
            margin-top: 8px;
        }
        #fileInput {
            display: none;
        }
        .progress-wrap {
            margin: 20px 0;
            display: none;
        }
        .progress-text {
            margin-bottom: 8px;
            font-size: 14px;
            color: #374151;
            word-break: break-all;
        }
        .progress-bar-bg {
            width: 100%;
            height: 12px;
            background-color: #e5e7eb;
            border-radius: 6px;
            overflow: hidden;
        }
        .progress-bar-inner {
            height: 100%;
            width: 0%;
            background-color: #2563eb;
            transition: width 0.3s;
        }
        .scan-summary {
            margin: 16px 0;
            padding: 12px;
            background-color: #f0fdf4;
            border-radius: 6px;
            color: #065f46;
            line-height: 1.6;
        }
        .filter-buttons {
            display: flex;
            gap: 10px;
            margin-bottom: 12px;
        }
        .filter-btn {
            padding: 6px 12px;
            background: #eff6ff;
            color: #2563eb;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            table-layout: auto;
        }
        th, td {
            border: 1px solid #e5e7eb;
            padding: 10px;
            font-size: 13px;
            text-align: left;
            word-break: break-all;
            vertical-align: top;
        }
        th {
            background-color: #f9fafb;
            font-weight: 600;
        }
        .no-hit-row {
            background-color: #f3f4f6;
            color: #6b7280;
        }
        .multi-hit-count {
            color: #2563eb;
            font-weight: bold;
        }
    </style>
</head>
<body>
<div class="container">
    <h2 class="title">Excel批量关键词检索工具</h2>

    <!-- 关键词输入区域 -->
    <div class="input-area">
        <div class="input-desc">检索关键词（一行一个，支持英文逗号,分隔多关键词；可直接粘贴Excel A列，自动去重、剔除空行）</div>
        <textarea id="keywordInput" placeholder="示例：
1757610,1778200
1778199
1757609"></textarea>
    </div>

    <!-- 文件夹选择 -->
    <div class="folder-select-wrap">
        <input type="file" id="fileInput" webkitdirectory multiple />
        <button id="selectFolderBtn">选择本地检索根文件夹</button>
        <div id="folderTip">错误：请先选择本地文件夹</div>
    </div>

    <!-- 功能按钮 -->
    <div class="btn-group">
        <button id="startBtn" disabled>开始批量搜索</button>
        <button id="clearResBtn">清空全部结果</button>
        <button id="stopScanBtn">终止扫描</button>
    </div>

    <!-- 扫描进度区域 -->
    <div class="progress-wrap" id="progressWrap">
        <div class="progress-text" id="progressText">正在预扫描目录，统计文件总数...</div>
        <div class="progress-bar-bg">
            <div class="progress-bar-inner" id="progressBar"></div>
        </div>
    </div>

    <!-- 扫描汇总信息 -->
    <div class="scan-summary" id="summaryWrap" style="display: none;"></div>

    <!-- 筛选按钮 -->
    <div class="filter-buttons" id="filterWrap" style="display: none;">
        <button class="filter-btn" data-filter="all">显示全部</button>
        <button class="filter-btn" data-filter="noHit">仅显示无命中关键词</button>
        <button class="filter-btn" data-filter="multiHit">仅显示多次命中关键词</button>
    </div>

    <!-- 检索结果表格 -->
    <div id="resultTableWrap"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script>
    // 全局变量定义（全部提前声明，无变量提升隐患）
    let selectedFolderName = null;
    let scanAbortFlag = false;
    const keywordGroupMap = new Map();

    // 缓存DOM元素，一次性获取，无重复查询
    const keywordInput = document.getElementById("keywordInput");
    const fileInput = document.getElementById("fileInput");
    const selectFolderBtn = document.getElementById("selectFolderBtn");
    const folderTip = document.getElementById("folderTip");
    const startBtn = document.getElementById("startBtn");
    const clearResBtn = document.getElementById("clearResBtn");
    const stopScanBtn = document.getElementById("stopScanBtn");
    const progressWrap = document.getElementById("progressWrap");
    const progressText = document.getElementById("progressText");
    const progressBar = document.getElementById("progressBar");
    const summaryWrap = document.getElementById("summaryWrap");
    const filterWrap = document.getElementById("filterWrap");
    const resultTableWrap = document.getElementById("resultTableWrap");
    const filterBtns = document.querySelectorAll(".filter-btn");

    // 文件夹选择点击事件
    selectFolderBtn.addEventListener("click", function() {
        fileInput.click();
    });

    // 文件选择变更事件
    fileInput.addEventListener("change", function(e) {
        const files = Array.from(e.target.files);
        if (files.length === 0) {
            folderTip.textContent = "错误：请先选择本地文件夹";
            folderTip.style.color = "#2563eb";
            startBtn.disabled = true;
            selectedFolderName = null;
            return;
        }
        const firstFileRelPath = files[0].webkitRelativePath;
        selectedFolderName = firstFileRelPath.split("/")[0];
        folderTip.textContent = `已选中检索根目录：${selectedFolderName}`;
        folderTip.style.color = "#059669";
        startBtn.disabled = false;
    });

    /**
     * 关键词解析函数
     * 支持换行、英文逗号分隔，自动去空格、去重、过滤空值
     * @param {string} rawText 原始输入文本
     * @returns {string[]} 清洗后关键词数组
     */
    function parseKeywords(rawText) {
        const lines = rawText.split(/\r?\n/);
        const keywordSet = new Set();
        lines.forEach(function(line) {
            const lineTrim = line.trim();
            if (!lineTrim) return;
            const splitArr = lineTrim.split(",");
            splitArr.forEach(function(k) {
                const kTrim = k.trim();
                if (kTrim) keywordSet.add(kTrim);
            });
        });
        return Array.from(keywordSet);
    }

    // 清空全部按钮事件
    clearResBtn.addEventListener("click", function() {
        keywordInput.value = "";
        keywordGroupMap.clear();
        summaryWrap.style.display = "none";
        filterWrap.style.display = "none";
        resultTableWrap.innerHTML = "";
        progressWrap.style.display = "none";
        scanAbortFlag = false;
        stopScanBtn.style.display = "none";
    });

    // 终止扫描按钮事件
    stopScanBtn.addEventListener("click", function() {
        scanAbortFlag = true;
        progressText.textContent += " 用户触发终止，正在停止...";
    });

    /**
     * 渲染结果表格
     * @param {string} filterType 筛选类型 all/noHit/multiHit
     */
    function renderResult(filterType = "all") {
        const keywords = parseKeywords(keywordInput.value);
        let htmlStr = `
        <table>
            <thead>
                <tr>
                    <th>检索关键词</th>
                    <th>命中次数</th>
                    <th>文件路径</th>
                    <th>工作表</th>
                    <th>单元格</th>
                    <th>单元格内容</th>
                </tr>
            </thead>
            <tbody>
        `;
        keywords.forEach(function(kw) {
            const hitList = keywordGroupMap.get(kw) || [];
            const hitCount = hitList.length;

            // 筛选过滤，return仅跳出当前单次循环，不阻断后续关键词渲染
            if (filterType === "noHit" && hitCount > 0) return;
            if (filterType === "multiHit" && hitCount <= 1) return;

            if (hitCount === 0) {
                htmlStr += `
                <tr class="no-hit-row">
                    <td>${kw}</td>
                    <td>0</td>
                    <td>——无匹配文件——</td>
                    <td>——</td>
                    <td>——</td>
                    <td>——</td>
                </tr>
                `;
            } else {
                hitList.forEach(function(item, idx) {
                    const kwTdHtml = idx === 0 ? `<td rowspan="${hitCount}">${kw}</td>` : "";
                    let countDisplay = hitCount;
                    if (hitCount > 1) {
                        countDisplay = `<span class="multi-hit-count">${hitCount}</span>`;
                    }
                    const countTdHtml = idx === 0 ? `<td rowspan="${hitCount}">${countDisplay}</td>` : "";
                    htmlStr += `
                    <tr>
                        ${kwTdHtml}
                        ${countTdHtml}
                        <td>${item.filePath}</td>
                        <td>${item.sheetName}</td>
                        <td>${item.cellAddr}</td>
                        <td>${item.cellValue}</td>
                    </tr>
                    `;
                });
            }
        });
        htmlStr += "</tbody></table>";
        resultTableWrap.innerHTML = htmlStr;
    }

    // 筛选按钮绑定点击事件
    filterBtns.forEach(function(btn) {
        btn.addEventListener("click", function() {
            const filterType = this.dataset.filter;
            renderResult(filterType);
        });
    });

    // 开始扫描主逻辑
    startBtn.addEventListener("click", async function() {
        const keywords = parseKeywords(keywordInput.value);
        if (keywords.length === 0) {
            alert("请输入至少一条检索关键词！");
            return;
        }

        // 重置扫描状态
        scanAbortFlag = false;
        keywordGroupMap.clear();
        keywords.forEach(function(k) {
            keywordGroupMap.set(k, []);
        });
        summaryWrap.style.display = "none";
        filterWrap.style.display = "none";
        resultTableWrap.innerHTML = "";
        progressWrap.style.display = "block";
        stopScanBtn.style.display = "inline-block";
        startBtn.disabled = true;

        // 仅筛选xlsx文件，兼容大写后缀.XLSX
        const allFiles = Array.from(fileInput.files).filter(function(f) {
            return f.name.toLowerCase().endsWith(".xlsx");
        });
        const totalFileNum = allFiles.length;
        let scanedNum = 0;
        let matchTotal = 0;
        let failFileNum = 0;

        progressText.textContent = `总待扫描表格：${totalFileNum} 个，开始解析...`;

        // 循环遍历所有Excel文件
        for (const file of allFiles) {
            if (scanAbortFlag === true) break;
            scanedNum++;
            const percent = Math.floor((scanedNum / totalFileNum) * 100);
            progressBar.style.width = `${percent}%`;
            progressText.textContent = `正在解析第${scanedNum}/${totalFileNum} | 文件：${file.webkitRelativePath} | 已匹配命中：${matchTotal}条`;

            try {
                const buf = await file.arrayBuffer();
                const workbook = XLSX.read(buf, { type: "array" });
                workbook.SheetNames.forEach(function(sheetName) {
                    const sheet = workbook.Sheets[sheetName];
                    // 空表格无单元格范围，直接跳过
                    if (!sheet["!ref"]) return;
                    const range = XLSX.utils.decode_range(sheet["!ref"]);
                    // 逐行逐列遍历单元格
                    for (let r = range.s.r; r <= range.e.r; r++) {
                        for (let c = range.s.c; c <= range.e.c; c++) {
                            const cellAddr = XLSX.utils.encode_cell({ r, c });
                            const cell = sheet[cellAddr];
                            if (!cell || cell.v === undefined) continue;
                            const cellVal = String(cell.v).trim();
                            // 匹配关键词写入分组
                            keywords.forEach(function(kw) {
                                if (cellVal === kw) {
                                    matchTotal++;
                                    keywordGroupMap.get(kw).push({
                                        filePath: file.webkitRelativePath,
                                        sheetName: sheetName,
                                        cellAddr: cellAddr,
                                        cellValue: cellVal
                                    });
                                }
                            });
                        }
                    }
                });
            } catch (err) {
                failFileNum++;
                progressText.textContent += ` 警告：文件${file.name}解析失败`;
                console.error("Excel解析异常", file.name, err);
            }
            // 每扫描10个文件刷新一次表格预览
            if (scanedNum % 10 === 0) {
                renderResult();
            }
            // 释放浏览器渲染线程，防止页面卡死
            await new Promise(function(resolve) {
                setTimeout(resolve, 5);
            });
        }

        // 扫描结束重置UI状态
        progressWrap.style.display = "none";
        stopScanBtn.style.display = "none";
        startBtn.disabled = false;

        // 统计命中/未命中关键词数量
        let hitKwCount = 0;
        let noHitKwCount = 0;
        keywordGroupMap.forEach(function(list) {
            if (list.length > 0) {
                hitKwCount++;
            } else {
                noHitKwCount++;
            }
        });

        // 输出扫描汇总信息
        summaryWrap.style.display = "block";
        summaryWrap.innerHTML = `
            ✅ 扫描全部完成<br>
            总扫描表格数：${totalFileNum}<br>
            解析失败文件：${failFileNum}<br>
            累计匹配单元格：${matchTotal}条<br>
            检索关键词总数：${keywords.length}个<br>
            有命中关键词：${hitKwCount}个 | 无命中关键词：${noHitKwCount}个
        `;
        filterWrap.style.display = "flex";
        renderResult();
    });
</script>
</body>
</html>
