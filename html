import xml.etree.ElementTree as ET
import pandas as pd
from openpyxl import Workbook
from openpyxl.utils.dataframe import dataframe_to_rows
from openpyxl.worksheet.dimensions import ColumnDimension
import os

# ========== 配置区域 ==========
ARXML_FILE = r"C:\xxx\service.arxml"   # 替换为你的ARXML路径
OUTPUT_EXCEL = r"SOMEIP层级通讯矩阵.xlsx"
# =============================

# AUTOSAR命名空间
NS = {"ar": "http://autosar.org/schema/r4.0"}

def get_node_text(node, xpath):
    res = node.find(xpath, namespaces=NS)
    return res.text.strip() if res is not None else ""

# 递归解析数据元素，记录层级与偏移
def recursive_parse_elem(elem, level, service, eg_name, event_name, parent_path, byte_off, bit_off, row_list):
    short_name = get_node_text(elem, "./ar:SHORT_NAME")
    full_path = f"{parent_path}.{short_name}" if parent_path else short_name

    # 基础属性
    base_type = get_node_text(elem, "./ar:TypeEmitter/ar:BaseType/ar:SHORT_NAME")
    bit_len = get_node_text(elem, "./ar:BitLength")

    # 解析枚举
    enum_map = {}
    compu_scales = elem.findall(".//ar:CompuScale", namespaces=NS)
    for scale in compu_scales:
        val = get_node_text(scale, "./ar:Value")
        desc = get_node_text(scale, "./ar:Text")
        if val and desc:
            enum_map[val] = desc
    enum_str = "；".join([f"{k}={v}" for k, v in enum_map.items()]) if enum_map else ""

    # 存入行数据
    row_list.append({
        "层级": level,
        "服务": service,
        "事件组": eg_name,
        "事件": event_name,
        "完整信号路径": full_path,
        "信号名称": short_name,
        "字节偏移": byte_off,
        "起始位": bit_off,
        "位长度": bit_len,
        "数据类型": base_type,
        "枚举释义": enum_str
    })

    # 遍历子字段
    child_elems = elem.findall("./ar:DataElem", namespaces=NS)
    for child in child_elems:
        recursive_parse_elem(child, level+1, service, eg_name, event_name, full_path, byte_off, bit_off, row_list)

def parse_someip_arxml(xml_path):
    tree = ET.parse(xml_path)
    root = tree.getroot()
    all_rows = []

    # 遍历SOMEIP服务接口
    service_interfaces = root.findall(".//ar:SOMEIPServiceInterface", namespaces=NS)
    for srv_if in service_interfaces:
        srv_name = get_node_text(srv_if, "./ar:SHORT_NAME")
        # 遍历事件组
        event_groups = srv_if.findall("./ar:SOMEIPEventGroup", namespaces=NS)
        for eg in event_groups:
            eg_name = get_node_text(eg, "./ar:SHORT_NAME")
            # 遍历事件
            events = eg.findall("./ar:SOMEIPEvent", namespaces=NS)
            for evt in events:
                evt_name = get_node_text(evt, "./ar:SHORT_NAME")
                # 报文负载结构
                payload_type = evt.find("./ar:PayloadDataType/ar:DataElem", namespaces=NS)
                if payload_type:
                    recursive_parse_elem(payload_type, 1, srv_name, eg_name, evt_name, "", 0, 0, all_rows)
    return all_rows

def export_foldable_excel(data_rows, save_path):
    df = pd.DataFrame(data_rows)
    wb = Workbook()
    ws = wb.active
    ws.title = "SOMEIP通讯矩阵"

    # 写入数据
    for r in dataframe_to_rows(df, index=False, header=True):
        ws.append(r)

    # 设置分组折叠（按层级分组）
    max_level = df["层级"].max() if not df.empty else 0
    for row_idx in range(2, ws.max_row+1):
        level = df.iloc[row_idx-2]["层级"]
        if level > 1:
            ws.row_dimensions[row_idx].outline_level = level - 1

    # 自动列宽
    for col in ws.columns:
        max_len = 0
        col_letter = col[0].column_letter
        for cell in col:
            cell_val = str(cell.value)
            current_len = len(cell_val)
            if current_len > max_len:
                max_len = current_len
        ws.column_dimensions[col_letter].width = min(max_len + 3, 35)

    wb.save(save_path)
    print(f"✅ 可折叠Excel生成完成：{save_path}")
    print(f"✅ 总计解析信号：{len(df)} 条")

if __name__ == "__main__":
    result_data = parse_someip_arxml(ARXML_FILE)
    export_foldable_excel(result_data, OUTPUT_EXCEL)
