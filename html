"""
全自动解析SOME/IP HTML服务手册
输出：服务 - 事件组 - 事件 - 多层结构体字段 - 枚举释义 - 数组列表说明
生成：结构化JSON + 层级树状Markdown报文结构文档
"""
import os
import json
from bs4 import BeautifulSoup

# ====================== 【在这里修改你的HTML根目录】======================
BASE_HTML_ROOT = r"C:\xxx\ServiceCatalogue"
# =========================================================================

OUTPUT_JSON = os.path.join(BASE_HTML_ROOT, "ALL_SOMEIP_STRUCTURE.json")
OUTPUT_MD = os.path.join(BASE_HTML_ROOT, "ALL_SOMEIP报文层级树.md")

# 全局缓存自定义数据类型（结构体/枚举）
GLOBAL_DATATYPE_CACHE = {}


def safe_text(el):
    if not el:
        return ""
    return el.text.strip().replace("\n", " ").replace("\r", "")


def parse_enum_text(text):
    """解析枚举字符串，返回 {值:含义}"""
    enum_map = {}
    if not text:
        return enum_map
    seg_list = text.split(",")
    for seg in seg_list:
        seg = seg.strip()
        if ":" in seg:
            k, v = seg.split(":", 1)
            enum_map[k.strip()] = v.strip()
    return enum_map


def parse_field_table(table_soup):
    """
    递归解析字段表格
    支持：普通字段 / 嵌套结构体 / 数组 / 枚举
    """
    field_list = []
    if not table_soup:
        return field_list

    rows = table_soup.find_all("tr")
    for row in rows:
        tds = row.find_all("td")
        if len(tds) < 2:
            continue

        field_name = safe_text(tds[0])
        if not field_name:
            continue

        data_type_raw = safe_text(tds[1])
        bit_len = safe_text(tds[2]) if len(tds) >= 3 else ""
        enum_str = safe_text(tds[3]) if len(tds) >= 4 else ""
        enum_map = parse_enum_text(enum_str)

        # 嵌套子结构体
        child_table = tds[1].find("table")
        child_fields = []
        if child_table:
            child_fields = parse_field_table(child_table)

        field_list.append({
            "field_name": field_name,
            "data_type": data_type_raw,
            "bit_length": bit_len,
            "enum_define": enum_map,
            "child_fields": child_fields
        })
    return field_list


def parse_datatype_page(html_path):
    """解析数据类型页面，缓存结构体/枚举定义"""
    try:
        with open(html_path, "r", encoding="utf-8") as f:
            soup = BeautifulSoup(f.read(), "html.parser")
        dt_name = safe_text(soup.find("title"))
        tables = soup.find_all("table", class_="repdeftable")
        for tb in tables:
            fields = parse_field_table(tb)
            GLOBAL_DATATYPE_CACHE[dt_name] = fields
    except Exception as e:
        print("[跳过数据类型页]", html_path, str(e))


def parse_service_page(html_path):
    """解析单个服务页面：服务 - 事件组 - Event - 字段层级"""
    with open(html_path, "r", encoding="utf-8") as f:
        soup = BeautifulSoup(f.read(), "html.parser")

    service_name = safe_text(soup.find("title"))
    service_info = {
        "service_name": service_name,
        "methods": [],
        "event_groups": []
    }

    # 解析方法
    for table in soup.find_all("table", class_="repdeftable"):
        rows = table.find_all("tr")
        for row in rows:
            tds = row.find_all("td")
            if len(tds) < 3:
                continue
            m_name = safe_text(tds[0])
            m_type = safe_text(tds[1])
            req_fields = parse_field_table(tds[2].find("table"))
            service_info["methods"].append({
                "method_name": m_name,
                "method_type": m_type,
                "request_fields": req_fields
            })

    # 解析事件组 + Event（适配绝大多数Symphony HTML结构）
    all_eg_blocks = soup.find_all("div", class_="eventgroup")
    if not all_eg_blocks:
        all_eg_blocks = soup.find_all("section")

    for eg_block in all_eg_blocks:
        eg_title = eg_block.find(["h3", "h2", "h4"])
        eg_name = safe_text(eg_title) if eg_title else "UnnamedEventGroup"

        event_blocks = eg_block.find_all("div", class_="event")
        if not event_blocks:
            event_blocks = [eg_block]

        for evt in event_blocks:
            evt_title = evt.find(["h4", "h3"])
            evt_name = safe_text(evt_title) if evt_title else "UnnamedEvent"
            evt_table = evt.find("table")
            evt_fields = parse_field_table(evt_table)

            service_info["event_groups"].append({
                "event_group": eg_name,
                "event_name": evt_name,
                "event_fields": evt_fields
            })

    return service_info


def scan_all_html(base_path):
    """遍历全部HTML，区分服务页、数据类型页"""
    service_html_paths = []
    datatype_html_paths = []

    for root, _, files in os.walk(base_path):
        for fname in files:
            if fname.lower().endswith(".html"):
                full_p = os.path.join(root, fname)
                if "datatype" in root.lower() or "datatype" in fname.lower():
                    datatype_html_paths.append(full_p)
                elif "service" in root.lower() or "interface" in fname.lower():
                    service_html_paths.append(full_p)

    # 先加载所有数据类型
    print(f"开始加载全局数据类型定义：{len(datatype_html_paths)} 个")
    for p in datatype_html_paths:
        parse_datatype_page(p)

    # 再加载所有服务
    print(f"开始解析服务页面：{len(service_html_paths)} 个")
    all_service_list = []
    for idx, p in enumerate(service_html_paths):
        print(f"[{idx+1}/{len(service_html_paths)}] 解析: {os.path.basename(p)}")
        s_data = parse_service_page(p)
        all_service_list.append(s_data)
    return all_service_list


def fields_to_md_tree(field_list, depth=1):
    """字段转markdown树状文本（递归）"""
    md_txt = ""
    prefix = "  " * (depth - 1)
    for f in field_list:
        # 基础信息
        line = f"{prefix}- **{f['field_name']}** | 类型:{f['data_type']} | 位宽:{f['bit_length']}"
        # 枚举释义
        if f["enum_define"]:
            enum_text = "、".join([f"{k}={v}" for k, v in f["enum_define"].items()])
            line += f" | 枚举释义:【{enum_text}】"
        md_txt += line + "\n"
        # 递归子字段
        if f["child_fields"]:
            md_txt += fields_to_md_tree(f["child_fields"], depth + 1)
    return md_txt


def export_markdown(all_services):
    """导出完整层级树状MD文档"""
    md_content = "# 全网段SOME/IP报文层级结构（真实以太网日志结构）\n\n"
    for serv in all_services:
        md_content += f"## 服务：{serv['service_name']}\n\n"

        # 方法
        if serv["methods"]:
            md_content += f"### 1. 方法列表\n\n"
            for m in serv["methods"]:
                md_content += f"#### 方法：{m['method_name']}（{m['method_type']}）\n\n"
                md_content += f"**请求参数字段层级：**\n\n"
                md_content += fields_to_md_tree(m["request_fields"], 1)
                md_content += "\n"

        # 事件组 & 事件
        if serv["event_groups"]:
            md_content += f"### 2. 事件组 & 事件报文\n\n"
            for eg in serv["event_groups"]:
                md_content += f"#### 事件组：{eg['event_group']}\n"
                md_content += f"##### 事件：{eg['event_name']}\n\n"
                md_content += f"**报文字段层级：**\n\n"
                md_content += fields_to_md_tree(eg["event_fields"], 1)
                md_content += "\n"

    with open(OUTPUT_MD, "w", encoding="utf-8") as f:
        f.write(md_content)
    print("✅ Markdown 报文层级树 导出完成：", OUTPUT_MD)


if __name__ == "__main__":
    # 1. 全盘解析
    total_data = scan_all_html(BASE_HTML_ROOT)

    # 2. 保存原始结构化JSON
    with open(OUTPUT_JSON, "w", encoding="utf-8") as f:
        json.dump(total_data, f, indent=2, ensure_ascii=False)
    print("✅ 原始结构化JSON 导出完成：", OUTPUT_JSON)

    # 3. 生成可读报文层级树
    export_markdown(total_data)

    print("\n==================== 全部解析完成 ====================")
    print("输出文件：")
    print("1. 完整结构化数据源：ALL_SOMEIP_STRUCTURE.json")
    print("2. 可直接阅读的报文层级树：ALL_SOMEIP报文层级树.md")
