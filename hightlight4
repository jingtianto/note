<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>关键词高亮脚本生成器</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:Microsoft YaHei,sans-serif;}
body{max-width:800px;margin:30px auto;padding:0 20px;background:#f5f7fa;}
.box{background:#fff;padding:25px;border-radius:12px;box-shadow:0 2px 10px #00000014;}
h2{text-align:center;color:#333;margin-bottom:20px;}
.tip{color:#666;margin-bottom:15px;line-height:1.6;}
textarea{width:100%;padding:12px;border:1px solid #ddd;border-radius:6px;font-size:14px;resize:vertical;margin-bottom:15px;}
#kw{height:160px;}
#code{height:260px;background:#fafafa;font-family:monospace;font-size:12px;}
.btn-wrap{display:flex;gap:10px;margin-bottom:15px;}
button{flex:1;padding:12px;border:none;border-radius:6px;font-size:15px;font-weight:bold;cursor:pointer;}
.btn-gen{background:#409eff;color:#fff;}
.btn-clr{background:#909399;color:#fff;}
.msg{text-align:center;margin-top:10px;font-weight:bold;display:none;}
.ok{color:#00b42a;}
.err{color:#f53f3f;}
</style>
</head>
<body>
<div class="box">
    <h2>关键词高亮脚本生成器</h2>
    <p class="tip">支持逗号分隔、换行、Excel整列粘贴关键词</p>

    <textarea id="kw" placeholder="请输入/粘贴关键词"></textarea>

    <div class="btn-wrap">
        <button class="btn-gen" id="btnGenerate">生成并复制</button>
        <button class="btn-clr" id="btnClear">清空</button>
    </div>

    <textarea id="code" readonly placeholder="生成的脚本"></textarea>

    <div class="msg ok" id="msgOk">✅ 已生成并复制</div>
    <div class="msg err" id="msgErr">❌ 请先输入关键词</div>
</div>

<script>
// 元素获取
var kwInput = document.getElementById('kw');
var codeArea = document.getElementById('code');
var btnGen = document.getElementById('btnGenerate');
var btnClr = document.getElementById('btnClear');
var msgOk = document.getElementById('msgOk');
var msgErr = document.getElementById('msgErr');

// 隐藏所有提示
function hideMsg(){
    msgOk.style.display = 'none';
    msgErr.style.display = 'none';
}

// 清空按钮
btnClr.onclick = function(){
    hideMsg();
    kwInput.value = '';
    codeArea.value = '';
};

// 生成按钮（纯同步逻辑，无异步阻塞）
btnGen.onclick = function(){
    hideMsg();
    var inputVal = kwInput.value.trim();
    if(!inputVal){
        msgErr.style.display = 'block';
        return;
    }

    // 转义反引号
    var safeStr = inputVal.replace(/`/g, '\\`');

    // 固定脚本模板
    var template = '(function(){\n' +
'    var rawKeywords = `' + safeStr + '`;\n' +
'    var keywordList = rawKeywords.split(/[,，\\n]/).map(function(s){return s.trim();}).filter(function(s){return s;});\n' +
'    if(keywordList.length === 0){alert("未检测到有效关键词");return;}\n' +
'    var colors = ["#ffb3b3","#b3ffb3","#fff380","#b3d1ff","#ffcc99","#d9b3ff","#80ffff","#ff99cc","#c2f0c2","#e6e68a","#99ccff","#ffd199"];\n' +
'    var rules = [];\n' +
'    for(var i=0;i<keywordList.length;i++){\n' +
'        var w = keywordList[i];\n' +
'        var reg = w.replace(/[.*+?^${}()|[\\]\\\\]/g,"\\\\$&");\n' +
'        rules.push({regex:new RegExp(reg,"gi"),bg:colors[i%colors.length]});\n' +
'    }\n' +
'    var processed = new WeakSet();\n' +
'    function highlight(root){\n' +
'        root = root || document.body;\n' +
'        var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);\n' +
'        var node;\n' +
'        while(node = walker.nextNode()){\n' +
'            var p = node.parentElement;\n' +
'            if(!p || processed.has(node) || node.nodeValue.trim() === "")continue;\n' +
'            var tag = p.tagName;\n' +
'            if(tag === "SCRIPT" || tag === "STYLE" || tag === "INPUT" || tag === "TEXTAREA" || tag === "BUTTON" || tag === "SPAN")continue;\n' +
'            processed.add(node);\n' +
'            var txt = node.nodeValue;\n' +
'            var html = txt;\n' +
'            for(var j=0;j<rules.length;j++){\n' +
'                var st = "background:"+rules[j].bg+";padding:1px 4px;border-radius:3px;color:#000;font-weight:500;";\n' +
'                html = html.replace(rules[j].regex,"<span style=\\""+st+"\\">$&</span>");\n' +
'            }\n' +
'            if(html === txt)continue;\n' +
'            var div = document.createElement("div");\n' +
'            div.innerHTML = html;\n' +
'            var frag = document.createDocumentFragment();\n' +
'            while(div.firstChild)frag.appendChild(div.firstChild);\n' +
'            p.replaceChild(frag, node);\n' +
'        }\n' +
'    }\n' +
'    highlight();\n' +
'    var timer = null;\n' +
'    var obs = new MutationObserver(function(){\n' +
'        clearTimeout(timer);\n' +
'        timer = setTimeout(highlight,260);\n' +
'    });\n' +
'    obs.observe(document.body,{childList:true,subtree:true,characterData:false});\n' +
'    console.log("关键词高亮已启动");\n' +
'})();';

    // 写入代码区域
    codeArea.value = template;

    // 复制（优先选中+execCommand，全浏览器兼容）
    codeArea.focus();
    codeArea.select();
    document.execCommand('copy');

    // 显示成功提示
    msgOk.style.display = 'block';
    setTimeout(hideMsg, 2500);
};
</script>
</body>
</html>
