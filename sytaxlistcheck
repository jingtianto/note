<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Excel/CSV批量检索【自适应表格+精确匹配开关】</title>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:system-ui,sans-serif}
body{padding:20px;max-width:1400px;margin:0 auto;background:#f5f7fa}
.card{background:#fff;border-radius:10px;padding:20px;margin-bottom:16px;box-shadow:0 2px 8px #0000000c}
h3{margin-bottom:12px;color:#1f2937;font-size:18px}
textarea{width:100%;height:140px;padding:10px;border:1px solid #d1d5db;border-radius:6px;resize:vertical;font-size:14px}
#dropBox{border:2px dashed #60a5fa;border-radius:8px;padding:40px 10px;text-align:center;color:#6b7280;margin:10px 0;transition:.2s}
#dropBox.active{background:#eff6ff;border-color:#2563eb}
.file-list{margin:10px 0;max-height:140px;overflow-y:auto}
.file-item{padding:6px 10px;background:#eff6ff;border-radius:4px;margin:4px 0;font-size:14px;color:#1e40af}
.btn{padding:10px 24px;background:#2563eb;color:#fff;border:none;border-radius:6px;cursor:pointer;font-size:15px;margin-right:10px}
.btn:disabled{background:#93c5fd;cursor:not-allowed}
.btn-clear{background:#6b7280}
table-wrap{width:100%;overflow-x:auto;display:block}
.table-container{width:100%;overflow-x:auto;display:block;margin-top:10px;max-height:600px}
table{min-width:100%;border-collapse:collapse;font-size:14px;table-layout:auto}
th,td{border:1px solid #e5e7eb;padding:10px;text-align:left;vertical-align:top}
th{background:#f3f4f6;font-weight:600;position:sticky;top:0;z-index:1}
td:first-child{min-width:520px;max-width:650px;white-space:pre-wrap;word-break:break-all}
td:nth-child(2),td:nth-child(3){width:100px;text-align:center;min-width:100px}
td:last-child{min-width:260px;max-width:320px;word-break:break-all}
.found-yes{color:#15803d;font-weight:500}
.found-no{color:#dc2626}
.tip{font-size:13px;color:#6b7280;margin-top:6px}
.warn{color:#d97706;font-weight:500}
.progress-wrap{width:100%;height:10px;background:#e5e7eb;border-radius:5px;margin:8px 0;display:none}
.progress-bar{height:100%;width:0;background:#2563eb;border-radius:5px;transition:.1s linear}
.switch-box{margin:8px 0 16px 0;display:flex;align-items:center;gap:8px}
.switch-box label{cursor:pointer;font-size:14px;color:#333}
input[type="checkbox"]{width:16px;height:16px;cursor:pointer}
</style>
</head>
<body>
<div class="card">
<h3>一、粘贴检索内容（支持Excel【横向一行 / 纵向一列】复制粘贴）</h3>
<textarea id="searchInput" placeholder="直接从Excel复制：
1. 复制一整行（多个单元格）→ 自动拆分逐个检索
2. 复制一整列 → 自动逐行检索
自动过滤空值、自动去重"></textarea>
<div class="switch-box">
    <input type="checkbox" id="exactMatchSwitch">
    <label for="exactMatchSwitch">开启精确匹配（完全相等、区分大小写，关闭为模糊包含匹配）</label>
</div>
<div class="tip warn">⚠️ 多100MB文件请关闭多余浏览器标签，防止内存溢出</div>
</div>

<div class="card">
<h3>二、拖拽源文件（xlsx/xls/csv 单文件最大130MB）</h3>
<div id="dropBox">拖拽多个表格文件到此处</div>
<div class="progress-wrap" id="progressWrap"><div class="progress-bar" id="progressBar"></div></div>
<div class="file-list" id="fileList"></div>
</div>

<div class="card">
<button class="btn" id="searchBtn">开始批量查询</button>
<button class="btn btn-clear" id="clearBtn">清空全部</button>
<div class="tip" id="statusTip"></div>
</div>

<div class="card">
<h3>三、检索结果（每个信号独立统计，横向滚动查看完整内容）</h3>
<div class="table-container">
<table>
<thead>
<tr>
<th>检索信号</th>
<th>是否找到</th>
<th>命中总次数</th>
<th>匹配文件</th>
</tr>
</thead>
<tbody id="resultBody"></tbody>
</table>
</div>
</div>

<script>
// 全局配置
const MAX_FILE_SIZE = 130 * 1024 * 1024;
const BATCH_RENDER = 150;
let uploadFiles = [];

// DOM缓存
const dropBox = document.getElementById('dropBox');
const fileList = document.getElementById('fileList');
const searchBtn = document.getElementById('searchBtn');
const clearBtn = document.getElementById('clearBtn');
const searchInput = document.getElementById('searchInput');
const resultBody = document.getElementById('resultBody');
const statusTip = document.getElementById('statusTip');
const progressWrap = document.getElementById('progressWrap');
const progressBar = document.getElementById('progressBar');
const exactMatchSwitch = document.getElementById('exactMatchSwitch');

// 拖拽事件
['dragenter','dragover','dragleave','drop'].forEach(function(evt){
  dropBox.addEventListener(evt,function(e){
    e.preventDefault();
    e.stopPropagation();
  });
});
['dragenter','dragover'].forEach(function(evt){
  dropBox.addEventListener(evt,function(){ dropBox.classList.add('active'); });
});
['dragleave','drop'].forEach(function(evt){
  dropBox.addEventListener(evt,function(){ dropBox.classList.remove('active'); });
});

dropBox.addEventListener('drop',function(e){
  var fs = e.dataTransfer.files;
  handleUpload(fs);
});

// 文件上传处理
function handleUpload(files){
  for(var i = 0; i < files.length; i++){
    var f = files[i];
    if(f.size > MAX_FILE_SIZE){
      alert('文件【' + f.name + '】超过130MB限制，已跳过');
      continue;
    }
    var lowName = f.name.toLowerCase();
    var isSupport = lowName.indexOf('.xlsx') > -1 || lowName.indexOf('.xls') > -1 || lowName.indexOf('.csv') > -1;
    if(!isSupport){
      alert('仅支持 xlsx / xls / csv，跳过：' + f.name);
      continue;
    }
    // 精准去重
    var exist = false;
    for(var j = 0; j < uploadFiles.length; j++){
      if(uploadFiles[j].name === f.name && uploadFiles[j].size === f.size){
        exist = true;
        break;
      }
    }
    if(exist) continue;

    uploadFiles.push(f);
    var div = document.createElement('div');
    div.className = 'file-item';
    div.textContent = f.name + ' (' + formatSize(f.size) + ')';
    fileList.appendChild(div);
  }
  statusTip.textContent = '已加载 ' + uploadFiles.length + ' 个表格文件';
}

// 文件大小格式化
function formatSize(b){
  if(b < 1024) return b + 'B';
  if(b < 1048576) return (b / 1024).toFixed(1) + 'KB';
  return (b / 1048576).toFixed(1) + 'MB';
}

// 清空全部
clearBtn.addEventListener('click',function(){
  uploadFiles = [];
  fileList.innerHTML = '';
  searchInput.value = '';
  resultBody.innerHTML = '';
  statusTip.textContent = '';
  progressWrap.style.display = 'none';
  progressBar.style.width = '0%';
});

// HTML转义
function escapeHtml(s){
  if(!s) return '';
  return String(s)
  .replace(/&/g,'&amp;')
  .replace(/</g,'&lt;')
  .replace(/>/g,'&gt;')
  .replace(/"/g,'&quot;')
  .replace(/'/g,'&#039;');
}

// 读取文件
function readFileAsArrayBuffer(file){
  return new Promise(function(resolve,reject){
    var fr = new FileReader();
    fr.onload = function(){ resolve(fr.result); };
    fr.onerror = function(){ reject(new Error('读取失败：' + file.name)); };
    fr.readAsArrayBuffer(file);
  });
}

// CSV编码修复（GBK兼容）
async function decodeCSVBuffer(buf, fileName){
  var lowName = fileName.toLowerCase();
  if(lowName.indexOf('.csv') === -1) return buf;
  try{
    var decoder = new TextDecoder('gbk');
    var text = decoder.decode(buf);
    var uint8 = new TextEncoder().encode(text);
    return uint8.buffer;
  }catch(e){
    return buf;
  }
}

// 线程让步
function sleep(ms){
  return new Promise(function(res){ setTimeout(res, ms || 0); });
}

// 主检索逻辑
searchBtn.addEventListener('click',async function(){
  var raw = searchInput.value.trim();
  if(!raw){ alert('请粘贴需要检索的内容！'); return; }
  if(uploadFiles.length === 0){ alert('请拖拽表格源文件！'); return; }

  // 获取匹配模式
  const isExactMatch = exactMatchSwitch.checked;

  searchBtn.disabled = true;
  resultBody.innerHTML = '';
  progressWrap.style.display = 'block';
  progressBar.style.width = '0%';
  statusTip.textContent = '初始化检索...';

  try{
    // 核心修复：横竖粘贴自动拆分制表符
    var splitText = raw.split('\t').join('\n');
    var rawArr = splitText.split('\n');
    // 清理空白 + 自动去重
    var tempKeys = [];
    for(var i = 0; i < rawArr.length; i++){
      var val = rawArr[i].trim();
      if(val) tempKeys.push(val);
    }
    var keywords = [];
    var map = {};
    for(var k = 0; k < tempKeys.length; k++){
      if(!map[tempKeys[k]]){
        map[tempKeys[k]] = true;
        keywords.push(tempKeys[k]);
      }
    }

    // 初始化统计结构
    var statMap = new Map();
    for(var s = 0; s < keywords.length; s++){
      statMap.set(keywords[s],{total:0,files:{}});
    }

    var totalFile = uploadFiles.length;
    for(var fileIdx = 0; fileIdx < totalFile; fileIdx++){
      await sleep(1);
      var file = uploadFiles[fileIdx];
      var percent = ((fileIdx / totalFile) * 100).toFixed(1);
      progressBar.style.width = percent + '%';
      statusTip.textContent = '正在解析：【' + file.name + '】(' + (fileIdx+1) + '/' + totalFile + ')';

      var buf;
      try{
        buf = await readFileAsArrayBuffer(file);
        buf = await decodeCSVBuffer(buf, file.name);
      }catch(e){
        statusTip.textContent += ' 读取失败跳过';
        continue;
      }

      var workbook;
      try{
        workbook = XLSX.read(buf,{
          type:'array',
          cellNF:false,
          cellHTML:false,
          cellStyles:false,
          raw:true
        });
      }catch(e){
        statusTip.textContent += ' 文件损坏跳过';
        workbook = null;
        buf = null;
        continue;
      }

      if(!workbook || !workbook.SheetNames || workbook.SheetNames.length === 0){
        workbook = null;
        buf = null;
        continue;
      }

      // 遍历工作表
      var sheets = workbook.SheetNames;
      for(var si = 0; si < sheets.length; si++){
        await sleep(0);
        var sheetName = sheets[si];
        var sheet = workbook.Sheets[sheetName];
        var ref = sheet['!ref'];
        if(!ref) continue;
        var range = XLSX.utils.decode_range(ref);

        // 遍历行列
        for(var r = range.s.r; r <= range.e.r; r++){
          var hasContent = false;
          for(var c = range.s.c; c <= range.e.c; c++){
            var cellKey = XLSX.utils.encode_cell({r:r,c:c});
            var cell = sheet[cellKey];
            if(!cell || cell.v === undefined || cell.v === null) continue;

            var cellText = String(cell.v).trim();
            if(!cellText) continue;
            hasContent = true;

            // 匹配分支：精确匹配 / 模糊包含
            for(var [key,info] of statMap.entries()){
              let hit = false;
              if(isExactMatch){
                // 精确匹配：完全相等、区分大小写
                hit = (cellText === key);
              }else{
                // 模糊匹配：包含、不区分大小写
                hit = (cellText.toLowerCase().indexOf(key.toLowerCase()) > -1);
              }
              if(hit){
                info.total += 1;
                if(!info.files[file.name]) info.files[file.name] = 0;
                info.files[file.name] += 1;
              }
            }
          }
          if(!hasContent) continue;
        }
      }

      // 强制释放内存
      workbook = null;
      buf = null;
    }

    progressBar.style.width = '100%';
    statusTip.textContent = '解析完成，渲染结果中...';
    await sleep(30);

    // 分批渲染结果
    var keyList = Array.from(statMap.entries());
    var tempHtml = '';
    for(var i = 0; i < keyList.length; i++){
      var key = keyList[i][0];
      var info = keyList[i][1];
      var hitFiles = Object.keys(info.files);
      var isHit = info.total > 0;

      tempHtml += '<tr>'
      + '<td>' + escapeHtml(key) + '</td>'
      + '<td class="' + (isHit ? 'found-yes' : 'found-no') + '">' + (isHit ? '已找到' : '未找到') + '</td>'
      + '<td>' + info.total + '</td>'
      + '<td>' + (hitFiles.length ? escapeHtml(hitFiles.join('、')) : '无') + '</td>'
      + '</tr>';

      if((i+1) % BATCH_RENDER === 0){
        resultBody.insertAdjacentHTML('beforeend', tempHtml);
        tempHtml = '';
        await sleep(0);
      }
    }
    if(tempHtml){
      resultBody.insertAdjacentHTML('beforeend', tempHtml);
    }

    statusTip.textContent = '检索完成！共 ' + keywords.length + ' 条独立信号，' + totalFile + ' 个大文件检索完毕'
        + (isExactMatch ? '【当前模式：精确匹配(区分大小写)】' : '【当前模式：模糊包含匹配】');

  }catch(err){
    console.error(err);
    statusTip.textContent = '检索异常：' + err.message;
    alert('执行出错：' + err.message);
  }finally{
    searchBtn.disabled = false;
  }
});
</script>
</body>
</html>
