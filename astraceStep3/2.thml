</script>
<script>
// ================= AHK 固定模板 请勿随意改动 =================
const AHK_TEMPLATE = `#Requires AutoHotkey v2.0

CoordMode("Pixel", "Client")
 CoordMode("Mouse", "Client")

;=================================================
 ; 信号列表
 ;=================================================

{{REPLACE_SIGNALS_BLOCK}}

;=================================================
 ; 等待切换到 Trace Xplorer
 ;=================================================

Sleep(5000)

if !WinExist("ahk_exe trace.xplorer_basic_en.exe")
 {
   MsgBox("Trace Xplorer 未运行")
   ExitApp
 }

WinActivate("ahk_exe trace.xplorer_basic_en.exe")

if !WinWaitActive("ahk_exe trace.xplorer_basic_en.exe", , 5)
 {
   MsgBox("无法激活 Trace Xplorer")
   ExitApp
 }

;=================================================
 ; Hide All Signals
 ;=================================================

try
 {
   ControlClick("SysListView322", "A")
 }
 catch
 {
   MsgBox("找不到控件 SysListView322")
   ExitApp
 }

Sleep(1000)

Send("^a")
 Sleep(1000)

Send("!s")
 Sleep(1000)

Send("h")
 Sleep(1000)

;=================================================
 ; 主循环
 ;=================================================

for _, signalName in signals
 {
   ToolTip("正在处理:`n" signalName)

   ;---------------------------------------------
   ; 聚焦搜索框
   ;---------------------------------------------

   try
   {
       ControlFocus("Edit1", "A")
   }
   catch
   {
       MsgBox("找不到 Edit1")
       continue
   }

   Sleep(200)

   ControlSetText("", "Edit1", "A")

   Sleep(200)

   ControlSetText(signalName, "Edit1", "A")

   Sleep(1000)

   ;---------------------------------------------
   ; Show 信号
   ;---------------------------------------------

   MouseMove(50, 166, 20)
   Sleep(300)
   Click(50, 166)

   Sleep(800)

   MouseMove(100, 20, 20)
   Sleep(300)
   Click(100, 20)

   Sleep(800)

   MouseMove(85, 166, 20)
   Sleep(300)
   Click(85, 166)

   Sleep(1000)

   ;---------------------------------------------
   ; 获取 Graph 控件区域
   ;---------------------------------------------

   try
   {
       ControlGetPos(&gx, &gy, &gw, &gh, "AfxWnd140su2", "A")
   }
   catch
   {
       MsgBox("找不到 Graph 控件 AfxWnd140su2")
       ExitApp
   }

   ;---------------------------------------------
   ; Graph 中查找蓝色高亮
   ;---------------------------------------------

   targetColor := 0xD5E4F1

   found := PixelSearch(
&px,
&py,
       gx + 10,
       gy + 10,
       gx + gw - 11,
       gy + gh - 11,
       targetColor,
       2
   )

   if found
   {
       MouseMove(px, py, 20)

       Sleep(300)

       targetX := gx + 10
       targetY := gy + gh - 11

       Send("{LButton Down}")

 Sleep(300)

MouseMove(targetX, targetY, 100)

 Sleep(300)

Send("{LButton Up}")


       Sleep(1000)
   }
   else
   {
       MsgBox("Graph中未找到蓝色高亮:`n" signalName)

       Send("{Ctrl Up}")
       Send("{Alt Up}")
       Send("{Shift Up}")

       Send("{LButton Up}")
       Send("{RButton Up}")
       Send("{MButton Up}")

       ToolTip()

       ExitApp
   }
 }

;=================================================
 ; 清理并退出
 ;=================================================

Send("{Ctrl Up}")
 Send("{Alt Up}")
 Send("{Shift Up}")

Send("{LWin Up}")
 Send("{RWin Up}")

Send("{LButton Up}")
 Send("{RButton Up}")
 Send("{MButton Up}")

ToolTip()

MsgBox("全部完成")

ExitApp`;

const dropZone = document.getElementById('dropZone');
const fileListDom = document.getElementById('fileList');
const previewDom = document.getElementById('previewCode');
const downloadBtn = document.getElementById('btnDownload');

let loadedFiles = [];

// ==========关键修复：全局阻止页面拖拽默认行为，防止空白处拖入直接打开文件==========
document.addEventListener('dragover', e => {
    e.preventDefault();
    e.stopPropagation();
});
document.addEventListener('drop', e => {
    e.preventDefault();
    e.stopPropagation();
});

dropZone.addEventListener('dragover', e => {
    e.preventDefault();
    e.stopPropagation();
    dropZone.classList.add('hover');
})
dropZone.addEventListener('dragleave', () => dropZone.classList.remove('hover'))

dropZone.addEventListener('drop', async e => {
    e.preventDefault();
    e.stopPropagation();
    dropZone.classList.remove('hover');
    loadedFiles = [];

    const files = Array.from(e.dataTransfer.files).filter(f => /\.txt$/i.test(f.name));
    if(files.length === 0){
        alert("未识别txt格式文件！");
        refreshUI();
        return;
    }

    for(const f of files){
        const text = await f.text();
        const reg = /signals\s*:=\s*\[[\s\S]*?\]/;
        const match = text.match(reg);
        if(!match){
            alert(`【${f.name}】解析失败：无法找到 signals := [ ] 代码块，已跳过`);
            continue;
        }
        loadedFiles.push({
            originName: f.name,
            signalBlock: match[0],
        })
    }
    refreshUI();
})

function refreshUI(){
    fileListDom.innerHTML = "";
    loadedFiles.forEach(item=>{
        const div = document.createElement('div');
        div.style.padding = "4px 0";
        div.textContent = item.originName;
        fileListDom.appendChild(div);
    })
    downloadBtn.disabled = loadedFiles.length === 0;

    if(loadedFiles.length > 0){
        const first = loadedFiles[0];
        const output = AHK_TEMPLATE.replace("{{REPLACE_SIGNALS_BLOCK}}", first.signalBlock);
        previewDom.value = output;
    }else{
        previewDom.value = "";
    }
}

downloadBtn.onclick = async function(){
    if(loadedFiles.length === 1){
        const item = loadedFiles[0];
        const ahkText = AHK_TEMPLATE.replace("{{REPLACE_SIGNALS_BLOCK}}", item.signalBlock);
        const ahkName = item.originName.replace(/\.txt$/i, ".ahk");
        downloadTextFile(ahkText, ahkName);
    }else{
        const zip = new JSZip();
        for(const item of loadedFiles){
            const ahkText = AHK_TEMPLATE.replace("{{REPLACE_SIGNALS_BLOCK}}", item.signalBlock);
            const ahkName = item.originName.replace(/\.txt$/i, ".ahk");
            zip.file(ahkName, ahkText);
        }
        const blob = await zip.generateAsync({type:"blob"});
        saveBlob(blob, "Signal_AHK_Bundle.zip");
    }
}

function downloadTextFile(text, filename){
    const blob = new Blob([text], {type:"text/plain;charset=utf-8"});
    saveBlob(blob, filename);
}
function saveBlob(blob, fileName){
    const a = document.createElement('a');
    const url = URL.createObjectURL(blob);
    a.href = url;
    a.download = fileName;
    document.body.appendChild(a);
    a.click();
    URL.revokeObjectURL(url);
    a.remove();
}
</script>
</body>
</html>
