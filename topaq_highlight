<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>动态高亮工具 | 支持懒加载/滚动新增内容</title>
    <style>
        * {
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Roboto, sans-serif;
            background: #eef2f7;
            padding: 24px 20px;
            margin: 0;
        }
        .container {
            max-width: 1100px;
            margin: 0 auto;
        }
        .card {
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.05);
            padding: 28px 30px;
            margin-bottom: 28px;
        }
        h1 {
            font-size: 28px;
            font-weight: 600;
            margin: 0 0 8px;
            color: #1a2c3e;
        }
        .sub {
            color: #4a627a;
            border-left: 3px solid #3b82f6;
            padding-left: 12px;
            margin: 12px 0 20px;
            font-size: 14px;
        }
        .label {
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 8px;
            color: #1e293b;
        }
        textarea, input, select {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #cfdfed;
            border-radius: 14px;
            font-size: 14px;
            background: #fff;
            font-family: inherit;
        }
        textarea {
            font-family: 'SF Mono', monospace;
            resize: vertical;
        }
        .config-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            background: #f8fafc;
            padding: 18px 20px;
            border-radius: 20px;
            margin: 20px 0;
            border: 1px solid #e2edf7;
        }
        .config-item {
            flex: 1;
            min-width: 150px;
        }
        .button-bar {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
            margin: 20px 0 16px;
        }
        .btn {
            padding: 12px 22px;
            border: none;
            border-radius: 40px;
            font-weight: 600;
            font-size: 15px;
            cursor: pointer;
            transition: 0.2s;
        }
        .btn-primary {
            background: #3b82f6;
            color: white;
        }
        .btn-primary:hover {
            background: #2563eb;
        }
        .btn-secondary {
            background: #e2e8f0;
            color: #1e293b;
        }
        .btn-warning {
            background: #fee2e2;
            color: #b91c1c;
        }
        .preview-area {
            background: #fefce8;
            border-radius: 20px;
            padding: 20px;
            border: 1px solid #fde68a;
        }
        .preview-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 16px;
            border-bottom: 2px dashed #facc15;
            padding-bottom: 10px;
            font-weight: 700;
        }
        .mock-table {
            background: white;
            border-radius: 18px;
            padding: 12px;
        }
        .mock-row {
            display: flex;
            border-bottom: 1px solid #e9ecef;
            padding: 8px 12px;
        }
        .mock-cell {
            flex: 1;
            font-size: 14px;
        }
        .demo-chip {
            display: inline-block;
            background: #f1f5f9;
            padding: 4px 12px;
            border-radius: 20px;
            margin-right: 12px;
            margin-bottom: 8px;
        }
        .status-msg {
            font-size: 12px;
            color: #2c5f8a;
            margin-top: 8px;
        }
        .preview-match-status {
            margin-top: 12px;
            font-style: italic;
        }
        .info-badge {
            background: #dbeafe;
            border-radius: 20px;
            padding: 4px 12px;
            font-size: 12px;
            display: inline-block;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="card">
        <h1>🔍 动态高亮工具箱 · 支持懒加载/滚动加载</h1>
        <div class="sub">
            🧩 生成的高亮脚本会<strong>持续监听页面变化</strong>，新滚出来的内容也会自动高亮。<br>
            ✨ 下方「实时预览」同样模拟动态效果 (点击模拟新增按钮测试)
        </div>

        <div class="label">📋 关键词列表</div>
        <textarea id="keywordInput" rows="4" placeholder="支持逗号分隔或换行（Excel列）：
175768,175769,12345
或
175768
175769
测试项目"></textarea>

        <div class="config-grid">
            <div class="config-item">
                <div class="label">🎯 匹配模式</div>
                <select id="matchMode">
                    <option value="exact">完全匹配</option>
                    <option value="contains">包含匹配</option>
                    <option value="regex">正则表达式</option>
                </select>
            </div>
            <div class="config-item">
                <div class="label">🔡 大小写</div>
                <select id="caseSensitive">
                    <option value="sensitive">敏感</option>
                    <option value="insensitive">不敏感</option>
                </select>
            </div>
            <div class="config-item">
                <div class="label">🎨 背景色</div>
                <input type="color" id="bgColor" value="#ffff00">
            </div>
            <div class="config-item">
                <div class="label">✍️ 文字色</div>
                <input type="color" id="textColor" value="#000000">
            </div>
            <div class="config-item">
                <div class="label">🧩 选择器</div>
                <input type="text" id="targetSelector" value="td, span, div, [role='gridcell'], p, li">
            </div>
            <div class="config-item">
                <div class="label">📌 自动滚动</div>
                <select id="autoScroll">
                    <option value="true">是</option>
                    <option value="false">否</option>
                </select>
            </div>
        </div>

        <div class="button-bar">
            <button id="runBtn" class="btn btn-primary">✨ 生成动态高亮脚本 & 复制</button>
            <button id="clearBtn" class="btn btn-secondary">🗑️ 清空</button>
            <button id="resetConfigBtn" class="btn btn-secondary">🔄 重置配置</button>
        </div>

        <div class="label">📜 控制台脚本 (已自动复制，支持滚动加载新内容)</div>
        <textarea id="outputArea" readonly rows="8" style="font-family: monospace; background:#f8fafc;" placeholder="点击【生成动态高亮脚本&复制】后这里会出现代码..."></textarea>
    </div>

    <div class="card preview-area" id="previewCard">
        <div class="preview-header">
            <span>🎬 实时预览 + 动态模拟 (点击下方按钮新增行，新行也会高亮)</span>
            <button id="simulateAddRowBtn" style="background:#e0e7ff; border:none; border-radius:30px; padding:4px 12px; cursor:pointer;">➕ 模拟新增一行</button>
        </div>
        <div id="livePreviewContainer">
            <div class="mock-table" id="dynamicMockTable">
                <div class="mock-row"><div class="mock-cell">订单号</div><div class="mock-cell">175768</div></div>
                <div class="mock-row"><div class="mock-cell">订单号2</div><div class="mock-cell">175769</div></div>
                <div class="mock-row"><div class="mock-cell">关键词示例</div><div class="mock-cell">重点测试项目</div></div>
                <div class="mock-row"><div class="mock-cell">混合文本</div><div class="mock-cell">包含 12345 的数字</div></div>
                <div class="mock-row"><div class="mock-cell">正则示例</div><div class="mock-cell">ERROR_CODE_500</div></div>
            </div>
            <div style="margin-top: 16px;">
                <span class="demo-chip">175768</span>
                <span class="demo-chip">175769</span>
                <span class="demo-chip">测试项目</span>
                <span class="demo-chip">ERROR_CODE_500</span>
            </div>
        </div>
        <div class="status-msg preview-match-status" id="previewStatusMsg"></div>
    </div>
</div>

<script>
    (function() {
        // DOM 元素
        const keywordTextarea = document.getElementById('keywordInput');
        const outputArea = document.getElementById('outputArea');
        const runBtn = document.getElementById('runBtn');
        const clearBtn = document.getElementById('clearBtn');
        const resetConfigBtn = document.getElementById('resetConfigBtn');
        const matchModeSelect = document.getElementById('matchMode');
        const caseSensitiveSelect = document.getElementById('caseSensitive');
        const bgColorInput = document.getElementById('bgColor');
        const textColorInput = document.getElementById('textColor');
        const targetSelectorInput = document.getElementById('targetSelector');
        const autoScrollSelect = document.getElementById('autoScroll');
        const previewContainer = document.getElementById('livePreviewContainer');
        const previewStatusMsg = document.getElementById('previewStatusMsg');
        const simulateAddRowBtn = document.getElementById('simulateAddRowBtn');

        // 解析关键词 (去重)
        function parseKeywords(raw) {
            if (!raw.trim()) return [];
            let items;
            if (raw.includes(',')) {
                items = raw.split(',').map(s => s.trim()).filter(s => s !== '');
            } else {
                items = raw.split(/\r?\n/).map(s => s.trim()).filter(s => s !== '');
            }
            const unique = [];
            const set = new Set();
            for (let it of items) {
                if (!set.has(it)) {
                    set.add(it);
                    unique.push(it);
                }
            }
            return unique;
        }

        // 获取匹配函数 (用于预览)
        function getMatchFunction() {
            const mode = matchModeSelect.value;
            const caseSense = caseSensitiveSelect.value;
            const keywordsRaw = keywordTextarea.value;
            const keywords = parseKeywords(keywordsRaw);
            if (keywords.length === 0) return () => false;
            const caseInsensitive = (caseSense === 'insensitive');
            
            if (mode === 'exact') {
                if (caseInsensitive) {
                    const lowerSet = new Set(keywords.map(k => k.toLowerCase()));
                    return (text) => lowerSet.has((text || '').trim().toLowerCase());
                } else {
                    const set = new Set(keywords);
                    return (text) => set.has((text || '').trim());
                }
            } else if (mode === 'contains') {
                if (caseInsensitive) {
                    const lowerKeywords = keywords.map(k => k.toLowerCase());
                    return (text) => {
                        if (!text) return false;
                        const lowerText = text.toLowerCase();
                        return lowerKeywords.some(kw => lowerText.includes(kw));
                    };
                } else {
                    return (text) => {
                        if (!text) return false;
                        return keywords.some(kw => text.includes(kw));
                    };
                }
            } else { // regex
                const regexps = [];
                for (let kw of keywords) {
                    try {
                        regexps.push(new RegExp(kw, caseInsensitive ? 'i' : ''));
                    } catch(e) { /* ignore */ }
                }
                return (text) => regexps.some(re => re.test(text || ''));
            }
        }

        // 实时预览刷新 (仅对预览容器内部元素高亮)
        function refreshPreview() {
            if (!previewContainer) return;
            const selector = targetSelectorInput.value.trim() || 'td, span, div, .demo-chip';
            const bg = bgColorInput.value;
            const color = textColorInput.value;
            const matchFn = getMatchFunction();
            const keywords = parseKeywords(keywordTextarea.value);
            
            // 清除旧高亮
            previewContainer.querySelectorAll('.preview-highlight').forEach(el => {
                el.style.backgroundColor = '';
                el.style.color = '';
                el.style.fontWeight = '';
                el.classList.remove('preview-highlight');
            });
            
            if (keywords.length === 0) {
                if (previewStatusMsg) previewStatusMsg.innerText = '⚡ 无关键词，无高亮';
                return;
            }
            
            let targets;
            try {
                targets = previewContainer.querySelectorAll(selector);
            } catch(e) {
                targets = previewContainer.querySelectorAll('td, span, .demo-chip');
            }
            let matchedCount = 0;
            targets.forEach(el => {
                const text = (el.textContent || '').trim();
                if (!text) return;
                if (matchFn(text)) {
                    el.style.backgroundColor = bg;
                    el.style.color = color;
                    el.style.fontWeight = 'bold';
                    el.classList.add('preview-highlight');
                    matchedCount++;
                }
            });
            if (previewStatusMsg) {
                previewStatusMsg.innerText = `✨ 预览匹配: ${matchedCount} 个元素高亮 (关键词数: ${keywords.length})`;
            }
        }
        
        let previewTimer;
        function schedulePreview() {
            if (previewTimer) clearTimeout(previewTimer);
            previewTimer = setTimeout(refreshPreview, 80);
        }
        
        // 监听配置变化 + 关键词变化
        const listenElements = [matchModeSelect, caseSensitiveSelect, bgColorInput, textColorInput, targetSelectorInput, autoScrollSelect];
        listenElements.forEach(el => el.addEventListener('change', schedulePreview));
        keywordTextarea.addEventListener('input', schedulePreview);
        
        // 模拟新增一行 (测试动态高亮)
        simulateAddRowBtn.addEventListener('click', () => {
            const table = document.getElementById('dynamicMockTable');
            const newRow = document.createElement('div');
            newRow.className = 'mock-row';
            newRow.innerHTML = `<div class="mock-cell">新加载项</div><div class="mock-cell">175769</div>`;
            table.appendChild(newRow);
            schedulePreview(); // 重新高亮整个预览区 (模拟观察者)
        });
        
        // ------------------- 生成带 MutationObserver 的动态高亮脚本 -------------------
        function generateDynamicScript() {
            const rawKeywords = keywordTextarea.value.trim();
            if (!rawKeywords) {
                alert('❌ 请先输入需要高亮的关键词/ID！');
                return null;
            }
            const keywords = parseKeywords(rawKeywords);
            if (keywords.length === 0) {
                alert('❌ 未检测到有效关键词，请检查格式 (支持逗号或换行)');
                return null;
            }
            const mode = matchModeSelect.value;
            const caseSense = caseSensitiveSelect.value;
            const bgColor = bgColorInput.value;
            const textColor = textColorInput.value;
            let targetSelector = targetSelectorInput.value.trim();
            if (!targetSelector) targetSelector = 'td, span, div, [role="gridcell"], p, li';
            const autoScroll = autoScrollSelect.value === 'true';
            const caseInsensitive = (caseSense === 'insensitive');
            
            const escapeStr = (s) => s.replace(/\\/g, '\\\\').replace(/'/g, "\\'");
            const quotedKeywords = keywords.map(k => `'${escapeStr(k)}'`).join(', ');
            
            let matchLogicCode = '';
            if (mode === 'exact') {
                if (caseInsensitive) {
                    matchLogicCode = `
                        const lowerSet = new Set([${keywords.map(k => `'${escapeStr(k.toLowerCase())}'`).join(', ')}]);
                        return lowerSet.has(textLower);
                    `;
                } else {
                    matchLogicCode = `
                        const exactSet = new Set([${quotedKeywords}]);
                        return exactSet.has(text);
                    `;
                }
            } else if (mode === 'contains') {
                if (caseInsensitive) {
                    matchLogicCode = `
                        const lowerList = [${keywords.map(k => `'${escapeStr(k.toLowerCase())}'`).join(', ')}];
                        return lowerList.some(kw => textLower.includes(kw));
                    `;
                } else {
                    matchLogicCode = `
                        const kwList = [${quotedKeywords}];
                        return kwList.some(kw => text.includes(kw));
                    `;
                }
            } else { // regex
                const regexItems = keywords.map(k => {
                    let escaped = k.replace(/\\/g, '\\\\').replace(/'/g, "\\'");
                    return `new RegExp('${escaped}', '${caseInsensitive ? 'i' : ''}')`;
                }).join(', ');
                matchLogicCode = `
                    const regexps = [${regexItems}];
                    return regexps.some(re => re.test(text));
                `;
            }
            
            const script = `(function(){
    // ========== 高亮配置 ==========
    const CONFIG = {
        bgColor: "${bgColor}",
        textColor: "${textColor}",
        targetSelector: "${targetSelector.replace(/"/g, '\\"')}",
        autoScrollFirst: ${autoScroll},
        matchFn: function(text, textLower) {
            ${matchLogicCode}
        }
    };
    const MARK_CLASS = "auto-highlight-js";
    let hasScrolled = false;
    
    // 高亮一组元素 (自动跳过已有标记的元素，避免重复应用样式)
    function highlightElements(elements) {
        let matchCount = 0;
        elements.forEach(el => {
            // 已经高亮过的不重复处理 (避免覆盖样式)
            if (el.classList.contains(MARK_CLASS)) return;
            const rawText = (el.textContent || el.innerText || '').trim();
            if (rawText === "") return;
            const matched = CONFIG.matchFn(rawText, rawText.toLowerCase());
            if (matched) {
                el.style.backgroundColor = CONFIG.bgColor;
                el.style.color = CONFIG.textColor;
                el.style.fontWeight = 'bold';
                el.classList.add(MARK_CLASS);
                matchCount++;
                if (CONFIG.autoScrollFirst && !hasScrolled) {
                    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    hasScrolled = true;
                }
            }
        });
        return matchCount;
    }
    
    // 首次全量高亮
    let allTargets;
    try {
        allTargets = document.querySelectorAll(CONFIG.targetSelector);
    } catch(e) {
        allTargets = document.querySelectorAll('td, span, div, [role="gridcell"]');
    }
    let initialMatched = highlightElements(Array.from(allTargets));
    console.log(\`🔍 初始高亮完成，匹配到 \${initialMatched} 个元素\`);
    
    // 监听动态新增内容 (MutationObserver)
    const observer = new MutationObserver((mutations) => {
        let addedNodes = [];
        for (let m of mutations) {
            if (m.type === 'childList' && m.addedNodes.length) {
                for (let node of m.addedNodes) {
                    if (node.nodeType === Node.ELEMENT_NODE) {
                        addedNodes.push(node);
                    }
                }
            }
        }
        if (addedNodes.length === 0) return;
        // 从新增的节点中查找符合选择器的子孙元素
        let newTargets = [];
        addedNodes.forEach(parent => {
            if (parent.matches && parent.matches(CONFIG.targetSelector)) {
                newTargets.push(parent);
            }
            const children = parent.querySelectorAll ? parent.querySelectorAll(CONFIG.targetSelector) : [];
            newTargets.push(...Array.from(children));
        });
        if (newTargets.length) {
            const addedMatches = highlightElements(newTargets);
            if (addedMatches > 0) {
                console.log(\`🔄 动态高亮新增内容，新增匹配 \${addedMatches} 个元素\`);
            }
        }
    });
    
    observer.observe(document.body, { childList: true, subtree: true });
    console.log("✨ 高亮观察者已启动，后续动态加载的内容将自动高亮");
    return initialMatched;
})();`;
            return script;
        }
        
        // 按钮：生成并复制
        async function onRun() {
            try {
                const script = generateDynamicScript();
                if (!script) return;
                outputArea.value = script;
                await navigator.clipboard.writeText(script);
                alert('✅ 动态高亮脚本已生成并复制！\n特性：\n- 自动高亮现有内容\n- 监听新加载内容并自动高亮\n- 请到目标网页控制台粘贴运行');
            } catch (err) {
                console.error(err);
                alert('⚠️ 生成或复制失败，请手动复制输出框中的代码。\n错误：' + (err.message || '未知'));
            }
        }
        
        function onClear() {
            keywordTextarea.value = '';
            outputArea.value = '';
            schedulePreview();
        }
        
        function onResetConfig() {
            matchModeSelect.value = 'exact';
            caseSensitiveSelect.value = 'sensitive';
            bgColorInput.value = '#ffff00';
            textColorInput.value = '#000000';
            targetSelectorInput.value = 'td, span, div, [role="gridcell"], p, li';
            autoScrollSelect.value = 'true';
            schedulePreview();
        }
        
        runBtn.addEventListener('click', (e) => {
            e.preventDefault();
            onRun();
        });
        clearBtn.addEventListener('click', onClear);
        resetConfigBtn.addEventListener('click', onResetConfig);
        
        schedulePreview();
        outputArea.value = '// 点击【生成动态高亮脚本&复制】生成支持懒加载的高亮代码';
    })();
</script>
</body>
</html>