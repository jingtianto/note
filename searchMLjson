import os
import json
import tkinter as tk
from tkinter import filedialog, messagebox, simpledialog, scrolledtext
from pathlib import Path
from datetime import datetime
import re
import sys

# 检查 openpyxl 是否安装
try:
    import openpyxl
    from openpyxl import load_workbook
except ImportError:
    print("=" * 60)
    print("❌ 未安装 openpyxl 库")
    print("请运行以下命令安装：")
    print("    pip install openpyxl")
    print("=" * 60)
    sys.exit(1)


def select_folder():
    """弹出文件夹选择对话框"""
    root = tk.Tk()
    root.withdraw()
    root.attributes('-topmost', True)
    folder_path = filedialog.askdirectory(title="请选择要扫描的文件夹")
    root.destroy()
    return folder_path


def get_ids_from_user():
    """弹出对话框让用户输入ID"""
    root = tk.Tk()
    root.withdraw()
    root.attributes('-topmost', True)

    dialog = tk.Toplevel(root)
    dialog.title("输入要搜索的 ID")
    dialog.geometry("500x300")
    dialog.attributes('-topmost', True)
    dialog.transient(root)

    tk.Label(dialog, text="输入要搜索的 ID（一行一个，支持逗号分隔）:", font=("Microsoft Yahei", 11)).pack(pady=10)

    text_widget = scrolledtext.ScrolledText(dialog, height=10, font=("Microsoft Yahei", 10))
    text_widget.pack(fill=tk.BOTH, expand=True, padx=10, pady=5)
    text_widget.insert(tk.END, "示例：\n1757610,1778200\n1778199\n1530042")

    result = []
    dialog_closed = False

    def on_confirm():
        nonlocal result, dialog_closed
        if dialog_closed:
            return
        content = text_widget.get("1.0", tk.END).strip()
        lines = content.split('\n')
        ids = []
        for line in lines:
            line = line.strip()
            if not line:
                continue
            parts = re.split(r'[,，\s]+', line)
            for p in parts:
                p = p.strip()
                if p:
                    ids.append(p)
        result = ids
        dialog_closed = True
        dialog.destroy()
        root.destroy()

    def on_cancel():
        nonlocal dialog_closed
        if dialog_closed:
            return
        dialog_closed = True
        dialog.destroy()
        root.destroy()

    btn_frame = tk.Frame(dialog)
    btn_frame.pack(pady=10)
    tk.Button(btn_frame, text="确认", command=on_confirm, width=10, bg="#2563eb", fg="white",
              font=("Microsoft Yahei", 10)).pack(side=tk.LEFT, padx=5)
    tk.Button(btn_frame, text="取消", command=on_cancel, width=10, bg="#e5e7eb",
              font=("Microsoft Yahei", 10)).pack(side=tk.LEFT, padx=5)

    dialog.protocol("WM_DELETE_WINDOW", on_cancel)
    dialog.grab_set()
    root.wait_window(dialog)

    return result


def get_path_keywords():
    """弹出对话框让用户输入关键路径（可选）"""
    root = tk.Tk()
    root.withdraw()
    root.attributes('-topmost', True)

    keywords = simpledialog.askstring(
        "关键路径（可选）",
        "输入关键路径词（用于筛选文件夹，多个用逗号分隔）：\n留空表示搜索所有文件夹",
        parent=root
    )
    root.destroy()

    if keywords:
        return [k.strip() for k in re.split(r'[,，\s]+', keywords) if k.strip()]
    return []


def is_excel_file(filename):
    """检查是否为 Excel 文件"""
    ext = os.path.splitext(filename)[1].lower()
    return ext in ['.xlsx', '.xls', '.xlsm', '.xlsb']


def search_excel_file(file_path, ids):
    """在单个 Excel 文件中搜索 ID，返回匹配结果"""
    matches = []
    try:
        wb = load_workbook(file_path, data_only=True, read_only=True)
        for sheet_name in wb.sheetnames:
            sheet = wb[sheet_name]
            for row in sheet.iter_rows(values_only=True):
                if not row:
                    continue
                for cell_val in row:
                    if cell_val is None:
                        continue
                    str_val = str(cell_val)
                    if not str_val:
                        continue
                    for id_val in ids:
                        if id_val in str_val:
                            matches.append({
                                "keyword": id_val,
                                "sheet": sheet_name,
                                "value": str_val
                            })
        wb.close()
    except Exception as e:
        print(f"⚠️ 读取文件失败 {os.path.basename(file_path)}: {e}")
    return matches


def main():
    print("=" * 60)
    print("📊 Excel 批量搜索工具 (Python版)")
    print("=" * 60)
    print("")

    # 1. 选择文件夹
    folder_path = select_folder()
    if not folder_path:
        print("❌ 未选择文件夹，程序退出。")
        return
    print(f"📁 已选择文件夹: {folder_path}")
    print("")

    # 2. 输入ID
    ids = get_ids_from_user()
    if not ids:
        print("❌ 未输入 ID，程序退出。")
        return
    print(f"🔑 搜索 ID ({len(ids)} 个): {', '.join(ids)}")
    print("")

    # 3. 输入关键路径（可选）
    path_keywords = get_path_keywords()
    if path_keywords:
        print(f"📌 关键路径: {', '.join(path_keywords)}")
    else:
        print("📌 关键路径: 无（搜索所有文件夹）")
    print("")

    # 4. 扫描文件夹，收集 Excel 文件（每10个文件输出进度）
    print("📂 正在扫描 Excel 文件...")
    excel_files = []
    scanned_count = 0
    found_count = 0

    for root, dirs, files in os.walk(folder_path):
        for file in files:
            scanned_count += 1
            if scanned_count % 10 == 0:
                print(f"   🔄 已扫描 {scanned_count} 个文件，找到 {found_count} 个 Excel...", end='\r')

            if is_excel_file(file):
                full_path = os.path.join(root, file)
                # 关键路径筛选（使用相对路径）
                if path_keywords:
                    rel_path = os.path.relpath(full_path, folder_path)
                    rel_path_lower = rel_path.lower()
                    matched = False
                    for kw in path_keywords:
                        if kw.lower() in rel_path_lower:
                            matched = True
                            break
                    if not matched:
                        continue
                excel_files.append(full_path)
                found_count += 1

    # 换行，覆盖扫描进度
    print("")
    print(f"✅ 扫描完成！共扫描 {scanned_count} 个文件，找到 {found_count} 个 Excel 文件")
    print("")

    if not excel_files:
        print("❌ 未找到任何 Excel 文件，程序退出。")
        return

    # 5. 搜索（每10个文件输出进度）
    print("🔍 正在搜索 Excel 内容...")
    print("   (这可能需要一些时间，请耐心等待)")
    results = []
    total_matches = 0
    processed = 0
    total = len(excel_files)

    for file_path in excel_files:
        processed += 1
        if processed % 10 == 0:
            pct = int(processed / total * 100)
            print(f"   🔍 进度: {processed}/{total} ({pct}%)", end='\r')

        matches = search_excel_file(file_path, ids)
        if matches:
            # 按ID分组
            kw_groups = {}
            for m in matches:
                if m["keyword"] not in kw_groups:
                    kw_groups[m["keyword"]] = []
                kw_groups[m["keyword"]].append(m)

            # 获取文件修改时间
            try:
                mtime = os.path.getmtime(file_path)
            except:
                mtime = None

            file_entry = {
                "file": file_path,
                "last_modified": mtime,
                "keywords": []
            }
            for kw, items in kw_groups.items():
                file_entry["keywords"].append({
                    "keyword": kw,
                    "count": len(items),
                    "sheets": list(set([m["sheet"] for m in items]))
                })
                total_matches += len(items)
            results.append(file_entry)

    # 换行，覆盖搜索进度
    print("")
    print(f"✅ 搜索完成，共 {total_matches} 次命中，命中 {len(results)} 个文件")
    print("")

    # 6. 生成结果 JSON
    script_dir = os.path.dirname(os.path.abspath(__file__))
    timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
    output_path = os.path.join(script_dir, f"search_result_{timestamp}.json")

    with open(output_path, "w", encoding="utf-8") as f:
        json.dump({
            "folder": folder_path,
            "ids": ids,
            "path_keywords": path_keywords,
            "total_files_scanned": len(excel_files),
            "total_hits": total_matches,
            "matched_files": len(results),
            "scan_time": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "results": results
        }, f, ensure_ascii=False, indent=2)

    print("=" * 60)
    print("✅ 搜索完成！")
    print(f"📁 扫描路径: {folder_path}")
    print(f"📄 扫描文件: {len(excel_files)} 个")
    print(f"🔑 搜索 ID: {len(ids)} 个")
    print(f"✅ 命中文件: {len(results)} 个")
    print(f"🔍 总命中次数: {total_matches}")
    print("")
    print("📄 结果已保存到:")
    print(f"   {output_path}")
    print("=" * 60)

    # 弹出提示框
    root = tk.Tk()
    root.withdraw()
    root.attributes('-topmost', True)
    messagebox.showinfo(
        "搜索完成",
        f"✅ 搜索完成！\n\n"
        f"📁 扫描路径: {folder_path}\n"
        f"📄 扫描文件: {len(excel_files)} 个\n"
        f"🔑 搜索 ID: {len(ids)} 个\n"
        f"✅ 命中文件: {len(results)} 个\n"
        f"🔍 总命中次数: {total_matches}\n\n"
        f"📄 结果已保存到:\n{output_path}\n\n"
        f"💡 提示: 在 HTML 工具中点击\n"
        f"「📊 加载搜索结果 JSON」导入查看"
    )
    root.destroy()

    # 自动打开文件夹（Windows）
    try:
        import subprocess
        if os.name == 'nt':
            subprocess.Popen(['explorer', script_dir])
    except:
        pass


if __name__ == "__main__":
    main()
