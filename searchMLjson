import os
import json
import tkinter as tk
from tkinter import filedialog, messagebox
from pathlib import Path
from datetime import datetime

def select_folder():
    """弹出文件夹选择对话框"""
    root = tk.Tk()
    root.withdraw()  # 隐藏主窗口
    root.attributes('-topmost', True)  # 置顶
    folder_path = filedialog.askdirectory(title="请选择要扫描的文件夹")
    root.destroy()
    return folder_path

def scan_folder(folder_path):
    """遍历文件夹，生成文件清单"""
    file_list = []
    total_files = 0
    total_size = 0
    
    print("开始扫描文件夹...")
    
    for root, dirs, files in os.walk(folder_path):
        for file in files:
            try:
                full_path = Path(root) / file
                stat = full_path.stat()
                file_info = {
                    "path": str(full_path),
                    "name": file,
                    "size": stat.st_size,
                    "modified": stat.st_mtime,
                    "modified_str": datetime.fromtimestamp(stat.st_mtime).strftime("%Y-%m-%d %H:%M:%S")
                }
                file_list.append(file_info)
                total_files += 1
                total_size += stat.st_size
                
                # 每100个文件打印一次进度
                if total_files % 100 == 0:
                    print(f"已扫描 {total_files} 个文件...")
                    
            except Exception as e:
                print(f"跳过文件 {file}: {e}")
    
    # 生成JSON文件
    output_path = os.path.join(os.path.dirname(folder_path), "file_list.json")
    # 如果目标文件夹没有写入权限，则保存到脚本所在目录
    try:
        with open(output_path, "w", encoding="utf-8") as f:
            json.dump({
                "folder": folder_path,
                "total_files": total_files,
                "total_size": total_size,
                "scan_time": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                "files": file_list
            }, f, ensure_ascii=False, indent=2)
    except:
        output_path = os.path.join(os.getcwd(), "file_list.json")
        with open(output_path, "w", encoding="utf-8") as f:
            json.dump({
                "folder": folder_path,
                "total_files": total_files,
                "total_size": total_size,
                "scan_time": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                "files": file_list
            }, f, ensure_ascii=False, indent=2)
    
    return output_path, total_files, total_size

def main():
    print("=" * 50)
    print("📁 文件夹扫描工具")
    print("=" * 50)
    
    # 弹出文件夹选择对话框
    folder_path = select_folder()
    
    if not folder_path:
        print("❌ 未选择文件夹，程序退出。")
        return
    
    print(f"✅ 已选择文件夹: {folder_path}")
    print("=" * 50)
    
    # 开始扫描
    try:
        output_path, total_files, total_size = scan_folder(folder_path)
        
        # 格式化文件大小
        if total_size > 1024 * 1024 * 1024:
            size_str = f"{total_size / (1024 * 1024 * 1024):.2f} GB"
        elif total_size > 1024 * 1024:
            size_str = f"{total_size / (1024 * 1024):.2f} MB"
        elif total_size > 1024:
            size_str = f"{total_size / 1024:.2f} KB"
        else:
            size_str = f"{total_size} B"
        
        print("=" * 50)
        print("✅ 扫描完成！")
        print(f"📁 扫描路径: {folder_path}")
        print(f"📄 文件总数: {total_files}")
        print(f"💾 总大小: {size_str}")
        print(f"📄 输出文件: {output_path}")
        print("=" * 50)
        
        # 弹出提示框
        root = tk.Tk()
        root.withdraw()
        root.attributes('-topmost', True)
        messagebox.showinfo(
            "扫描完成", 
            f"✅ 扫描完成！\n\n"
            f"📁 扫描路径: {folder_path}\n"
            f"📄 文件总数: {total_files}\n"
            f"💾 总大小: {size_str}\n\n"
            f"📄 输出文件:\n{output_path}"
        )
        root.destroy()
        
    except Exception as e:
        print(f"❌ 扫描出错: {e}")
        root = tk.Tk()
        root.withdraw()
        root.attributes('-topmost', True)
        messagebox.showerror("错误", f"扫描失败: {e}")
        root.destroy()

if __name__ == "__main__":
    main()
