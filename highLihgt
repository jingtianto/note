(function(){
    // 👇 在这里填你的关键词，逗号/Excel换行单列都兼容
    const rawKeywords = `175768,175769`;

    // 关键词&配色初始化
    const keywordList = rawKeywords
        .split(/[,，\n]/)
        .map(s => s.trim())
        .filter(s => s);

    if(keywordList.length === 0) return alert("请先填写关键词");

    const colors = ["#ffdddd","#ddffdd","#ffffcc","#ddddff","#ffeedd","#eeddff"];
    const rules = keywordList.map((word, idx) => ({
        text: word,
        regex: new RegExp(word, "gi"),
        bg: colors[idx % colors.length]
    }));

    // 已经高亮过的节点标记，永久跳过，避免重复处理卡死
    const processed = new WeakSet();

    // 单次安全高亮，只处理未标记的新内容
    function highlightOnce(root = document.body){
        const walker = document.createTreeWalker(
            root,
            NodeFilter.SHOW_TEXT,
            null
        );
        const nodes = [];
        let node;
        while(node = walker.nextNode()){
            const parent = node.parentElement;
            if(
                !processed.has(node)
                && parent
                && !["SCRIPT","STYLE","INPUT","TEXTAREA","BUTTON","SPAN"].includes(parent.tagName)
                && node.nodeValue.trim()
            ){
                nodes.push(node);
                processed.add(node);
            }
        }

        nodes.forEach(textNode => {
            const txt = textNode.nodeValue;
            const frag = document.createDocumentFragment();
            let lastIdx = 0;

            rules.forEach(rule => {
                let match;
                rule.regex.lastIndex = 0;
                while((match = rule.regex.exec(txt)) !== null){
                    if(match.index > lastIdx){
                        frag.appendChild(document.createTextNode(txt.slice(lastIdx, match.index)));
                    }
                    const span = document.createElement("span");
                    span.style.background = rule.bg;
                    span.style.padding = "1px 3px";
                    span.style.borderRadius = "2px";
                    span.textContent = match[0];
                    frag.appendChild(span);
                    lastIdx = rule.regex.lastIndex;
                }
            });

            if(lastIdx < txt.length){
                frag.appendChild(document.createTextNode(txt.slice(lastIdx)));
            }

            if(frag.childNodes.length > 0){
                textNode.parentNode.replaceChild(frag, textNode);
            }
        });
    }

    // 首次全页高亮
    highlightOnce();

    // 防抖节流：等待滚动/加载停止后，只执行1次更新，绝不卡死
    let timer = null;
    const observer = new MutationObserver(() => {
        clearTimeout(timer);
        timer = setTimeout(() => {
            highlightOnce();
        }, 300);
    });

    // 轻量化监听，最小性能占用
    observer.observe(document.body, {
        childList: true,
        subtree: true,
        characterData: false
    });

    console.log("✅ 稳定版常驻高亮启动，滚动丝滑不卡顿");
    alert("修复完成！现在上下左右滚动完全正常，新加载内容依然会自动高亮");
})();
