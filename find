import xml.etree.ElementTree as ET
import sys
import os

# -------------------------- 配置区 --------------------------
# 请改成你的ARXML文件路径
ARXML_FILE_PATH = r"C:\Users\QXZ715A\Downloads\CN_ARXML_26-11_I490Release_v02.arxml"
# 你要找的成员变量名
TARGET_ELEMENT_NAME = "privateExtendedQualifier"
# AUTOSAR命名空间
AUTOSAR_NS = "http://autosar.org/schema/r4.0"
# -----------------------------------------------------------

ET.register_namespace("", AUTOSAR_NS)

def debug_log(msg, level="INFO"):
    print(f"[{level}] {msg}")

def main():
    debug_log(f"===== 开始解析ARXML文件: {ARXML_FILE_PATH} =====")
    debug_log(f"目标成员变量名: {TARGET_ELEMENT_NAME}")

    if not os.path.exists(ARXML_FILE_PATH):
        debug_log(f"文件不存在: {ARXML_FILE_PATH}", "ERROR")
        sys.exit(1)

    try:
        tree = ET.parse(ARXML_FILE_PATH)
        root = tree.getroot()
        debug_log("XML文件解析成功")
    except Exception as e:
        debug_log(f"XML解析失败: {str(e)}", "ERROR")
        sys.exit(1)

    # -------------------------- 步骤1：找所有APPLICATION-RECORD-ELEMENT --------------------------
    debug_log("\n--- 步骤1：查找所有结构体成员（APPLICATION-RECORD-ELEMENT） ---")
    target_elements = []

    # 遍历所有结构体成员
    for elem in root.findall(f".//{{{AUTOSAR_NS}}}APPLICATION-RECORD-ELEMENT"):
        short_name = elem.find(f".//{{{AUTOSAR_NS}}}SHORT-NAME")
        if short_name is not None and short_name.text == TARGET_ELEMENT_NAME:
            target_elements.append(elem)
            # 打印完整路径
            path = []
            parent = elem
            while parent is not None:
                tag = parent.tag.split('}')[-1]
                name_elem = parent.find(f".//{{{AUTOSAR_NS}}}SHORT-NAME")
                name = name_elem.text if name_elem is not None else "NO_NAME"
                path.append(f"{tag}({name})")
                parent = parent.getparent()
            path_str = " -> ".join(reversed(path))
            debug_log(f"找到匹配的成员，完整层级路径：\n{path_str}")

    if not target_elements:
        debug_log("未找到任何匹配的APPLICATION-RECORD-ELEMENT", "ERROR")
        sys.exit(1)

    debug_log(f"共找到 {len(target_elements)} 个匹配的结构体成员")

    # -------------------------- 步骤2：解析每个成员的类型和绑定 --------------------------
    for idx, elem in enumerate(target_elements):
        debug_log(f"\n===== 解析成员 {idx+1}/{len(target_elements)} =====")
        short_name = elem.find(f".//{{{AUTOSAR_NS}}}SHORT-NAME").text
        debug_log(f"成员SHORT-NAME: {short_name}")

        # 1. 找绑定的数据类型
        type_ref = elem.find(f".//{{{AUTOSAR_NS}}}TYPE-TREF")
        if type_ref is not None:
            type_dest = type_ref.get("DEST")
            type_path = type_ref.text
            debug_log(f"绑定的数据类型路径: {type_path} (DEST={type_dest})")
        else:
            debug_log("未找到TYPE-TREF，尝试找TYPE-REF...", "WARNING")
            type_ref = elem.find(f".//{{{AUTOSAR_NS}}}TYPE-REF")
            if type_ref is not None:
                type_dest = type_ref.get("DEST")
                type_path = type_ref.text
                debug_log(f"绑定的数据类型路径: {type_path} (DEST={type_dest})")
            else:
                debug_log("该成员未绑定数据类型，跳过", "WARNING")
                continue

        # 2. 找CompuMethod绑定（枚举映射）
        compu_method_ref = elem.find(f".//{{{AUTOSAR_NS}}}COMPU-METHOD-REF")
        if compu_method_ref is not None:
            cm_path = compu_method_ref.text
            debug_log(f"绑定的CompuMethod路径: {cm_path}")
        else:
            # 往上找数据类型的CompuMethod
            app_data_type = root.find(f".//*[@ID='{type_path.split('/')[-1]}']")
            if app_data_type is not None:
                cm_ref = app_data_type.find(f".//{{{AUTOSAR_NS}}}COMPU-METHOD-REF")
                if cm_ref is not None:
                    debug_log(f"从数据类型找到绑定的CompuMethod: {cm_ref.text}")

        # 3. 找该成员所在的顶层SIGNAL/PDU（关键！）
        debug_log("\n--- 尝试向上追溯到顶层SIGNAL/PDU ---")
        current = elem
        found_signal = None
        found_pdu = None
        while current is not None:
            tag = current.tag.split('}')[-1]
            if tag == "SIGNAL":
                found_signal = current
                break
            if tag == "PDU":
                found_pdu = current
                break
            current = current.getparent()

        if found_signal is not None:
            debug_log(f"追溯到顶层SIGNAL节点")
            start_pos_elem = found_signal.find(f".//{{{AUTOSAR_NS}}}START-POSITION")
            length_elem = found_signal.find(f".//{{{AUTOSAR_NS}}}LENGTH")
            byte_order_elem = found_signal.find(f".//{{{AUTOSAR_NS}}}BYTE-ORDER")

            if start_pos_elem is not None and length_elem is not None:
                start_pos = int(start_pos_elem.text)
                length = int(length_elem.text)
                byte_order = byte_order_elem.text if byte_order_elem is not None else "UNKNOWN"
                debug_log(f"顶层SIGNAL参数 - START-POSITION: {start_pos}, LENGTH: {length}, BYTE-ORDER: {byte_order}")

                # 计算成员在结构体中的偏移（简化版，只考虑同类型的连续成员）
                debug_log("\n--- 注意：以下是基础偏移计算，实际需结合结构体成员顺序和数据宽度 ---")
                debug_log("⚠️  由于ARXML未直接存储成员偏移，以下为基于层级的估算：")
                debug_log(f"1. 顶层SIGNAL起始位: {start_pos}")
                debug_log(f"2. 成员长度: 8bit（根据你的截图enumBackingType=uint8）")
                debug_log(f"3. 若该成员是结构体中第一个成员，则偏移为 0 bit")
                debug_log(f"4. 实际偏移需按结构体成员顺序累加每个成员的bit长度")
                debug_log(f"   估算的成员起始位: {start_pos}")
                debug_log(f"   估算的成员结束位: {start_pos + 8 - 1}")
                debug_log(f"   对应Byte位置: Byte {start_pos//8} (Bit {start_pos%8} ~ {start_pos%8 + 7})")
            else:
                debug_log("顶层SIGNAL缺少START-POSITION/LENGTH，无法计算偏移", "WARNING")

        elif found_pdu is not None:
            debug_log("追溯到顶层PDU节点，需要通过SIGNAL-TO-PDU-MAPPING查找偏移")
        else:
            debug_log("未追溯到顶层SIGNAL/PDU，该成员可能属于应用层结构体，未直接绑定到总线信号", "WARNING")

    debug_log("\n===== 解析完成 =====")
    debug_log("⚠️  重要说明：")
    debug_log("1. 你的privateExtendedQualifier是结构体成员，ARXML不直接存储它的偏移")
    debug_log("2. 实际偏移 = 顶层信号的START-POSITION + 该成员在结构体中的累计偏移")
    debug_log("3. 结构体累计偏移需要按成员顺序，累加每个成员的bit长度（比如uint8=8bit）")
    debug_log("4. 你截图里显示enumBackingType=uint8，说明这个成员占1字节（8bit）")

if __name__ == "__main__":
    main()
