import xml.etree.ElementTree as ET
import sys
import os

# ===================== 配置区 =====================
ARXML_FILE_PATH = r"C:\Users\QXZ715A\Downloads\CN_ARXML_26-11_I490Release_v02.arxml"
TARGET_ELEMENT_NAME = "privateExtendedQualifier"
AUTOSAR_NS = "http://autosar.org/schema/r4.0"
NS_PREFIX = "{" + AUTOSAR_NS + "}"
# ==================================================

ET.register_namespace("", AUTOSAR_NS)

def debug_log(msg, level="INFO"):
    print(f"[{level:6}] {msg}")

def get_all_elements_with_path(root):
    elements_map = {}
    stack = [(root, [])]
    while stack:
        elem, path_list = stack.pop()
        raw_tag = elem.tag
        tag = raw_tag.split('}')[-1] if '}' in raw_tag else raw_tag
        name_elem = elem.find(f"{NS_PREFIX}SHORT-NAME")
        node_name = name_elem.text if name_elem is not None else "NO_SHORT_NAME"
        current_path = path_list + [(tag, node_name, elem)]
        elements_map[elem] = current_path
        for child in reversed(list(elem)):
            stack.append((child, current_path))
    return elements_map

def get_base_bit_length(root, type_id, ns):
    type_node = root.find(f".//*[@ID='{type_id}']")
    if type_node is None:
        return 8
    bit_len_elem = type_node.find(f"{ns}BIT-LENGTH")
    if bit_len_elem is not None and bit_len_elem.text.isdigit():
        return int(bit_len_elem.text)
    base_type_ref = type_node.find(f"{ns}BASE-TYPE-REF")
    if base_type_ref is not None:
        ref_id = base_type_ref.text.strip().split("/")[-1]
        return get_base_bit_length(root, ref_id, ns)
    return 8

def find_signal_to_pdu_mapping(root, target_data_type_path):
    """查找绑定了目标数据类型的SIGNAL-TO-PDU-MAPPING"""
    mappings = []
    debug_log(f"正在查找绑定数据类型: {target_data_type_path} 的PDU映射...", "DEBUG")
    for mapping in root.findall(f".//{NS_PREFIX}SIGNAL-TO-PDU-MAPPING"):
        signal_ref = mapping.find(f"{NS_PREFIX}SIGNAL-REF")
        if signal_ref is not None:
            signal_path = signal_ref.text.strip()
            pdu_ref = mapping.find(f"{NS_PREFIX}PDU-REF")
            if pdu_ref is not None:
                pdu_path = pdu_ref.text.strip()
                start_pos_elem = mapping.find(f"{NS_PREFIX}START-POSITION")
                if start_pos_elem is not None and start_pos_elem.text.isdigit():
                    start_pos = int(start_pos_elem.text)
                    mappings.append({
                        "signal_path": signal_path,
                        "pdu_path": pdu_path,
                        "start_pos": start_pos
                    })
                    debug_log(f"找到映射: SIGNAL={signal_path} -> PDU={pdu_path}, START-POSITION={start_pos}", "DEBUG")
    return mappings

def main():
    debug_log("=" * 70)
    debug_log("ARXML 结构体成员 Bit/Byte 位置解析工具（终极版）")
    debug_log(f"目标文件: {ARXML_FILE_PATH}")
    debug_log(f"目标成员: {TARGET_ELEMENT_NAME}")
    debug_log("=" * 70)

    if not os.path.isfile(ARXML_FILE_PATH):
        debug_log(f"文件不存在: {ARXML_FILE_PATH}", "ERROR")
        sys.exit(1)

    try:
        tree = ET.parse(ARXML_FILE_PATH)
        root = tree.getroot()
        debug_log("XML 文件解析成功")
    except Exception as e:
        debug_log(f"XML 解析失败: {str(e)}", "ERROR")
        sys.exit(1)

    debug_log("\n[STEP 1] 全量遍历XML节点，构建路径映射...")
    elem_path_map = get_all_elements_with_path(root)
    debug_log(f"节点遍历完成，总计节点数: {len(elem_path_map)}")

    debug_log("\n[STEP 2] 查找结构体成员节点: " + TARGET_ELEMENT_NAME)
    all_record_elems = root.findall(f".//{NS_PREFIX}APPLICATION-RECORD-ELEMENT")
    target_elems = []
    for elem in all_record_elems:
        sn_elem = elem.find(f"{NS_PREFIX}SHORT-NAME")
        if sn_elem is not None and sn_elem.text == TARGET_ELEMENT_NAME:
            target_elems.append(elem)
            full_path_list = elem_path_map[elem]
            path_str = " -> ".join([f"{t}({n})" for t, n, _ in full_path_list])
            debug_log(f"✅ 命中目标成员，完整层级:\n{path_str}")

    if not target_elems:
        debug_log("未找到目标结构体成员，程序退出", "ERROR")
        sys.exit(1)

    debug_log(f"\n共找到 {len(target_elems)} 个同名目标成员，开始逐个解析")

    for idx, curr_elem in enumerate(target_elems, 1):
        debug_log("\n" + "-" * 60)
        debug_log(f"===== 解析第 {idx} / {len(target_elems)} 个目标成员 =====")
        sn = curr_elem.find(f"{NS_PREFIX}SHORT-NAME").text
        debug_log(f"成员名称: {sn}")

        # 1. 查找数据类型引用
        type_ref = curr_elem.find(f"{NS_PREFIX}TYPE-TREF")
        ref_text = ""
        if type_ref is not None:
            ref_text = type_ref.text.strip()
            dest_type = type_ref.get("DEST", "N/A")
            debug_log(f"类型引用(TYPE-TREF): {ref_text} , DEST={dest_type}")
        else:
            type_ref = curr_elem.find(f"{NS_PREFIX}TYPE-REF")
            if type_ref is not None:
                ref_text = type_ref.text.strip()
                dest_type = type_ref.get("DEST", "N/A")
                debug_log(f"类型引用(TYPE-REF): {ref_text} , DEST={dest_type}")
            else:
                debug_log("未找到类型引用节点", "WARNING")
                continue

        # 2. 查找CompuMethod
        compu_ref = curr_elem.find(f"{NS_PREFIX}COMPU-METHOD-REF")
        if compu_ref is not None:
            debug_log(f"枚举转换方法: {compu_ref.text.strip()}")

        # 3. 查找所在的结构体定义
        record_def_node = None
        for tag, name, node in elem_path_map[curr_elem]:
            if tag == "APPLICATION-RECORD-DEFINITION":
                record_def_node = node
                break

        struct_offset_bit = 0
        if record_def_node is not None:
            debug_log("\n[CALC] 计算结构体内部成员累计偏移")
            member_list = record_def_node.findall(f"{NS_PREFIX}APPLICATION-RECORD-ELEMENT")
            found_target = False
            for mem in member_list:
                mem_sn_elem = mem.find(f"{NS_PREFIX}SHORT-NAME")
                mem_sn = mem_sn_elem.text if mem_sn_elem else "UNNAMED"
                if mem_sn == TARGET_ELEMENT_NAME:
                    found_target = True
                    break
                # 获取成员位宽
                mem_tref = mem.find(f"{NS_PREFIX}TYPE-TREF")
                bit_len = 8
                if mem_tref:
                    tid = mem_tref.text.strip().split("/")[-1]
                    bl = get_base_bit_length(root, tid, NS_PREFIX)
                    if bl is not None:
                        bit_len = bl
                struct_offset_bit += bit_len
                debug_log(f"  前置成员: {mem_sn} , 位宽={bit_len} bit , 累计偏移={struct_offset_bit} bit")

            if not found_target:
                debug_log("遍历完结构体成员，未匹配到目标名称", "WARNING")
                continue
            debug_log(f"✅ 目标成员在结构体内部偏移: {struct_offset_bit} Bit")
        else:
            debug_log("未找到结构体定义节点，无法计算偏移", "WARNING")
            continue

        # 4. 查找绑定了这个结构体的顶层信号/PDU
        debug_log("\n[TRACE] 查找绑定了当前结构体数据类型的SIGNAL/PDU...")
        mappings = find_signal_to_pdu_mapping(root, ref_text)
        if not mappings:
            debug_log("未找到直接绑定该结构体的SIGNAL-TO-PDU-MAPPING，尝试查找SIGNAL节点...", "WARNING")
            # 备选：直接找引用该数据类型的SIGNAL
            for sig in root.findall(f".//{NS_PREFIX}SIGNAL"):
                sig_adt_ref = sig.find(f"{NS_PREFIX}APPLICATION-DATA-TYPE-REF")
                if sig_adt_ref is not None and sig_adt_ref.text.strip() in ref_text:
                    debug_log(f"找到匹配的SIGNAL: {sig.find(f'{NS_PREFIX}SHORT-NAME').text}", "DEBUG")
                    start_pos_elem = sig.find(f"{NS_PREFIXSTART-POSITION")
                    if start_pos_elem and start_pos_elem.text.isdigit():
                        mappings.append({
                            "signal_path": sig.get("ID"),
                            "start_pos": int(start_pos_elem.text)
                        })

        if not mappings:
            debug_log("未找到任何绑定该结构体的顶层信号，无法计算Payload位置", "ERROR")
            debug_log("提示：这个结构体可能是作为嵌套数据类型使用，没有直接绑定到总线信号", "ERROR")
            continue

        # 5. 计算最终位置
        for map_info in mappings:
            sig_start_pos = map_info["start_pos"]
            final_start_bit = sig_start_pos + struct_offset_bit
            member_bit_len = 8
            final_end_bit = final_start_bit + member_bit_len - 1

            start_byte = final_start_bit // 8
            start_bit_in_byte = final_start_bit % 8
            end_byte = final_end_bit // 8
            end_bit_in_byte = final_end_bit % 8

            debug_log("\n" + "=" * 50)
            debug_log(f"【绑定到PDU: {map_info.get('pdu_path', 'N/A')} 的最终位置】")
            debug_log(f"顶层信号起始Bit    : {sig_start_pos}")
            debug_log(f"结构体内部偏移    : {struct_offset_bit}")
            debug_log(f"成员全局起始Bit    : {final_start_bit}")
            debug_log(f"成员全局结束Bit    : {final_end_bit}")
            debug_log(f"占用Bit长度        : {member_bit_len} Bit (1 Byte)")
            debug_log(f"起始Byte编号       : {start_byte} (0索引)")
            debug_log(f"起始Byte内Bit位    : {start_bit_in_byte}")
            debug_log(f"结束Byte编号       : {end_byte}")
            debug_log(f"结束Byte内Bit位    : {end_bit_in_byte}")
            debug_log("=" * 50)

    debug_log("\n" + "=" * 70)
    debug_log("解析全部完成！")
    debug_log("=" * 70)

if __name__ == "__main__":
    main()
