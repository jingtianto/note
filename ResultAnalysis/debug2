<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>XML 批注清理验证工具</title>
    <script src="https://cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', monospace; background: #f0f4f8; padding: 20px; }
        .container { max-width: 1200px; margin: 0 auto; background: #fff; padding: 24px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        h1 { font-size: 24px; border-bottom: 2px solid #475569; padding-bottom: 12px; margin-bottom: 16px; }
        .flex { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
        .btn { padding: 8px 20px; background: #3b82f6; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; }
        .btn:hover { background: #2563eb; }
        .btn-success { background: #22c55e; }
        .btn-success:hover { background: #16a34a; }
        .log-area { background: #1e293b; color: #e2e8f0; padding: 16px; border-radius: 8px; max-height: 600px; overflow-y: auto; font-size: 13px; white-space: pre-wrap; margin-top: 16px; font-family: 'Consolas', monospace; }
        .log-error { color: #fca5a5; }
        .log-success { color: #86efac; }
        .log-info { color: #93c5fd; }
        .log-warn { color: #fcd34d; }
        .log-bold { font-weight: bold; color: #ffffff; }
        input[type="file"] { padding: 6px; border: 1px solid #d1d9e6; border-radius: 4px; }
        .file-list { background: #0f172a; padding: 8px; border-radius: 4px; margin: 4px 0; font-size: 12px; max-height: 200px; overflow-y: auto; }
    </style>
</head>
<body>
<div class="container">
    <h1>🧹 XML 批注清理验证工具</h1>
    <p>上传 Excel 文件，自动清理 sheet XML 中的批注标签，然后加载并验证颜色。</p>
    <div class="flex">
        <input type="file" id="fileInput" accept=".xlsx,.xls" />
        <button class="btn" onclick="runCleanTest()">🚀 清理并验证</button>
        <button class="btn btn-success" onclick="clearLog()">清空日志</button>
    </div>
    <div id="logArea" class="log-area">等待操作...</div>
</div>

<script>
    // 颜色映射表
    const COLOR_MAP = {
        10: { name: '红色', meaning: 'failed' },
        35: { name: '浅蓝色', meaning: 'signal missing' },
        52: { name: '橙色', meaning: 'trigger not occurred' },
        13: { name: '黄色', meaning: 'warning' },
        11: { name: '绿色', meaning: 'passed' },
        9:  { name: 'blank', meaning: 'blank' }
    };

    const COLOR_CSS = {
        '红色': '#FF0000',
        '绿色': '#00FF00',
        '浅蓝色': '#99CCFF',
        '橙色': '#FF9900',
        '黄色': '#FFFF00',
        'blank': '#f1f5f9'
    };

    function log(message, type = 'info') {
        const area = document.getElementById('logArea');
        const entry = document.createElement('div');
        entry.className = 'log-' + type;
        entry.textContent = message;
        area.appendChild(entry);
        area.scrollTop = area.scrollHeight;
    }

    function clearLog() {
        document.getElementById('logArea').innerHTML = '';
        log('日志已清空', 'info');
    }

    // 从 XML 字符串中删除所有 comments 相关的节点
    function removeCommentsFromXML(xmlString) {
        const parser = new DOMParser();
        const xmlDoc = parser.parseFromString(xmlString, 'text/xml');

        // 查找所有 comments 相关的元素
        const commentsElements = xmlDoc.querySelectorAll('comments');
        commentsElements.forEach(el => el.remove());

        // 查找所有 comment 元素（在 sheet 中）
        const commentElements = xmlDoc.querySelectorAll('comment');
        commentElements.forEach(el => el.remove());

        // 查找所有 comment 引用（可能在 rels 中，但这里不处理）
        // 额外：删除 comment 相关的属性（如果有）
        const allElements = xmlDoc.querySelectorAll('*');
        allElements.forEach(el => {
            if (el.hasAttribute('r:id')) {
                const val = el.getAttribute('r:id');
                if (val && val.startsWith('rId') && val.includes('comment')) {
                    el.removeAttribute('r:id');
                }
            }
        });

        // 序列化回字符串
        return new XMLSerializer().serializeToString(xmlDoc);
    }

    async function runCleanTest() {
        const fileInput = document.getElementById('fileInput');
        const file = fileInput.files[0];
        if (!file) {
            alert('请先选择 Excel 文件');
            return;
        }

        clearLog();
        log('📁 文件: ' + file.name, 'info');
        log('📏 大小: ' + (file.size / 1024).toFixed(1) + ' KB', 'info');

        const originalData = await file.arrayBuffer();

        // ========== 第一步：解压并清理 ==========
        log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
        log('【第一步】解压并清理批注标签', 'bold');

        let cleanedCount = 0;
        let sheetFiles = [];

        try {
            const copyData = new Uint8Array(originalData);
            const zip = await JSZip.loadAsync(copyData);

            // 查找所有 sheet XML 文件
            zip.forEach((relativePath, file) => {
                if (relativePath.match(/xl\/worksheets\/sheet.*\.xml/)) {
                    sheetFiles.push(relativePath);
                }
            });

            log('📋 找到 ' + sheetFiles.length + ' 个工作表 XML 文件', 'info');

            // 逐个处理 sheet XML
            for (let sheetPath of sheetFiles) {
                const file = zip.file(sheetPath);
                if (file) {
                    const content = await file.async('string');
                    // 检查是否包含批注标签
                    if (content.includes('<comment') || content.includes('<comments')) {
                        const cleaned = removeCommentsFromXML(content);
                        zip.file(sheetPath, cleaned);
                        cleanedCount++;
                        log('✅ 清理批注标签: ' + sheetPath, 'success');
                    } else {
                        log('ℹ️ 无批注标签: ' + sheetPath, 'info');
                    }
                }
            }

            // 也删除 comments 文件本身（如果有）
            const commentsFiles = [];
            zip.forEach((relativePath, file) => {
                if (relativePath.match(/xl\/comments.*\.xml/)) {
                    commentsFiles.push(relativePath);
                }
            });
            commentsFiles.forEach(path => {
                zip.remove(path);
                log('🗑️ 删除批注文件: ' + path, 'warn');
            });

            // 重新打包
            const cleanedData = await zip.generateAsync({ type: 'arraybuffer' });
            log('✅ 重新打包完成，大小: ' + (cleanedData.byteLength / 1024).toFixed(1) + ' KB', 'success');

            // ========== 第二步：加载清理后的文件 ==========
            log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
            log('【第二步】加载清理后的文件', 'bold');

            try {
                const wb = new ExcelJS.Workbook();
                await wb.xlsx.load(cleanedData);
                log('✅ 清理后加载成功！', 'success');

                // ========== 第三步：读取颜色 ==========
                log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
                log('【第三步】读取颜色', 'bold');

                const sheet = wb.getWorksheet('IPN');
                if (!sheet) {
                    log('⚠️ 未找到工作表 "IPN"', 'warn');
                    log('📋 可用工作表: ' + wb.worksheets.map(ws => ws.name).join(', '), 'info');
                    return;
                }

                // 读取 A24 验证颜色
                const cell = sheet.getCell('A24');
                let indexed = null;
                let colorName = '未识别';
                let meaning = '';

                if (cell.style && cell.style.fill && cell.style.fill.fgColor) {
                    indexed = cell.style.fill.fgColor.indexed;
                }

                if (indexed !== undefined && indexed !== null) {
                    const mapped = COLOR_MAP[indexed];
                    if (mapped) {
                        colorName = mapped.name;
                        meaning = mapped.meaning;
                        log('🎨 A24: fgColor.indexed = ' + indexed + ' → ' + colorName + ' (' + meaning + ')', 'success');
                    } else {
                        colorName = '未知索引 (' + indexed + ')';
                        log('⚠️ A24: fgColor.indexed = ' + indexed + ' (未映射)', 'warn');
                    }
                } else {
                    colorName = '无颜色';
                    meaning = 'blank';
                    log('ℹ️ A24 无填充颜色', 'info');
                }

                // 输出单元格值
                log('📝 A24 值: ' + (cell.value !== undefined && cell.value !== null ? cell.value : '(空)'), 'info');

                log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
                log('✅ 验证完成', 'success');

            } catch (e) {
                log('❌ 清理后加载失败: ' + e.message, 'error');
                log('📋 错误堆栈: ' + e.stack, 'error');
                log('💡 可能原因: 文件包含其他不兼容元素', 'warn');
                log('💡 建议: 手动用 Excel 打开并"另存为"', 'warn');
            }

        } catch (e) {
            log('❌ 处理失败: ' + e.message, 'error');
        }
    }

    // 初始提示
    log('请上传 Excel 文件，点击 "清理并验证"', 'info');
</script>
</body>
</html>