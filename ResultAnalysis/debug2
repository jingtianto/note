<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Open XML 完整属性读取</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', monospace; background: #f0f4f8; padding: 20px; }
        .container { max-width: 1200px; margin: 0 auto; background: #fff; padding: 24px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        h1 { font-size: 24px; border-bottom: 2px solid #475569; padding-bottom: 12px; margin-bottom: 16px; }
        .flex { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
        .btn { padding: 8px 20px; background: #3b82f6; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; }
        .btn:hover { background: #2563eb; }
        .btn-success { background: #22c55e; }
        .btn-success:hover { background: #16a34a; }
        .log-area { background: #1e293b; color: #e2e8f0; padding: 16px; border-radius: 8px; max-height: 700px; overflow-y: auto; font-size: 13px; white-space: pre-wrap; margin-top: 16px; font-family: 'Consolas', monospace; }
        .log-error { color: #fca5a5; }
        .log-success { color: #86efac; }
        .log-info { color: #93c5fd; }
        .log-warn { color: #fcd34d; }
        .log-bold { font-weight: bold; color: #ffffff; }
        input[type="file"] { padding: 6px; border: 1px solid #d1d9e6; border-radius: 4px; }
        input[type="text"] { padding: 6px 10px; border: 1px solid #d1d9e6; border-radius: 4px; width: 120px; }
        .expand-btn { cursor: pointer; color: #93c5fd; text-decoration: underline; }
        .collapsed { display: none; }
        .section { margin: 4px 0; padding: 4px 8px; background: #0f172a; border-radius: 4px; border-left: 3px solid #475569; }
        .section-title { font-weight: bold; color: #93c5fd; margin-bottom: 4px; }
    </style>
</head>
<body>
<div class="container">
    <h1>📄 Open XML 完整属性读取</h1>
    <p>读取指定单元格的所有属性（样式、填充、边框、字体等），不依赖 ExcelJS。</p>
    <div class="flex" style="margin-bottom: 12px;">
        <input type="file" id="fileInput" accept=".xlsx,.xls" />
        <label>工作表名称：</label>
        <input type="text" id="sheetName" value="IPN" style="width: 120px;" />
        <label>单元格地址：</label>
        <input type="text" id="cellAddress" value="A24" style="width: 100px;" />
        <button class="btn" onclick="runFullRead()">🔍 读取所有属性</button>
        <button class="btn btn-success" onclick="clearLog()">清空日志</button>
    </div>
    <div id="logArea" class="log-area">等待操作...</div>
</div>

<script>
    // ============================================================
    // 颜色映射表（fgColor.indexed → 颜色含义）
    // ============================================================
    const COLOR_MAP = {
        10: { name: '红色', meaning: 'failed' },
        35: { name: '浅蓝色', meaning: 'signal missing' },
        52: { name: '橙色', meaning: 'trigger not occurred' },
        13: { name: '黄色', meaning: 'warning' },
        11: { name: '绿色', meaning: 'passed' },
        9:  { name: 'blank', meaning: 'blank' }
    };

    const COLOR_CSS = {
        '红色': '#FF0000',
        '绿色': '#00FF00',
        '浅蓝色': '#99CCFF',
        '橙色': '#FF9900',
        '黄色': '#FFFF00',
        'blank': '#f1f5f9'
    };

    function log(message, type = 'info') {
        const area = document.getElementById('logArea');
        const entry = document.createElement('div');
        entry.className = 'log-' + type;
        entry.textContent = message;
        area.appendChild(entry);
        area.scrollTop = area.scrollHeight;
    }

    function logObject(obj, title = '') {
        if (title) log(title, 'info');
        log(JSON.stringify(obj, null, 2), 'info');
    }

    function clearLog() {
        document.getElementById('logArea').innerHTML = '';
        log('日志已清空', 'info');
    }

    // ============================================================
    // 从 XML 中提取单元格属性
    // ============================================================
    function extractCellProperties(xmlString, cellAddress) {
        const parser = new DOMParser();
        const xmlDoc = parser.parseFromString(xmlString, 'text/xml');

        // 查找单元格
        const cells = xmlDoc.querySelectorAll('c');
        let targetCell = null;

        for (let cell of cells) {
            const r = cell.getAttribute('r');
            if (r && r.toUpperCase() === cellAddress.toUpperCase()) {
                targetCell = cell;
                break;
            }
        }

        if (!targetCell) {
            return { success: false, message: '未找到单元格 ' + cellAddress };
        }

        // 提取所有属性
        const properties = {
            cellAddress: cellAddress,
            attributes: {},
            children: [],
            styleIndex: null,
            value: null,
            valueType: null,
            formula: null
        };

        // 读取所有属性
        for (let attr of targetCell.attributes) {
            properties.attributes[attr.name] = attr.value;
            if (attr.name === 's') {
                properties.styleIndex = parseInt(attr.value);
            }
        }

        // 读取子元素
        for (let child of targetCell.children) {
            const tagName = child.tagName;
            if (tagName === 'v') {
                properties.value = child.textContent;
                properties.valueType = 'value';
            } else if (tagName === 'f') {
                properties.formula = child.textContent;
            } else {
                properties.children.push({
                    tag: tagName,
                    text: child.textContent,
                    attributes: child.attributes
                });
            }
        }

        return { success: true, cell: targetCell, properties: properties };
    }

    // ============================================================
    // 从 styles.xml 读取完整样式
    // ============================================================
    function extractFullStyle(xmlString, styleIndex) {
        const parser = new DOMParser();
        const xmlDoc = parser.parseFromString(xmlString, 'text/xml');

        const result = {
            styleIndex: styleIndex,
            xf: null,
            fillId: null,
            fill: null,
            borderId: null,
            border: null,
            fontId: null,
            font: null,
            numberFormatId: null,
            fgColor: null,
            bgColor: null,
            indexed: null,
            rgb: null,
            theme: null,
            tint: null
        };

        // 查找样式
        const xfs = xmlDoc.querySelectorAll('xf');
        if (styleIndex >= xfs.length) {
            result.error = '样式索引 ' + styleIndex + ' 超出范围 (共 ' + xfs.length + ' 个样式)';
            return result;
        }

        const xf = xfs[styleIndex];
        result.xf = xf;

        // 提取属性
        for (let attr of xf.attributes) {
            if (attr.name === 'fillId') result.fillId = parseInt(attr.value);
            if (attr.name === 'borderId') result.borderId = parseInt(attr.value);
            if (attr.name === 'fontId') result.fontId = parseInt(attr.value);
            if (attr.name === 'numFmtId') result.numberFormatId = parseInt(attr.value);
        }

        // 查找填充
        if (result.fillId !== null) {
            const fills = xmlDoc.querySelectorAll('fill');
            if (result.fillId < fills.length) {
                const fill = fills[result.fillId];
                result.fill = fill;

                // 提取 fgColor
                const fgColor = fill.querySelector('fgColor');
                if (fgColor) {
                    result.fgColor = fgColor;
                    const indexed = fgColor.getAttribute('indexed');
                    if (indexed !== null) result.indexed = parseInt(indexed);
                    const rgb = fgColor.getAttribute('rgb');
                    if (rgb) result.rgb = rgb;
                    const theme = fgColor.getAttribute('theme');
                    if (theme) result.theme = parseInt(theme);
                    const tint = fgColor.getAttribute('tint');
                    if (tint) result.tint = parseFloat(tint);
                }

                const bgColor = fill.querySelector('bgColor');
                if (bgColor) {
                    result.bgColor = bgColor;
                }
            }
        }

        // 查找边框
        if (result.borderId !== null) {
            const borders = xmlDoc.querySelectorAll('border');
            if (result.borderId < borders.length) {
                result.border = borders[result.borderId];
            }
        }

        // 查找字体
        if (result.fontId !== null) {
            const fonts = xmlDoc.querySelectorAll('font');
            if (result.fontId < fonts.length) {
                result.font = fonts[result.fontId];
            }
        }

        return result;
    }

    // ============================================================
    // 获取 sheet 路径
    // ============================================================
    async function getSheetPath(zip, sheetName) {
        const workbookXml = zip.file('xl/workbook.xml');
        if (!workbookXml) return null;

        const content = await workbookXml.async('string');
        const parser = new DOMParser();
        const doc = parser.parseFromString(content, 'text/xml');

        const sheets = doc.querySelectorAll('sheet');
        for (let sheet of sheets) {
            const name = sheet.getAttribute('name');
            if (name === sheetName) {
                const rId = sheet.getAttribute('r:id');
                if (rId) {
                    // 尝试从 rels 查找
                    const relsFile = zip.file('xl/workbook.xml.rels');
                    if (relsFile) {
                        const relsContent = await relsFile.async('string');
                        const relsDoc = parser.parseFromString(relsContent, 'text/xml');
                        const rels = relsDoc.querySelectorAll('Relationship');
                        for (let rel of rels) {
                            const id = rel.getAttribute('Id');
                            if (id === rId) {
                                let target = rel.getAttribute('Target');
                                if (target && target.startsWith('worksheets/')) {
                                    return 'xl/' + target;
                                }
                            }
                        }
                    }
                    // 默认路径
                    const sheetIndex = Array.from(sheets).indexOf(sheet) + 1;
                    return 'xl/worksheets/sheet' + sheetIndex + '.xml';
                }
            }
        }
        return null;
    }

    // ============================================================
    // 获取所有工作表列表
    // ============================================================
    async function getSheetList(zip) {
        const workbookXml = zip.file('xl/workbook.xml');
        if (!workbookXml) return [];

        const content = await workbookXml.async('string');
        const parser = new DOMParser();
        const doc = parser.parseFromString(content, 'text/xml');

        const sheets = doc.querySelectorAll('sheet');
        return Array.from(sheets).map(s => s.getAttribute('name'));
    }

    // ============================================================
    // 主函数
    // ============================================================
    async function runFullRead() {
        const fileInput = document.getElementById('fileInput');
        const file = fileInput.files[0];
        if (!file) {
            alert('请先选择 Excel 文件');
            return;
        }

        const sheetName = document.getElementById('sheetName').value.trim() || 'IPN';
        const cellAddress = document.getElementById('cellAddress').value.trim().toUpperCase();
        if (!cellAddress) {
            alert('请输入单元格地址');
            return;
        }

        clearLog();
        log('📁 文件: ' + file.name, 'info');
        log('📄 工作表: ' + sheetName, 'info');
        log('📍 单元格: ' + cellAddress, 'info');
        log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');

        try {
            const arrayBuffer = await file.arrayBuffer();
            const zip = await JSZip.loadAsync(arrayBuffer);

            // 列出所有文件
            const fileList = [];
            zip.forEach((relativePath, file) => {
                fileList.push(relativePath);
            });
            log('📋 ZIP 包含 ' + fileList.length + ' 个文件', 'info');

            // ========== 获取工作表列表 ==========
            const sheets = await getSheetList(zip);
            log('📋 所有工作表: ' + sheets.join(', '), 'info');

            // ========== 定位工作表 ==========
            log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
            log('【第一步】定位工作表', 'bold');

            const sheetPath = await getSheetPath(zip, sheetName);
            if (!sheetPath) {
                log('❌ 未找到工作表 "' + sheetName + '"', 'error');
                return;
            }
            log('✅ 工作表路径: ' + sheetPath, 'success');

            // ========== 读取单元格属性 ==========
            log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
            log('【第二步】读取单元格属性', 'bold');

            const sheetFile = zip.file(sheetPath);
            if (!sheetFile) {
                log('❌ 未找到工作表文件', 'error');
                return;
            }

            const sheetContent = await sheetFile.async('string');
            const cellResult = extractCellProperties(sheetContent, cellAddress);

            if (!cellResult.success) {
                log('❌ ' + cellResult.message, 'error');
                return;
            }

            log('✅ 找到单元格', 'success');

            // 输出单元格所有属性
            log('📋 单元格属性:', 'info');
            const props = cellResult.properties;
            logObject(props.attributes, '  属性 (Attributes):');
            if (props.styleIndex !== null) {
                log('  样式索引 (s): ' + props.styleIndex, 'info');
            }
            if (props.value !== null) {
                log('  值 (v): ' + props.value, 'info');
            }
            if (props.formula) {
                log('  公式 (f): ' + props.formula, 'info');
            }
            if (props.children.length > 0) {
                log('  子元素:', 'info');
                props.children.forEach(c => {
                    log('    - ' + c.tag + ': ' + c.text, 'info');
                });
            }

            // ========== 读取完整样式 ==========
            if (props.styleIndex !== null) {
                log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
                log('【第三步】读取完整样式', 'bold');

                const stylesFile = zip.file('xl/styles.xml');
                if (!stylesFile) {
                    log('❌ 未找到 xl/styles.xml', 'error');
                    return;
                }

                const stylesContent = await stylesFile.async('string');
                const styleResult = extractFullStyle(stylesContent, props.styleIndex);

                if (styleResult.error) {
                    log('❌ ' + styleResult.error, 'error');
                    return;
                }

                log('✅ 样式索引: ' + props.styleIndex, 'success');

                // 输出填充信息
                if (styleResult.fill) {
                    log('📋 填充 (fill):', 'info');
                    log('  填充 ID: ' + styleResult.fillId, 'info');

                    if (styleResult.fgColor) {
                        log('  前景色 (fgColor):', 'info');
                        const fg = styleResult.fgColor;
                        for (let attr of fg.attributes) {
                            log('    ' + attr.name + ' = ' + attr.value, 'info');
                        }
                        if (styleResult.indexed !== null) {
                            log('    indexed = ' + styleResult.indexed, 'info');
                            const mapped = COLOR_MAP[styleResult.indexed];
                            if (mapped) {
                                log('    → ' + mapped.name + ' (' + mapped.meaning + ')', 'success');
                            } else {
                                log('    → 未知索引', 'warn');
                            }
                        }
                        if (styleResult.rgb) {
                            log('    rgb = ' + styleResult.rgb, 'info');
                        }
                        if (styleResult.theme !== null) {
                            log('    theme = ' + styleResult.theme, 'info');
                        }
                        if (styleResult.tint !== null) {
                            log('    tint = ' + styleResult.tint, 'info');
                        }
                    }

                    if (styleResult.bgColor) {
                        log('  背景色 (bgColor):', 'info');
                        for (let attr of styleResult.bgColor.attributes) {
                            log('    ' + attr.name + ' = ' + attr.value, 'info');
                        }
                    }
                } else {
                    log('ℹ️ 无填充信息', 'info');
                }

                // 输出边框信息
                if (styleResult.border) {
                    log('📋 边框 (border):', 'info');
                    log('  边框 ID: ' + styleResult.borderId, 'info');
                    // 提取边框属性
                    for (let child of styleResult.border.children) {
                        const tag = child.tagName;
                        if (tag.startsWith('border')) continue;
                        log('    ' + tag + ':', 'info');
                        for (let attr of child.attributes) {
                            log('      ' + attr.name + ' = ' + attr.value, 'info');
                        }
                    }
                }

                // 输出字体信息
                if (styleResult.font) {
                    log('📋 字体 (font):', 'info');
                    log('  字体 ID: ' + styleResult.fontId, 'info');
                    for (let child of styleResult.font.children) {
                        log('    ' + child.tagName + ':', 'info');
                        for (let attr of child.attributes) {
                            log('      ' + attr.name + ' = ' + attr.value, 'info');
                        }
                        if (child.textContent) {
                            log('      内容: ' + child.textContent.trim(), 'info');
                        }
                    }
                }

                // 输出数字格式
                if (styleResult.numberFormatId !== null) {
                    log('📋 数字格式 ID: ' + styleResult.numberFormatId, 'info');
                }

            } else {
                log('ℹ️ 单元格无样式引用 (s 属性为空)', 'info');
            }

            // ========== 显示颜色结果 ==========
            if (styleResult && styleResult.indexed !== null) {
                log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
                log('【结果】颜色识别', 'bold');
                const mapped = COLOR_MAP[styleResult.indexed];
                if (mapped) {
                    log('🎨 fgColor.indexed = ' + styleResult.indexed + ' → ' + mapped.name + ' (' + mapped.meaning + ')', 'success');
                } else {
                    log('⚠️ fgColor.indexed = ' + styleResult.indexed + ' (未映射)', 'warn');
                }
            }

            log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
            log('✅ 读取完成', 'success');

            // ========== 打印原始 XML 片段（调试用） ==========
            log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
            log('【调试】单元格原始 XML', 'bold');
            if (cellResult.cell) {
                const serializer = new XMLSerializer();
                const xmlString = serializer.serializeToString(cellResult.cell);
                log(xmlString, 'info');
            }

        } catch (e) {
            log('❌ 处理失败: ' + e.message, 'error');
            log('📋 堆栈: ' + e.stack, 'error');
        }
    }

    // 初始提示
    log('请上传 Excel 文件，输入工作表名和单元格地址，点击 "读取所有属性"', 'info');
</script>
</body>
</html>