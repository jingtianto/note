<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ExcelJS 4.3.0 调试工具</title>
    <!-- 使用 ExcelJS 4.3.0 -->
    <script src="https://cdn.jsdelivr.net/npm/exceljs@4.3.0/dist/exceljs.min.js"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', monospace; background: #f0f4f8; padding: 20px; }
        .container { max-width: 1200px; margin: 0 auto; background: #fff; padding: 24px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        h1 { font-size: 24px; border-bottom: 2px solid #475569; padding-bottom: 12px; margin-bottom: 16px; }
        .version-badge { background: #3b82f6; color: #fff; padding: 2px 12px; border-radius: 12px; font-size: 14px; display: inline-block; margin-left: 12px; }
        .flex { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
        .btn { padding: 8px 20px; background: #3b82f6; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; }
        .btn:hover { background: #2563eb; }
        .btn-success { background: #22c55e; }
        .btn-success:hover { background: #16a34a; }
        .log-area { background: #1e293b; color: #e2e8f0; padding: 16px; border-radius: 8px; max-height: 600px; overflow-y: auto; font-size: 13px; white-space: pre-wrap; margin-top: 16px; font-family: 'Consolas', monospace; }
        .log-error { color: #fca5a5; }
        .log-success { color: #86efac; }
        .log-info { color: #93c5fd; }
        .log-warn { color: #fcd34d; }
        .log-bold { font-weight: bold; color: #ffffff; }
        input[type="file"] { padding: 6px; border: 1px solid #d1d9e6; border-radius: 4px; }
        input[type="text"] { padding: 6px 10px; border: 1px solid #d1d9e6; border-radius: 4px; width: 120px; }
        .color-swatch { display: inline-block; width: 16px; height: 16px; border: 1px solid #64748b; border-radius: 3px; vertical-align: middle; margin-right: 6px; }
        .info-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 4px; padding: 8px 12px; margin: 4px 0; }
    </style>
</head>
<body>
<div class="container">
    <h1>🔧 ExcelJS 调试工具 <span class="version-badge">v4.3.0</span></h1>
    <p>测试 ExcelJS 4.3.0 是否能加载您的文件并读取颜色索引。</p>
    <div class="flex" style="margin-bottom: 12px;">
        <input type="file" id="fileInput" accept=".xlsx,.xls" />
        <label>工作表名称：</label>
        <input type="text" id="sheetName" value="IPN" style="width: 120px;" />
        <label>单元格地址：</label>
        <input type="text" id="cellAddress" value="A24" style="width: 100px;" />
        <button class="btn" onclick="runDebug()">🔍 调试</button>
        <button class="btn btn-success" onclick="clearLog()">清空日志</button>
    </div>
    <div id="logArea" class="log-area">等待操作...</div>
</div>

<script>
    // ============================================================
    // 颜色映射表
    // ============================================================
    const COLOR_MAP = {
        10: { name: '红色', meaning: 'failed' },
        35: { name: '浅蓝色', meaning: 'signal missing' },
        52: { name: '橙色', meaning: 'trigger not occurred' },
        13: { name: '黄色', meaning: 'warning' },
        11: { name: '绿色', meaning: 'passed' },
        9:  { name: 'blank', meaning: 'blank' }
    };

    const COLOR_CSS = {
        '红色': '#FF0000',
        '绿色': '#00FF00',
        '浅蓝色': '#99CCFF',
        '橙色': '#FF9900',
        '黄色': '#FFFF00',
        'blank': '#f1f5f9'
    };

    function log(message, type = 'info') {
        const area = document.getElementById('logArea');
        const entry = document.createElement('div');
        entry.className = 'log-' + type;
        entry.textContent = message;
        area.appendChild(entry);
        area.scrollTop = area.scrollHeight;
    }

    function logObject(obj, title = '') {
        if (title) log(title, 'info');
        log(JSON.stringify(obj, null, 2), 'info');
    }

    function clearLog() {
        document.getElementById('logArea').innerHTML = '';
        log('日志已清空', 'info');
    }

    // ============================================================
    // 核心调试函数
    // ============================================================
    async function runDebug() {
        const fileInput = document.getElementById('fileInput');
        const file = fileInput.files[0];
        if (!file) {
            alert('请先选择 Excel 文件');
            return;
        }

        const sheetName = document.getElementById('sheetName').value.trim() || 'IPN';
        const cellAddress = document.getElementById('cellAddress').value.trim().toUpperCase();
        if (!cellAddress) {
            alert('请输入单元格地址');
            return;
        }

        clearLog();
        log('📁 文件: ' + file.name, 'info');
        log('📄 工作表: ' + sheetName, 'info');
        log('📍 单元格: ' + cellAddress, 'info');
        log('📦 ExcelJS 版本: ' + (typeof ExcelJS !== 'undefined' ? ExcelJS.version || '未知' : '未加载'), 'info');

        // 读取文件数据
        const arrayBuffer = await file.arrayBuffer();
        log('📏 文件大小: ' + (arrayBuffer.byteLength / 1024).toFixed(1) + ' KB', 'info');

        // ========== 尝试加载 ==========
        log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
        log('【第一步】ExcelJS 加载文件', 'bold');

        let workbook = null;
        let loadSuccess = false;

        try {
            const wb = new ExcelJS.Workbook();
            await wb.xlsx.load(arrayBuffer);
            workbook = wb;
            loadSuccess = true;
            log('✅ 加载成功！', 'success');
        } catch (e) {
            log('❌ 加载失败: ' + e.message, 'error');
            log('📋 错误堆栈: ' + e.stack, 'error');
            // 检查是否与 comments 相关
            if (e.message && e.message.includes('comments')) {
                log('🔍 检测到批注相关错误 (comments)', 'warn');
                log('💡 建议: ExcelJS 4.3.0 也无法处理批注文件', 'warn');
            }
            // 继续尝试读取（如果有部分加载）
        }

        // ========== 读取颜色 ==========
        if (loadSuccess && workbook) {
            log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
            log('【第二步】读取单元格颜色', 'bold');

            // 列出所有工作表
            const sheetNames = workbook.worksheets.map(ws => ws.name);
            log('📋 所有工作表: ' + sheetNames.join(', '), 'info');

            const sheet = workbook.getWorksheet(sheetName);
            if (!sheet) {
                log('❌ 未找到工作表 "' + sheetName + '"', 'error');
                return;
            }

            try {
                const cell = sheet.getCell(cellAddress);
                log('📝 单元格值: ' + (cell.value !== undefined && cell.value !== null ? cell.value : '(空)'), 'info');
                log('📝 单元格类型: ' + (cell.type || '未知'), 'info');

                // 读取样式
                if (cell.style) {
                    log('📋 完整样式对象:', 'info');
                    logObject(cell.style, '');
                } else {
                    log('⚠️ 单元格无样式', 'warn');
                }

                // 读取填充颜色
                let indexed = null;
                let fgColor = null;
                let bgColor = null;

                if (cell.style && cell.style.fill) {
                    const fill = cell.style.fill;
                    log('📋 fill 对象:', 'info');
                    logObject(fill, '');

                    if (fill.fgColor) {
                        fgColor = fill.fgColor;
                        log('📋 fgColor: ' + JSON.stringify(fgColor), 'info');
                        // 尝试读取 indexed
                        if (fgColor.indexed !== undefined) {
                            indexed = fgColor.indexed;
                            log('✅ fgColor.indexed = ' + indexed, 'success');
                        } else {
                            log('⚠️ fgColor 无 indexed 属性', 'warn');
                            // 检查其他属性
                            if (fgColor.argb) log('   argb: ' + fgColor.argb, 'info');
                            if (fgColor.rgb) log('   rgb: ' + fgColor.rgb, 'info');
                            if (fgColor.theme !== undefined) log('   theme: ' + fgColor.theme, 'info');
                            if (fgColor.tint !== undefined) log('   tint: ' + fgColor.tint, 'info');
                        }
                    }

                    if (fill.bgColor) {
                        bgColor = fill.bgColor;
                        log('📋 bgColor: ' + JSON.stringify(bgColor), 'info');
                        if (bgColor.indexed !== undefined) {
                            log('   bgColor.indexed = ' + bgColor.indexed, 'info');
                        }
                    }
                } else {
                    log('ℹ️ 单元格无填充 (fill 为空)', 'info');
                }

                // ========== 显示颜色结果 ==========
                if (indexed !== null && indexed !== undefined) {
                    log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
                    log('【结果】颜色识别', 'bold');
                    const mapped = COLOR_MAP[indexed];
                    if (mapped) {
                        log('🎨 fgColor.indexed = ' + indexed + ' → ' + mapped.name + ' (' + mapped.meaning + ')', 'success');
                    } else {
                        log('⚠️ fgColor.indexed = ' + indexed + ' (未映射)', 'warn');
                    }
                } else {
                    log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
                    log('【结果】无颜色信息', 'warn');
                    log('ℹ️ 该单元格无填充颜色或颜色信息无法读取', 'info');
                }

                // ========== 尝试读取 sheet XML 原始结构（如果是 XML 格式） ==========
                // 这里无法直接获取 sheet XML，但可以输出更多样式信息
                log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
                log('【调试信息】', 'bold');

                // 尝试获取单元格的完整属性
                if (cell._model) {
                    log('📋 单元格模型 (_model):', 'info');
                    logObject(cell._model, '');
                }

                // 检查是否有 comment 相关
                if (cell.comments) {
                    log('⚠️ 单元格包含批注: ' + JSON.stringify(cell.comments), 'warn');
                }

            } catch (e) {
                log('❌ 读取单元格失败: ' + e.message, 'error');
            }

            log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
            log('✅ 调试完成', 'success');

        } else {
            log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
            log('【结论】ExcelJS 4.3.0 无法加载此文件', 'error');
            log('💡 建议: 换用更高版本或使用 Open XML 方案', 'warn');
        }
    }

    // 初始提示
    log('请上传 Excel 文件，点击 "调试" 测试 ExcelJS 4.3.0', 'info');
</script>
</body>
</html>