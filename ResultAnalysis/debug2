<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>增强版 Excel 调试工具</title>
    <script src="https://cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', monospace; background: #f0f4f8; padding: 20px; }
        .container { max-width: 1200px; margin: 0 auto; background: #fff; padding: 24px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        h1 { font-size: 24px; border-bottom: 2px solid #475569; padding-bottom: 12px; margin-bottom: 16px; }
        .flex { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
        .btn { padding: 8px 20px; background: #3b82f6; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; }
        .btn:hover { background: #2563eb; }
        .log-area { background: #1e293b; color: #e2e8f0; padding: 16px; border-radius: 8px; max-height: 600px; overflow-y: auto; font-size: 13px; white-space: pre-wrap; margin-top: 16px; }
        .log-error { color: #fca5a5; }
        .log-success { color: #86efac; }
        .log-info { color: #93c5fd; }
        .log-warn { color: #fcd34d; }
        .log-bold { font-weight: bold; color: #ffffff; }
        .file-list { background: #0f172a; padding: 8px; border-radius: 4px; margin: 4px 0; font-size: 12px; }
        input[type="file"] { padding: 6px; border: 1px solid #d1d9e6; border-radius: 4px; }
    </style>
</head>
<body>
<div class="container">
    <h1>🔧 增强版 Excel 调试工具</h1>
    <p>上传 Excel 文件，自动解压、清理并报告详细错误。</p>
    <div class="flex">
        <input type="file" id="fileInput" accept=".xlsx,.xls" />
        <button class="btn" onclick="runDeepDebug()">🔍 深度调试</button>
        <button class="btn btn-success" onclick="clearLog()">清空日志</button>
    </div>
    <div id="logArea" class="log-area">等待操作...</div>
</div>

<script>
    // 颜色映射（仅用于显示）
    const COLOR_MAP = {
        10: '红色 (failed)',
        35: '浅蓝色 (signal missing)',
        52: '橙色 (trigger not occurred)',
        13: '黄色 (warning)',
        11: '绿色 (passed)',
        9: 'blank'
    };

    function log(message, type = 'info') {
        const area = document.getElementById('logArea');
        const entry = document.createElement('div');
        entry.className = 'log-' + type;
        entry.textContent = message;
        area.appendChild(entry);
        area.scrollTop = area.scrollHeight;
    }

    function clearLog() {
        document.getElementById('logArea').innerHTML = '';
        log('日志已清空', 'info');
    }

    async function runDeepDebug() {
        const fileInput = document.getElementById('fileInput');
        const file = fileInput.files[0];
        if (!file) {
            alert('请先选择 Excel 文件');
            return;
        }

        clearLog();
        log('📁 文件: ' + file.name, 'info');
        log('📏 大小: ' + (file.size / 1024).toFixed(1) + ' KB', 'info');

        const originalData = await file.arrayBuffer();

        // ========== 第一步：列出所有内部文件 ==========
        log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
        log('【第一步】解压并列出所有文件', 'bold');

        let allFiles = [];
        let zip;

        try {
            const copyData = new Uint8Array(originalData);
            zip = await JSZip.loadAsync(copyData);
            allFiles = [];
            zip.forEach((relativePath, file) => {
                allFiles.push(relativePath);
            });
            allFiles.sort();
            log('📋 共 ' + allFiles.length + ' 个文件', 'info');
            log('📋 文件列表:\n' + allFiles.map(f => '  ' + f).join('\n'), 'info');
        } catch (e) {
            log('❌ 解压失败: ' + e.message, 'error');
            return;
        }

        // ========== 第二步：尝试清理所有批注相关文件 ==========
        log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
        log('【第二步】清理批注相关文件', 'bold');

        const toRemove = [];
        const patterns = [
            /xl\/comments.*\.xml/,
            /xl\/comments\/.*\.xml/,
            /xl\/worksheets\/_rels\/.*\.xml\.rels/,
            /xl\/comments.*\.xml\.rels/,
            /xl\/workbook\.xml\.rels/  // 谨慎删除，可能包含其他重要引用
        ];

        // 但为了彻底，我们只删除明确的批注文件及其引用
        // 更安全的做法：只删除 comment 相关文件
        const safePatterns = [
            /xl\/comments.*\.xml/,
            /xl\/comments\/.*\.xml/
        ];

        zip.forEach((relativePath, file) => {
            for (let pattern of safePatterns) {
                if (pattern.test(relativePath)) {
                    toRemove.push(relativePath);
                    break;
                }
            }
        });

        if (toRemove.length > 0) {
            log('🗑️ 删除批注文件: ' + toRemove.join(', '), 'warn');
            toRemove.forEach(path => zip.remove(path));
        } else {
            log('ℹ️ 未找到批注文件', 'info');
        }

        // ========== 第三步：尝试加载清理后的文件 ==========
        log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
        log('【第三步】加载清理后的文件', 'bold');

        let cleanedData;
        try {
            cleanedData = await zip.generateAsync({ type: 'arraybuffer' });
            log('✅ 重新打包完成，大小: ' + (cleanedData.byteLength / 1024).toFixed(1) + ' KB', 'success');
        } catch (e) {
            log('❌ 重新打包失败: ' + e.message, 'error');
            return;
        }

        // 尝试加载
        try {
            const wb = new ExcelJS.Workbook();
            await wb.xlsx.load(cleanedData);
            log('✅ 清理后加载成功！', 'success');

            // 尝试读取一个单元格的颜色
            const sheet = wb.getWorksheet('IPN');
            if (sheet) {
                const cell = sheet.getCell('A24');
                let indexed = null;
                if (cell.style && cell.style.fill && cell.style.fill.fgColor) {
                    indexed = cell.style.fill.fgColor.indexed;
                }
                if (indexed !== undefined && indexed !== null) {
                    const color = COLOR_MAP[indexed] || '未知索引 ' + indexed;
                    log('🎨 A24 颜色: ' + color, 'success');
                } else {
                    log('⚠️ A24 无颜色信息', 'warn');
                }
            }
        } catch (e) {
            log('❌ 清理后仍然加载失败: ' + e.message, 'error');
            log('📋 错误堆栈: ' + e.stack, 'error');

            // ========== 第四步：尝试更激进的清理 ==========
            log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
            log('【第四步】尝试更激进的清理（删除 worksheet rels）', 'bold');

            // 重新加载原始 ZIP
            const freshCopy = new Uint8Array(originalData);
            const freshZip = await JSZip.loadAsync(freshCopy);
            const aggressiveRemove = [];

            freshZip.forEach((relativePath, file) => {
                // 删除所有可能与批注相关的文件
                if (/xl\/comments/.test(relativePath)) {
                    aggressiveRemove.push(relativePath);
                }
                if (/xl\/worksheets\/_rels\/.*\.xml\.rels/.test(relativePath)) {
                    // 检查 rels 文件中是否包含 comment 引用
                    aggressiveRemove.push(relativePath);
                }
                // 也删除 comments 相关的 rels
                if (/xl\/comments.*\.rels/.test(relativePath)) {
                    aggressiveRemove.push(relativePath);
                }
            });

            // 去重
            const uniqueRemove = [...new Set(aggressiveRemove)];
            if (uniqueRemove.length > 0) {
                log('🗑️ 激进删除: ' + uniqueRemove.join(', '), 'warn');
                uniqueRemove.forEach(path => freshZip.remove(path));
            } else {
                log('ℹ️ 未找到额外可删除的文件', 'info');
            }

            try {
                const aggressiveData = await freshZip.generateAsync({ type: 'arraybuffer' });
                const wb2 = new ExcelJS.Workbook();
                await wb2.xlsx.load(aggressiveData);
                log('✅ 激进清理后加载成功！', 'success');
            } catch (e2) {
                log('❌ 激进清理后仍然失败: ' + e2.message, 'error');
                log('📋 可能原因是文件包含其他不兼容元素', 'error');
                log('💡 建议: 手动用 Excel 打开并"另存为"', 'warn');
            }
        }
    }

    // 初始提示
    log('请上传 Excel 文件，点击 "深度调试"', 'info');
</script>
</body>
</html>