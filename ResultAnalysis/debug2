<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Open XML 颜色验证工具</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', monospace; background: #f0f4f8; padding: 20px; }
        .container { max-width: 1200px; margin: 0 auto; background: #fff; padding: 24px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        h1 { font-size: 24px; border-bottom: 2px solid #475569; padding-bottom: 12px; margin-bottom: 16px; }
        .flex { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
        .btn { padding: 8px 20px; background: #3b82f6; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; }
        .btn:hover { background: #2563eb; }
        .btn-success { background: #22c55e; }
        .btn-success:hover { background: #16a34a; }
        .log-area { background: #1e293b; color: #e2e8f0; padding: 16px; border-radius: 8px; max-height: 600px; overflow-y: auto; font-size: 13px; white-space: pre-wrap; margin-top: 16px; font-family: 'Consolas', monospace; }
        .log-error { color: #fca5a5; }
        .log-success { color: #86efac; }
        .log-info { color: #93c5fd; }
        .log-warn { color: #fcd34d; }
        .log-bold { font-weight: bold; color: #ffffff; }
        input[type="file"] { padding: 6px; border: 1px solid #d1d9e6; border-radius: 4px; }
        input[type="text"] { padding: 6px 10px; border: 1px solid #d1d9e6; border-radius: 4px; width: 120px; }
        .color-swatch { display: inline-block; width: 16px; height: 16px; border: 1px solid #64748b; border-radius: 3px; vertical-align: middle; margin-right: 6px; }
    </style>
</head>
<body>
<div class="container">
    <h1>📄 Open XML 颜色验证工具</h1>
    <p>直接从 Excel 文件的 XML 中读取颜色索引，完全绕过 ExcelJS。</p>
    <div class="flex" style="margin-bottom: 12px;">
        <input type="file" id="fileInput" accept=".xlsx,.xls" />
        <label>工作表名称：</label>
        <input type="text" id="sheetName" value="IPN" style="width: 120px;" />
        <label>单元格地址：</label>
        <input type="text" id="cellAddress" value="A24" style="width: 100px;" />
        <button class="btn" onclick="runOpenXMLTest()">🔍 读取颜色</button>
        <button class="btn btn-success" onclick="clearLog()">清空日志</button>
    </div>
    <div id="logArea" class="log-area">等待操作...</div>
</div>

<script>
    // ============================================================
    // 颜色映射表（fgColor.indexed → 颜色含义）
    // ============================================================
    const COLOR_MAP = {
        10: { name: '红色', meaning: 'failed' },
        35: { name: '浅蓝色', meaning: 'signal missing' },
        52: { name: '橙色', meaning: 'trigger not occurred' },
        13: { name: '黄色', meaning: 'warning' },
        11: { name: '绿色', meaning: 'passed' },
        9:  { name: 'blank', meaning: 'blank' }
    };

    const COLOR_CSS = {
        '红色': '#FF0000',
        '绿色': '#00FF00',
        '浅蓝色': '#99CCFF',
        '橙色': '#FF9900',
        '黄色': '#FFFF00',
        'blank': '#f1f5f9'
    };

    function log(message, type = 'info') {
        const area = document.getElementById('logArea');
        const entry = document.createElement('div');
        entry.className = 'log-' + type;
        entry.textContent = message;
        area.appendChild(entry);
        area.scrollTop = area.scrollHeight;
    }

    function clearLog() {
        document.getElementById('logArea').innerHTML = '';
        log('日志已清空', 'info');
    }

    // ============================================================
    // 核心：从 XML 中提取颜色索引
    // ============================================================
    function extractColorIndexFromXML(xmlString, cellAddress) {
        const parser = new DOMParser();
        const xmlDoc = parser.parseFromString(xmlString, 'text/xml');

        // 查找单元格
        const cells = xmlDoc.querySelectorAll('c');
        let targetCell = null;

        for (let cell of cells) {
            const r = cell.getAttribute('r');
            if (r && r.toUpperCase() === cellAddress.toUpperCase()) {
                targetCell = cell;
                break;
            }
        }

        if (!targetCell) {
            return { success: false, message: '未找到单元格 ' + cellAddress };
        }

        // 查找样式引用
        const sAttr = targetCell.getAttribute('s');
        if (sAttr === null || sAttr === undefined) {
            return { success: true, indexed: null, message: '单元格无样式引用 (s 属性为空)' };
        }

        const styleIndex = parseInt(sAttr);
        return { success: true, styleIndex: styleIndex, message: '找到样式索引: ' + styleIndex };
    }

    // ============================================================
    // 从 styles.xml 中提取颜色索引
    // ============================================================
    function extractColorFromStyles(xmlString, styleIndex) {
        const parser = new DOMParser();
        const xmlDoc = parser.parseFromString(xmlString, 'text/xml');

        // 查找样式
        const cells = xmlDoc.querySelectorAll('xf');
        if (styleIndex >= cells.length) {
            return { success: false, message: '样式索引 ' + styleIndex + ' 超出范围 (共 ' + cells.length + ' 个样式)' };
        }

        const xf = cells[styleIndex];
        if (!xf) {
            return { success: false, message: '样式 ' + styleIndex + ' 不存在' };
        }

        // 检查是否有填充
        const fillIdAttr = xf.getAttribute('fillId');
        if (fillIdAttr === null || fillIdAttr === undefined) {
            return { success: true, indexed: null, message: '样式无填充 (fillId 为空)' };
        }

        const fillId = parseInt(fillIdAttr);

        // 查找填充
        const fills = xmlDoc.querySelectorAll('fill');
        if (fillId >= fills.length) {
            return { success: false, message: '填充索引 ' + fillId + ' 超出范围 (共 ' + fills.length + ' 个填充)' };
        }

        const fill = fills[fillId];
        if (!fill) {
            return { success: false, message: '填充 ' + fillId + ' 不存在' };
        }

        // 查找 fgColor
        const fgColor = fill.querySelector('fgColor');
        if (!fgColor) {
            return { success: true, indexed: null, message: '填充无 fgColor' };
        }

        const indexed = fgColor.getAttribute('indexed');
        if (indexed === null || indexed === undefined) {
            // 检查是否有 rgb
            const rgb = fgColor.getAttribute('rgb');
            if (rgb) {
                return { success: true, indexed: null, rgb: rgb, message: '找到 rgb: ' + rgb + ' (非索引颜色)' };
            }
            return { success: true, indexed: null, message: 'fgColor 无 indexed 属性' };
        }

        const indexedValue = parseInt(indexed);
        return { success: true, indexed: indexedValue, message: '找到 fgColor.indexed = ' + indexedValue };
    }

    // ============================================================
    // 主函数
    // ============================================================
    async function runOpenXMLTest() {
        const fileInput = document.getElementById('fileInput');
        const file = fileInput.files[0];
        if (!file) {
            alert('请先选择 Excel 文件');
            return;
        }

        const sheetName = document.getElementById('sheetName').value.trim() || 'IPN';
        const cellAddress = document.getElementById('cellAddress').value.trim().toUpperCase();
        if (!cellAddress) {
            alert('请输入单元格地址');
            return;
        }

        clearLog();
        log('📁 文件: ' + file.name, 'info');
        log('📄 工作表: ' + sheetName, 'info');
        log('📍 单元格: ' + cellAddress, 'info');

        try {
            const arrayBuffer = await file.arrayBuffer();
            const zip = await JSZip.loadAsync(arrayBuffer);

            // 列出所有文件
            const fileList = [];
            zip.forEach((relativePath, file) => {
                fileList.push(relativePath);
            });
            log('📋 ZIP 包含 ' + fileList.length + ' 个文件', 'info');

            // ========== 第一步：定位工作表 ==========
            log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
            log('【第一步】定位工作表', 'bold');

            // 读取 workbook.xml 获取 sheet 映射
            const workbookXml = zip.file('xl/workbook.xml');
            if (!workbookXml) {
                log('❌ 未找到 xl/workbook.xml', 'error');
                return;
            }

            const workbookContent = await workbookXml.async('string');
            const parser = new DOMParser();
            const workbookDoc = parser.parseFromString(workbookContent, 'text/xml');

            // 查找所有 sheet
            const sheets = workbookDoc.querySelectorAll('sheet');
            let sheetId = null;
            let sheetPath = null;

            for (let sheet of sheets) {
                const name = sheet.getAttribute('name');
                if (name === sheetName) {
                    const rId = sheet.getAttribute('r:id');
                    if (rId) {
                        // 从 workbook.xml.rels 查找对应的文件路径
                        // 直接构造路径：xl/worksheets/sheetX.xml
                        // 但更精确的是通过 rels 查找
                        sheetId = rId;
                        // 尝试从 rels 查找
                        const relsFile = zip.file('xl/workbook.xml.rels');
                        if (relsFile) {
                            const relsContent = await relsFile.async('string');
                            const relsDoc = parser.parseFromString(relsContent, 'text/xml');
                            const rels = relsDoc.querySelectorAll('Relationship');
                            for (let rel of rels) {
                                const id = rel.getAttribute('Id');
                                if (id === rId) {
                                    let target = rel.getAttribute('Target');
                                    if (target && target.startsWith('worksheets/')) {
                                        sheetPath = 'xl/' + target;
                                    }
                                    break;
                                }
                            }
                        }
                        // 如果没找到 rels，使用默认命名
                        if (!sheetPath) {
                            const sheetIndex = Array.from(sheets).indexOf(sheet) + 1;
                            sheetPath = 'xl/worksheets/sheet' + sheetIndex + '.xml';
                        }
                        break;
                    }
                }
            }

            if (!sheetPath) {
                log('❌ 未找到工作表 "' + sheetName + '"', 'error');
                log('📋 可用工作表: ' + Array.from(sheets).map(s => s.getAttribute('name')).join(', '), 'info');
                return;
            }

            log('✅ 找到工作表: ' + sheetPath, 'success');

            // ========== 第二步：读取单元格样式索引 ==========
            log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
            log('【第二步】读取单元格样式索引', 'bold');

            const sheetFile = zip.file(sheetPath);
            if (!sheetFile) {
                log('❌ 未找到工作表文件: ' + sheetPath, 'error');
                return;
            }

            const sheetContent = await sheetFile.async('string');
            const cellResult = extractColorIndexFromXML(sheetContent, cellAddress);

            if (!cellResult.success) {
                log('❌ ' + cellResult.message, 'error');
                return;
            }

            log('✅ ' + cellResult.message, 'success');

            if (cellResult.styleIndex === undefined || cellResult.styleIndex === null) {
                log('⚠️ 单元格无样式，可能无颜色填充', 'warn');
                return;
            }

            // ========== 第三步：从 styles.xml 读取颜色 ==========
            log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
            log('【第三步】从 styles.xml 读取颜色', 'bold');

            const stylesFile = zip.file('xl/styles.xml');
            if (!stylesFile) {
                log('❌ 未找到 xl/styles.xml', 'error');
                return;
            }

            const stylesContent = await stylesFile.async('string');
            const colorResult = extractColorFromStyles(stylesContent, cellResult.styleIndex);

            if (!colorResult.success) {
                log('❌ ' + colorResult.message, 'error');
                return;
            }

            log('✅ ' + colorResult.message, 'success');

            // ========== 第四步：显示结果 ==========
            log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
            log('【第四步】显示结果', 'bold');

            let indexed = colorResult.indexed;
            let colorName = '未识别';
            let meaning = '';
            let colorCss = '#ffffff';

            if (indexed !== undefined && indexed !== null) {
                const mapped = COLOR_MAP[indexed];
                if (mapped) {
                    colorName = mapped.name;
                    meaning = mapped.meaning;
                    colorCss = COLOR_CSS[colorName] || '#ffffff';
                    log('🎨 fgColor.indexed = ' + indexed + ' → ' + colorName + ' (' + meaning + ')', 'success');
                } else {
                    colorName = '未知索引 (' + indexed + ')';
                    log('⚠️ fgColor.indexed = ' + indexed + ' (未映射)', 'warn');
                }
            } else {
                if (colorResult.rgb) {
                    log('🔍 使用 RGB: ' + colorResult.rgb + ' (非索引颜色，无法映射)', 'warn');
                } else {
                    log('ℹ️ 单元格无填充颜色', 'info');
                }
                colorName = 'blank';
                meaning = 'blank';
                colorCss = '#f1f5f9';
            }

            log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━', 'info');
            log('✅ 验证完成', 'success');

        } catch (e) {
            log('❌ 处理失败: ' + e.message, 'error');
            log('📋 堆栈: ' + e.stack, 'error');
        }
    }

    // 初始提示
    log('请上传 Excel 文件，输入工作表名和单元格地址，点击 "读取颜色"', 'info');
</script>
</body>
</html>