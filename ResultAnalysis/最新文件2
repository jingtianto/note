    function buildMergedColumnTableMulti(fileResults, alignValues, hasAlign) {
        const table = document.createElement('table');
        const thead = document.createElement('thead');
        const trHead = document.createElement('tr');

        const defaultFontSize = 14;
        const defaultColumnWidth = 120;

        // 修复：增加 alignValues.length > 0 判断
        const rowLabel = (hasAlign && alignValues && alignValues.length > 0) ? '对齐值' : '行号';
        trHead.innerHTML = `<th>${rowLabel}</th>`;

        fileResults.forEach((res, fi) => {
            const kw = res.data.columnData.keywords || [];
            const displayName = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            kw.forEach((k, idx) => {
                const fontSize = k.fontSize || defaultFontSize;
                const columnWidth = k.columnWidth || defaultColumnWidth;
                let label = k.keywordText || '';
                if (k.valuePosition === 'left') label += ' ←' + k.offset;
                else if (k.valuePosition === 'right') label += ' →' + k.offset;
                const th = document.createElement('th');
                th.textContent = `${displayName}\n${label}`;
                th.style.fontSize = fontSize + 'px';
                th.style.minWidth = columnWidth + 'px';
                trHead.appendChild(th);
                if (k.addColorCol) {
                    const thColor = document.createElement('th');
                    thColor.textContent = '结果';
                    thColor.style.fontSize = fontSize + 'px';
                    thColor.style.minWidth = (columnWidth * 0.6) + 'px';
                    trHead.appendChild(thColor);
                }
            });
        });
        thead.appendChild(trHead);
        table.appendChild(thead);

        const tbody = document.createElement('tbody');
        const bgColors = ['#e6f3e6', '#fff9e6', '#f0ede6', '#f0e6f0', '#e6f0f0', '#f0e6e6'];

        let maxRows = 0;
        fileResults.forEach(res => {
            const rows = (hasAlign && res.alignedRows) ? res.alignedRows : res.data.columnData.rows;
            if (rows && rows.length > maxRows) maxRows = rows.length;
        });

        for (let rowIdx = 0; rowIdx < maxRows; rowIdx++) {
            const tr = document.createElement('tr');
            const tdRowLabel = document.createElement('td');
            if (hasAlign && alignValues && alignValues.length > 0 && alignValues[rowIdx] !== undefined) {
                tdRowLabel.textContent = alignValues[rowIdx];
            } else {
                tdRowLabel.textContent = rowIdx + 1;
            }
            tdRowLabel.style.fontWeight = 'bold';
            tdRowLabel.style.backgroundColor = '#f1f5f9';
            tdRowLabel.style.minWidth = '60px';
            tr.appendChild(tdRowLabel);

            fileResults.forEach((res, fi) => {
                const rows = (hasAlign && res.alignedRows) ? res.alignedRows : res.data.columnData.rows;
                const kw = res.data.columnData.keywords || [];
                const row = (rows && rows[rowIdx]) ? rows[rowIdx] : [];

                row.forEach((cell, idx) => {
                    const k = kw[idx] || {};
                    const fontSize = k.fontSize || defaultFontSize;
                    const columnWidth = k.columnWidth || defaultColumnWidth;
                    const td = document.createElement('td');
                    td.textContent = cell && cell.value !== null && cell.value !== undefined ? cell.value : '';
                    td.style.fontSize = fontSize + 'px';
                    td.style.minWidth = columnWidth + 'px';
                    if (!cell || cell.value === null || cell.value === undefined || cell.value === '') td.className = 'empty-value';
                    if (k.collectColor && cell && cell.color_name && cell.color_name !== 'blank') {
                        td.style.backgroundColor = getColorCss(cell.color_name);
                    }
                    tr.appendChild(td);

                    if (k.addColorCol) {
                        const tdColor = document.createElement('td');
                        const meaning = (cell && cell.color_meaning) || 'blank';
                        tdColor.textContent = meaning;
                        tdColor.style.fontSize = fontSize + 'px';
                        tdColor.style.minWidth = (columnWidth * 0.6) + 'px';
                        const colorName = (cell && cell.color_name) || 'blank';
                        const colorClass = 'color-' + (colorName === 'blank' ? 'blank' : colorName.toLowerCase());
                        tdColor.className = colorClass;
                        tr.appendChild(tdColor);
                    }
                });
            });
            tbody.appendChild(tr);
        }
        table.appendChild(tbody);
        return table;
    }

    // ----- Tab切换 -----
    function switchTab(tabId) {
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        document.querySelector(`.tab[data-tab="${tabId}"]`).classList.add('active');
        document.getElementById(tabId).classList.add('active');
    }

    // ----- 导出 Excel -----
    async function exportIndependentExcel() {
        if (!statisticsResults) return alert('请先执行统计');
        const wb = new ExcelJS.Workbook();
        statisticsResults.results.forEach((res, fi) => {
            const displayName = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            const ws = wb.addWorksheet(displayName.substring(0, 31));
            let rowIdx = 1;
            if (res.data.hasCell) {
                ws.addRow(['单元格采集项']);
                const headers = ['关键字', '值'];
                const hasColor = res.data.cellData.some(d => d.color_indexed !== null);
                if (hasColor) headers.push('结果');
                const headerRow = ws.addRow(headers);
                headerRow.font = { bold: true };
                res.data.cellData.forEach(d => {
                    const row = [];
                    let label = d.keyword.keywordText || '';
                    if (d.keyword.valuePosition === 'left') label += ' ←' + d.keyword.offset;
                    else if (d.keyword.valuePosition === 'right') label += ' →' + d.keyword.offset;
                    row.push(label);
                    row.push(d.value !== null && d.value !== undefined ? d.value : '');
                    if (hasColor) {
                        const meaning = d.color_meaning || 'blank';
                        row.push(meaning);
                    }
                    const rowObj = ws.addRow(row);
                    rowObj.height = 20;
                    if (d.color_name && d.color_name !== 'blank') {
                        const cell = rowObj.getCell(2);
                        const argb = getColorArgb(d.color_name);
                        if (argb) cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: argb } };
                    }
                });
                rowIdx = ws.rowCount + 2;
            }
            if (res.data.hasColumn) {
                if (rowIdx > 1) ws.addRow([]);
                ws.addRow(['列采集项']);
                const colData = res.data.columnData;
                const headers = [];
                const colorColIndices = [];
                const colWidths = [];
                colData.keywords.forEach((kw, idx) => {
                    let label = kw.keywordText || '';
                    if (kw.valuePosition === 'left') label += ' ←' + kw.offset;
                    else if (kw.valuePosition === 'right') label += ' →' + kw.offset;
                    headers.push(label);
                    colWidths.push(kw.columnWidth || 120);
                    if (kw.addColorCol) {
                        headers.push('结果');
                        colorColIndices.push(idx * 2 + 1);
                        colWidths.push((kw.columnWidth || 120) * 0.6);
                    }
                });
                const headerRow = ws.addRow(headers);
                headerRow.font = { bold: true };
                colWidths.forEach((w, idx) => {
                    ws.getColumn(idx + 1).width = w / 7;
                });

                const rowsToExport = res.alignedRows || colData.rows || [];
                rowsToExport.forEach(row => {
                    const values = [];
                    row.forEach((cell, idx) => {
                        values.push(cell.value !== null && cell.value !== undefined ? cell.value : '');
                        if (colData.keywords[idx].addColorCol) {
                            const meaning = cell.color_meaning || 'blank';
                            values.push(meaning);
                        }
                    });
                    const rowObj = ws.addRow(values);
                    rowObj.height = 20;
                    row.forEach((cell, idx) => {
                        const kw = colData.keywords[idx];
                        if (kw.collectColor && cell.color_name && cell.color_name !== 'blank') {
                            const cellExcel = rowObj.getCell(idx + 1);
                            const argb = getColorArgb(cell.color_name);
                            if (argb) cellExcel.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: argb } };
                        }
                    });
                    colorColIndices.forEach(colIndex => {
                        const cell = rowObj.getCell(colIndex + 1);
                        const colorName = values[colIndex];
                        const argb = getColorArgb(colorName);
                        if (argb) {
                            cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: argb } };
                        }
                    });
                });
            }
            ws.columns.forEach(col => col.width = Math.max(col.width || 15, 15));
        });
        const buf = await wb.xlsx.writeBuffer();
        saveAs(new Blob([buf], { type: 'application/octet-stream' }), '独立统计结果.xlsx');
        log('独立统计 Excel 导出成功', 'success');
    }

    async function exportMergedExcel() {
        if (!statisticsResults) return alert('请先执行统计');
        if (statisticsResults.results.length < 2) return alert('需要至少两个文件才能导出合并结果');
        const wb = new ExcelJS.Workbook();
        const ws = wb.addWorksheet('合并统计');

        const fileResults = statisticsResults.results;
        const scheme = statisticsResults.scheme;
        const alignKeyIdx = scheme.alignBaseKey;
        // 修复：完整空值判断
        const hasAlign = alignKeyIdx !== null && alignKeyIdx !== undefined && alignKeyIdx !== '';

        let processedResults = fileResults;
        let alignValues = [];
        if (hasAlign) {
            const aligned = alignColumnData(fileResults, alignKeyIdx);
            processedResults = aligned;
            if (aligned.length > 0 && aligned[0].alignValues) {
                alignValues = aligned[0].alignValues;
            }
        }

        const validFiles = processedResults.filter(r => r.data.hasColumn);
        if (validFiles.length < 2) {
            alert('至少需要两个有列数据的文件才能导出合并结果');
            return;
        }

        ws.addRow(['列采集项合并' + (hasAlign ? ' (已对齐)' : '')]);

        const headers = ['行号/对齐值'];
        const colorColIndices = [];
        const colWidths = [60];

        validFiles.forEach((res, fi) => {
            const kw = res.data.columnData.keywords || [];
            const displayName = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            kw.forEach((k, idx) => {
                let label = k.keywordText || '';
                if (k.valuePosition === 'left') label += ' ←' + k.offset;
                else if (k.valuePosition === 'right') label += ' →' + k.offset;
                headers.push(`${displayName}\n${label}`);
                colWidths.push(k.columnWidth || 120);
                if (k.addColorCol) {
                    headers.push('结果');
                    colorColIndices.push(headers.length - 1);
                    colWidths.push((k.columnWidth || 120) * 0.6);
                }
            });
        });

        const headerRow = ws.addRow(headers);
        headerRow.font = { bold: true };
        colWidths.forEach((w, idx) => {
            ws.getColumn(idx + 1).width = w / 7;
        });

        let maxRows = 0;
        validFiles.forEach(res => {
            const rows = (hasAlign && res.alignedRows) ? res.alignedRows : res.data.columnData.rows;
            if (rows && rows.length > maxRows) maxRows = rows.length;
        });

        const bgColors = ['e6f3e6', 'fff9e6', 'f0ede6', 'f0e6f0', 'e6f0f0', 'f0e6e6'];

        for (let rowIdx = 0; rowIdx < maxRows; rowIdx++) {
            const values = [];
            if (hasAlign && alignValues && alignValues.length > 0 && alignValues[rowIdx] !== undefined) {
                values.push(alignValues[rowIdx]);
            } else {
                values.push(rowIdx + 1);
            }

            validFiles.forEach((res, fi) => {
                const rows = (hasAlign && res.alignedRows) ? res.alignedRows : res.data.columnData.rows;
                const kw = res.data.columnData.keywords || [];
                const row = (rows && rows[rowIdx]) ? rows[rowIdx] : [];

                row.forEach((cell, idx) => {
                    values.push(cell && cell.value !== null && cell.value !== undefined ? cell.value : '');
                    if (kw[idx] && kw[idx].addColorCol) {
                        const meaning = (cell && cell.color_meaning) || 'blank';
                        values.push(meaning);
                    }
                });
            });

            const rowObj = ws.addRow(values);
            rowObj.height = 20;

            let colOffset = 1;
            validFiles.forEach((res, fi) => {
                const kw = res.data.columnData.keywords || [];
                const fileColor = 'FF' + bgColors[fi % bgColors.length];
                kw.forEach((k, idx) => {
                    const cell = rowObj.getCell(colOffset + 1);
                    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: fileColor } };
                    colOffset++;
                    if (k.addColorCol) {
                        const cellColor = rowObj.getCell(colOffset + 1);
                        cellColor.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: fileColor } };
                        colOffset++;
                    }
                });
            });

            let valOffset = 1;
            validFiles.forEach((res, fi) => {
                const kw = res.data.columnData.keywords || [];
                const rows = (hasAlign && res.alignedRows) ? res.alignedRows : res.data.columnData.rows;
                const row = (rows && rows[rowIdx]) ? rows[rowIdx] : [];

                row.forEach((cell, idx) => {
                    valOffset++;
                    if (kw[idx] && kw[idx].collectColor && cell && cell.color_name && cell.color_name !== 'blank') {
                        const cellExcel = rowObj.getCell(valOffset);
                        const argb = getColorArgb(cell.color_name);
                        if (argb) cellExcel.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: argb } };
                    }
                    if (kw[idx] && kw[idx].addColorCol) {
                        valOffset++;
                    }
                });
            });
        }

        ws.columns.forEach(col => col.width = Math.max(col.width || 15, 15));
        const buf = await wb.xlsx.writeBuffer();
        saveAs(new Blob([buf], { type: 'application/octet-stream' }), '合并统计结果.xlsx');
        log('合并统计 Excel 导出成功', 'success');
    }

