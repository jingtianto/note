async function exportMergedExcel() {
    try {
        if (typeof ExcelJS === 'undefined') {
            alert('ExcelJS 库未加载，请刷新页面重试');
            return;
        }
        if (typeof saveAs !== 'function') {
            alert('FileSaver 库未加载，将使用备用下载方式');
        }

        if (!statisticsResults) {
            alert('请先执行统计');
            return;
        }
        const results = statisticsResults.results;
        if (results.length < 2) {
            alert('需要至少两个文件才能导出合并结果');
            return;
        }

        const scheme = statisticsResults.scheme;
        const alignKeyIdx = scheme.alignBaseKey;
        const hasAlign = alignKeyIdx !== null && alignKeyIdx !== undefined && alignKeyIdx !== '';
        const priorityOrder = scheme.priorityOrder || ['green', 'blue', 'yellow', 'orange', 'red', 'blank'];

        const workbook = new ExcelJS.Workbook();
        const sheet = workbook.addWorksheet('合并对比');
        // 强制限制大纲仅显示2级分组按钮，杜绝出现3级
        sheet.properties.outlineLevelRow = 2;

        // ---------- 1. 标题（不参与分组，始终显示） ----------
        const titleRow = sheet.addRow(['合并统计报告']);
        titleRow.font = { bold: true, size: 16 };
        titleRow.alignment = { vertical: 'middle', horizontal: 'center' };

        // ---------- 2. 单元格采集项（全程无任何outline层级，不干扰分组） ----------
        const hasAnyCell = results.some(r => r.data && r.data.hasCell);
        if (hasAnyCell) {
            const headers = ['来源文件', '关键字', '值'];
            let hasColor = results.some(r => (r.data.cellData || []).some(d => d.color_indexed !== null));
            if (hasColor) headers.push('结果');
            const headerRow = sheet.addRow(headers);
            headerRow.font = { bold: true, size: 12 };
            headerRow.alignment = { vertical: 'middle', horizontal: 'center' };
            headerRow.eachCell(cell => {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD3D3D3' } };
            });

            const bgColors = ['FFE6F3E6', 'FFFFF9E6', 'FFF0EDE6', 'FFF0E6F0', 'FFE6F0F0', 'FFF0E6E6'];
            results.forEach((res, fi) => {
                const cellData = res.data.cellData || [];
                const displayName = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
                cellData.forEach(d => {
                    let label = d.keyword.keywordText || '';
                    if (d.keyword.valuePosition === 'left') label += ' ←' + d.keyword.offset;
                    else if (d.keyword.valuePosition === 'right') label += ' →' + d.keyword.offset;
                    const rowValues = [displayName, label, (d.value !== null && d.value !== undefined ? d.value : '')];
                    if (hasColor) rowValues.push(d.color_meaning || '');
                    const row = sheet.addRow(rowValues);
                    row.eachCell(cell => {
                        cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgColors[fi % bgColors.length] } };
                    });
                    const valCell = row.getCell(3);
                    if (d.color_name && d.color_name !== 'blank') {
                        const hex = getColorCss(d.color_name);
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                    } else {
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                    }
                    const fontSize = d.keyword.fontSize || 14;
                    const isBold = d.keyword.bold || false;
                    row.eachCell(cell => { cell.font = { size: fontSize, bold: isBold }; });
                });
            });
        }

        // ---------- 3. 列采集项（严格仅1级摘要 / 2级明细两级分组） ----------
        const hasAnyColumn = results.some(r => r.data && r.data.hasColumn);
        if (!hasAnyColumn) {
            const buffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            if (typeof saveAs === 'function') saveAs(blob, '合并统计.xlsx');
            else {
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = '合并统计.xlsx';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                setTimeout(() => URL.revokeObjectURL(link.href), 10000);
            }
            log('合并统计导出成功（无列数据）', 'success');
            return;
        }

        // 取第一个有列数据的文件作为模板（强制对齐）
        let firstKw = null;
        for (let res of results) {
            if (res.data && res.data.columnData && res.data.columnData.keywords && res.data.columnData.keywords.length > 0) {
                firstKw = res.data.columnData.keywords;
                break;
            }
        }
        if (!firstKw) {
            const buffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            if (typeof saveAs === 'function') saveAs(blob, '合并统计.xlsx');
            else { /* 备用 */ }
            log('合并统计导出成功（无列数据）', 'success');
            return;
        }

        // 构建原始数据（按分组键归类）
        const allRows = [];
        results.forEach((res, fi) => {
            const rows = res.data.columnData.rows || [];
            const filename = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            rows.forEach(row => {
                let alignValue = null;
                if (hasAlign) {
                    const idx = parseInt(alignKeyIdx);
                    if (!isNaN(idx) && row.length > idx) {
                        alignValue = row[idx].value;
                    }
                }
                allRows.push({ filename, row, alignValue, fileIndex: fi });
            });
        });

        const groups = {};
        allRows.forEach(item => {
            let key = hasAlign ? (item.alignValue !== null && item.alignValue !== undefined ? String(item.alignValue) : '') : '';
            if (!key) key = '__no_align__';
            if (!groups[key]) groups[key] = [];
            groups[key].push(item);
        });

        const groupKeys = Object.keys(groups).sort((a, b) => {
            if (a === '__no_align__') return 1;
            if (b === '__no_align__') return -1;
            const aNum = parseFloat(a);
            const bNum = parseFloat(b);
            if (!isNaN(aNum) && !isNaN(bNum)) return aNum - bNum;
            return a.localeCompare(b);
        });

        // 列采集表头
        const colHeaders = ['分组键', '文件名'];
        firstKw.forEach((kw) => {
            let label = kw.keywordText || '';
            if (kw.valuePosition === 'left') label += ' ←' + kw.offset;
            else if (kw.valuePosition === 'right') label += ' →' + kw.offset;
            colHeaders.push(label);
            if (kw.addColorCol) colHeaders.push('结果');
        });
        const headerRow = sheet.addRow(colHeaders);
        headerRow.font = { bold: true, size: 12 };
        headerRow.alignment = { vertical: 'middle', horizontal: 'center' };
        headerRow.eachCell(cell => {
            cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD3D3D3' } };
        });

        // 文件背景色映射
        const bgColors = ['FFE6F3E6', 'FFFFF9E6', 'FFF0EDE6', 'FFF0E6F0', 'FFE6F0F0', 'FFF0E6E6'];
        const fileBgMap = {};
        results.forEach((res, fi) => {
            const filename = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            fileBgMap[filename] = bgColors[fi % bgColors.length];
        });

        // ---------- 遍历分组，仅设置1、2两级大纲 ----------
        groupKeys.forEach(key => {
            const items = groups[key];
            const isExpanded = groupStates[key] !== undefined ? groupStates[key] : true;

            // 计算最佳行（作为摘要行）
            let bestItem = null;
            let bestPriority = 999;
            items.forEach(item => {
                let rowPriority = 999;
                firstKw.forEach((kw, idx) => {
                    if (kw.collectColor && item.row.length > idx) {
                        const color = item.row[idx].color_name || 'blank';
                        const p = getPriority(color, priorityOrder);
                        if (p < rowPriority) rowPriority = p;
                    }
                });
                if (rowPriority < bestPriority) {
                    bestPriority = rowPriority;
                    bestItem = item;
                }
            });
            if (!bestItem) return;

            const displayKey = (key === '__no_align__') ? '(未对齐)' : key;

            // 1. 摘要行【固定层级1】
            const summaryValues = [displayKey, bestItem.filename];
            firstKw.forEach((kw, idx) => {
                const cell = (bestItem.row.length > idx) ? bestItem.row[idx] : null;
                const val = cell ? (cell.value !== null && cell.value !== undefined ? cell.value : '') : '';
                summaryValues.push(val);
                if (kw.addColorCol) {
                    const meaning = cell ? (cell.color_meaning || '') : '';
                    summaryValues.push(meaning);
                }
            });
            const summaryRow = sheet.addRow(summaryValues);
            const bg = fileBgMap[bestItem.filename] || 'FFFFFFFF';
            summaryRow.eachCell(cell => {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bg } };
                cell.font = { bold: true };
            });
            // 值列颜色
            let colPos = 3;
            firstKw.forEach((kw, idx) => {
                const cell = (bestItem.row.length > idx) ? bestItem.row[idx] : null;
                const valCell = summaryRow.getCell(colPos);
                if (kw.collectColor && cell && cell.color_name && cell.color_name !== 'blank') {
                    const hex = getColorCss(cell.color_name);
                    valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                } else {
                    valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                }
                colPos++;
                if (kw.addColorCol) {
                    const colorCell = summaryRow.getCell(colPos);
                    const meaning = cell ? (cell.color_meaning || 'blank') : 'blank';
                    let bgHex = '#FFFFFF';
                    if (meaning === 'failed') bgHex = '#FFCCCC';
                    else if (meaning === 'passed') bgHex = '#CCFFCC';
                    else if (meaning === 'warning') bgHex = '#FFFFCC';
                    else if (meaning === 'signal missing') bgHex = '#CCE5FF';
                    else if (meaning === 'trigger not occurred') bgHex = '#FFD9B3';
                    colorCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgHex.replace('#', 'FF') } };
                    colPos++;
                }
            });
            // 一级大纲
            summaryRow.outlineLevel = 1;
            summaryRow.collapsed = !isExpanded;

            // 2. 详细行【固定层级2，仅两级】
            items.forEach(item => {
                if (item === bestItem) return;
                const detailValues = ['', item.filename];
                firstKw.forEach((kw, idx) => {
                    const cell = (item.row.length > idx) ? item.row[idx] : null;
                    const val = cell ? (cell.value !== null && cell.value !== undefined ? cell.value : '') : '';
                    detailValues.push(val);
                    if (kw.addColorCol) {
                        const meaning = cell ? (cell.color_meaning || '') : '';
                        detailValues.push(meaning);
                    }
                });
                const detailRow = sheet.addRow(detailValues);
                const bgDetail = fileBgMap[item.filename] || 'FFFFFFFF';
                detailRow.eachCell(cell => {
                    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgDetail } };
                });
                // 值列颜色
                let colPosDetail = 3;
                firstKw.forEach((kw, idx) => {
                    const cell = (item.row.length > idx) ? item.row[idx] : null;
                    const valCell = detailRow.getCell(colPosDetail);
                    if (kw.collectColor && cell && cell.color_name && cell.color_name !== 'blank') {
                        const hex = getColorCss(cell.color_name);
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                    } else {
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                    }
                    colPosDetail++;
                    if (kw.addColorCol) {
                        const colorCell = detailRow.getCell(colPosDetail);
                        const meaning = cell ? (cell.color_meaning || 'blank') : 'blank';
                        let bgHex = '#FFFFFF';
                        if (meaning === 'failed') bgHex = '#FFCCCC';
                        else if (meaning === 'passed') bgHex = '#CCFFCC';
                        else if (meaning === 'warning') bgHex = '#FFFFCC';
                        else if (meaning === 'signal missing') bgHex = '#CCE5FF';
                        else if (meaning === 'trigger not occurred') bgHex = '#FFD9B3';
                        colorCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgHex.replace('#', 'FF') } };
                        colPosDetail++;
                    }
                });
                // 二级大纲，无更高层级
                detailRow.outlineLevel = 2;
            });
        });

        // 生成并下载
        const buffer = await workbook.xlsx.writeBuffer();
        const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });

        if (typeof saveAs === 'function') {
            saveAs(blob, '合并统计.xlsx');
        } else {
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = '合并统计.xlsx';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            setTimeout(() => URL.revokeObjectURL(link.href), 10000);
        }
        log('合并统计导出成功（1级摘要，2级详细）', 'success');
    } catch (e) {
        log('合并导出失败: ' + e.message, 'error');
        alert('导出失败，请查看日志（按Ctrl+Shift+I）\n' + e.message);
        console.error(e);
    }
}










async function exportMergedExcel() {
    try {
        if (typeof ExcelJS === 'undefined') {
            alert('ExcelJS 库未加载，请刷新页面重试');
            return;
        }
        if (typeof saveAs !== 'function') {
            alert('FileSaver 库未加载，将使用备用下载方式');
        }

        if (!statisticsResults) {
            alert('请先执行统计');
            return;
        }
        const results = statisticsResults.results;
        if (results.length < 2) {
            alert('需要至少两个文件才能导出合并结果');
            return;
        }

        const scheme = statisticsResults.scheme;
        const alignKeyIdx = scheme.alignBaseKey;
        const hasAlign = alignKeyIdx !== null && alignKeyIdx !== undefined && alignKeyIdx !== '';
        const priorityOrder = scheme.priorityOrder || ['green', 'blue', 'yellow', 'orange', 'red', 'blank'];

        const workbook = new ExcelJS.Workbook();
        const sheet = workbook.addWorksheet('合并对比');

        // ---------- 1. 标题（不参与分组，始终显示） ----------
        const titleRow = sheet.addRow(['合并统计报告']);
        titleRow.font = { bold: true, size: 16 };
        titleRow.alignment = { vertical: 'middle', horizontal: 'center' };
        // 不设置 outlineLevel

        // ---------- 2. 单元格采集项（不参与分组，始终显示） ----------
        const hasAnyCell = results.some(r => r.data && r.data.hasCell);
        if (hasAnyCell) {
            const headers = ['来源文件', '关键字', '值'];
            let hasColor = results.some(r => (r.data.cellData || []).some(d => d.color_indexed !== null));
            if (hasColor) headers.push('结果');
            const headerRow = sheet.addRow(headers);
            headerRow.font = { bold: true, size: 12 };
            headerRow.alignment = { vertical: 'middle', horizontal: 'center' };
            headerRow.eachCell(cell => {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD3D3D3' } };
            });
            // 不设置 outlineLevel

            const bgColors = ['FFE6F3E6', 'FFFFF9E6', 'FFF0EDE6', 'FFF0E6F0', 'FFE6F0F0', 'FFF0E6E6'];
            results.forEach((res, fi) => {
                const cellData = res.data.cellData || [];
                const displayName = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
                cellData.forEach(d => {
                    let label = d.keyword.keywordText || '';
                    if (d.keyword.valuePosition === 'left') label += ' ←' + d.keyword.offset;
                    else if (d.keyword.valuePosition === 'right') label += ' →' + d.keyword.offset;
                    const rowValues = [displayName, label, (d.value !== null && d.value !== undefined ? d.value : '')];
                    if (hasColor) rowValues.push(d.color_meaning || '');
                    const row = sheet.addRow(rowValues);
                    row.eachCell(cell => {
                        cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgColors[fi % bgColors.length] } };
                    });
                    const valCell = row.getCell(3);
                    if (d.color_name && d.color_name !== 'blank') {
                        const hex = getColorCss(d.color_name);
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                    } else {
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                    }
                    const fontSize = d.keyword.fontSize || 14;
                    const isBold = d.keyword.bold || false;
                    row.eachCell(cell => { cell.font = { size: fontSize, bold: isBold }; });
                    // 不设置 outlineLevel
                });
            });
        }

        // ---------- 3. 列采集项（只有此处使用层级：1级摘要，2级详细） ----------
        const hasAnyColumn = results.some(r => r.data && r.data.hasColumn);
        if (!hasAnyColumn) {
            const buffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            if (typeof saveAs === 'function') saveAs(blob, '合并统计.xlsx');
            else {
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = '合并统计.xlsx';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                setTimeout(() => URL.revokeObjectURL(link.href), 10000);
            }
            log('合并统计导出成功（无列数据）', 'success');
            return;
        }

        // 取第一个有列数据的文件作为模板（强制对齐）
        let firstKw = null;
        for (let res of results) {
            if (res.data && res.data.columnData && res.data.columnData.keywords && res.data.columnData.keywords.length > 0) {
                firstKw = res.data.columnData.keywords;
                break;
            }
        }
        if (!firstKw) {
            const buffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            if (typeof saveAs === 'function') saveAs(blob, '合并统计.xlsx');
            else { /* 备用 */ }
            log('合并统计导出成功（无列数据）', 'success');
            return;
        }

        // 构建原始数据（按分组键归类）
        const allRows = [];
        results.forEach((res, fi) => {
            const rows = res.data.columnData.rows || [];
            const filename = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            rows.forEach(row => {
                let alignValue = null;
                if (hasAlign) {
                    const idx = parseInt(alignKeyIdx);
                    if (!isNaN(idx) && row.length > idx) {
                        alignValue = row[idx].value;
                    }
                }
                allRows.push({ filename, row, alignValue, fileIndex: fi });
            });
        });

        const groups = {};
        allRows.forEach(item => {
            let key = hasAlign ? (item.alignValue !== null && item.alignValue !== undefined ? String(item.alignValue) : '') : '';
            if (!key) key = '__no_align__';
            if (!groups[key]) groups[key] = [];
            groups[key].push(item);
        });

        const groupKeys = Object.keys(groups).sort((a, b) => {
            if (a === '__no_align__') return 1;
            if (b === '__no_align__') return -1;
            const aNum = parseFloat(a);
            const bNum = parseFloat(b);
            if (!isNaN(aNum) && !isNaN(bNum)) return aNum - bNum;
            return a.localeCompare(b);
        });

        // 列采集表头（不参与分组，始终显示）
        const colHeaders = ['分组键', '文件名'];
        firstKw.forEach((kw) => {
            let label = kw.keywordText || '';
            if (kw.valuePosition === 'left') label += ' ←' + kw.offset;
            else if (kw.valuePosition === 'right') label += ' →' + kw.offset;
            colHeaders.push(label);
            if (kw.addColorCol) colHeaders.push('结果');
        });
        const headerRow = sheet.addRow(colHeaders);
        headerRow.font = { bold: true, size: 12 };
        headerRow.alignment = { vertical: 'middle', horizontal: 'center' };
        headerRow.eachCell(cell => {
            cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD3D3D3' } };
        });
        // 不设置 outlineLevel

        // 文件背景色映射
        const bgColors = ['FFE6F3E6', 'FFFFF9E6', 'FFF0EDE6', 'FFF0E6F0', 'FFE6F0F0', 'FFF0E6E6'];
        const fileBgMap = {};
        results.forEach((res, fi) => {
            const filename = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            fileBgMap[filename] = bgColors[fi % bgColors.length];
        });

        // ---------- 遍历分组，写入数据并设置层级 ----------
        groupKeys.forEach(key => {
            const items = groups[key];
            // 前端折叠状态（只影响打开Excel时的默认展开/收起）
            const isExpanded = groupStates[key] !== undefined ? groupStates[key] : true;

            // 计算最佳行（作为摘要行）
            let bestItem = null;
            let bestPriority = 999;
            items.forEach(item => {
                let rowPriority = 999;
                firstKw.forEach((kw, idx) => {
                    if (kw.collectColor && item.row.length > idx) {
                        const color = item.row[idx].color_name || 'blank';
                        const p = getPriority(color, priorityOrder);
                        if (p < rowPriority) rowPriority = p;
                    }
                });
                if (rowPriority < bestPriority) {
                    bestPriority = rowPriority;
                    bestItem = item;
                }
            });
            if (!bestItem) return;

            const displayKey = (key === '__no_align__') ? '(未对齐)' : key;

            // 1. 摘要行（1级，作为父级）
            const summaryValues = [displayKey, bestItem.filename];
            firstKw.forEach((kw, idx) => {
                const cell = (bestItem.row.length > idx) ? bestItem.row[idx] : null;
                const val = cell ? (cell.value !== null && cell.value !== undefined ? cell.value : '') : '';
                summaryValues.push(val);
                if (kw.addColorCol) {
                    const meaning = cell ? (cell.color_meaning || '') : '';
                    summaryValues.push(meaning);
                }
            });
            const summaryRow = sheet.addRow(summaryValues);
            const bg = fileBgMap[bestItem.filename] || 'FFFFFFFF';
            summaryRow.eachCell(cell => {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bg } };
                cell.font = { bold: true };
            });
            // 值列颜色
            let colPos = 3;
            firstKw.forEach((kw, idx) => {
                const cell = (bestItem.row.length > idx) ? bestItem.row[idx] : null;
                const valCell = summaryRow.getCell(colPos);
                if (kw.collectColor && cell && cell.color_name && cell.color_name !== 'blank') {
                    const hex = getColorCss(cell.color_name);
                    valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                } else {
                    valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                }
                colPos++;
                if (kw.addColorCol) {
                    const colorCell = summaryRow.getCell(colPos);
                    const meaning = cell ? (cell.color_meaning || 'blank') : 'blank';
                    let bgHex = '#FFFFFF';
                    if (meaning === 'failed') bgHex = '#FFCCCC';
                    else if (meaning === 'passed') bgHex = '#CCFFCC';
                    else if (meaning === 'warning') bgHex = '#FFFFCC';
                    else if (meaning === 'signal missing') bgHex = '#CCE5FF';
                    else if (meaning === 'trigger not occurred') bgHex = '#FFD9B3';
                    colorCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgHex.replace('#', 'FF') } };
                    colPos++;
                }
            });
            // 设置为1级，并控制默认展开/折叠
            summaryRow.outlineLevel = 1;
            // 如果前端该分组是展开状态，则 collapsed=false，否则 true
            summaryRow.collapsed = !isExpanded;

            // 2. 详细行（2级，子级）
            items.forEach(item => {
                if (item === bestItem) return;
                const detailValues = ['', item.filename];
                firstKw.forEach((kw, idx) => {
                    const cell = (item.row.length > idx) ? item.row[idx] : null;
                    const val = cell ? (cell.value !== null && cell.value !== undefined ? cell.value : '') : '';
                    detailValues.push(val);
                    if (kw.addColorCol) {
                        const meaning = cell ? (cell.color_meaning || '') : '';
                        detailValues.push(meaning);
                    }
                });
                const detailRow = sheet.addRow(detailValues);
                const bgDetail = fileBgMap[item.filename] || 'FFFFFFFF';
                detailRow.eachCell(cell => {
                    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgDetail } };
                });
                // 值列颜色
                let colPosDetail = 3;
                firstKw.forEach((kw, idx) => {
                    const cell = (item.row.length > idx) ? item.row[idx] : null;
                    const valCell = detailRow.getCell(colPosDetail);
                    if (kw.collectColor && cell && cell.color_name && cell.color_name !== 'blank') {
                        const hex = getColorCss(cell.color_name);
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                    } else {
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                    }
                    colPosDetail++;
                    if (kw.addColorCol) {
                        const colorCell = detailRow.getCell(colPosDetail);
                        const meaning = cell ? (cell.color_meaning || 'blank') : 'blank';
                        let bgHex = '#FFFFFF';
                        if (meaning === 'failed') bgHex = '#FFCCCC';
                        else if (meaning === 'passed') bgHex = '#CCFFCC';
                        else if (meaning === 'warning') bgHex = '#FFFFCC';
                        else if (meaning === 'signal missing') bgHex = '#CCE5FF';
                        else if (meaning === 'trigger not occurred') bgHex = '#FFD9B3';
                        colorCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgHex.replace('#', 'FF') } };
                        colPosDetail++;
                    }
                });
                // 设置为2级，不设置 collapsed，由父级（摘要行）的 collapsed 控制
                detailRow.outlineLevel = 2;
            });
        });

        // 生成并下载
        const buffer = await workbook.xlsx.writeBuffer();
        const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });

        if (typeof saveAs === 'function') {
            saveAs(blob, '合并统计.xlsx');
        } else {
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = '合并统计.xlsx';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            setTimeout(() => URL.revokeObjectURL(link.href), 10000);
        }
        log('合并统计导出成功（1级摘要，2级详细）', 'success');
    } catch (e) {
        log('合并导出失败: ' + e.message, 'error');
        alert('导出失败，请查看日志（按Ctrl+Shift+I）\n' + e.message);
        console.error(e);
    }
}





async function exportMergedExcel() {
    try {
        if (typeof ExcelJS === 'undefined') {
            alert('ExcelJS 库未加载，请刷新页面重试');
            return;
        }
        if (typeof saveAs !== 'function') {
            alert('FileSaver 库未加载，将使用备用下载方式');
        }

        if (!statisticsResults) {
            alert('请先执行统计');
            return;
        }
        const results = statisticsResults.results;
        if (results.length < 2) {
            alert('需要至少两个文件才能导出合并结果');
            return;
        }

        const scheme = statisticsResults.scheme;
        const alignKeyIdx = scheme.alignBaseKey;
        const hasAlign = alignKeyIdx !== null && alignKeyIdx !== undefined && alignKeyIdx !== '';
        const priorityOrder = scheme.priorityOrder || ['green', 'blue', 'yellow', 'orange', 'red', 'blank'];

        const workbook = new ExcelJS.Workbook();
        const sheet = workbook.addWorksheet('合并对比');

        // ---------- 辅助：添加行并设为1级（始终可见） ----------
        function addLevel1Row(values, opts = {}) {
            const row = sheet.addRow(values);
            if (opts.font) row.font = opts.font;
            if (opts.alignment) row.alignment = opts.alignment;
            if (opts.fill) row.eachCell(c => c.fill = opts.fill);
            if (opts.eachCell) row.eachCell(opts.eachCell);
            row.outlineLevel = 1;
            row.collapsed = false;
            return row;
        }

        // ---------- 1. 标题行（1级，始终可见） ----------
        addLevel1Row(['合并统计报告'], {
            font: { bold: true, size: 16 },
            alignment: { vertical: 'middle', horizontal: 'center' }
        });

        // ---------- 2. 单元格采集项（1级） ----------
        const hasAnyCell = results.some(r => r.data && r.data.hasCell);
        if (hasAnyCell) {
            const headers = ['来源文件', '关键字', '值'];
            let hasColor = results.some(r => (r.data.cellData || []).some(d => d.color_indexed !== null));
            if (hasColor) headers.push('结果');
            addLevel1Row(headers, {
                font: { bold: true, size: 12 },
                alignment: { vertical: 'middle', horizontal: 'center' },
                fill: { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD3D3D3' } }
            });

            const bgColors = ['FFE6F3E6', 'FFFFF9E6', 'FFF0EDE6', 'FFF0E6F0', 'FFE6F0F0', 'FFF0E6E6'];
            results.forEach((res, fi) => {
                const cellData = res.data.cellData || [];
                const displayName = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
                cellData.forEach(d => {
                    let label = d.keyword.keywordText || '';
                    if (d.keyword.valuePosition === 'left') label += ' ←' + d.keyword.offset;
                    else if (d.keyword.valuePosition === 'right') label += ' →' + d.keyword.offset;
                    const rowValues = [displayName, label, (d.value !== null && d.value !== undefined ? d.value : '')];
                    if (hasColor) rowValues.push(d.color_meaning || '');
                    const row = addLevel1Row(rowValues);
                    row.eachCell(cell => cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgColors[fi % bgColors.length] } });
                    const valCell = row.getCell(3);
                    if (d.color_name && d.color_name !== 'blank') {
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: getColorCss(d.color_name).replace('#', 'FF') } };
                    } else {
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                    }
                    const fontSize = d.keyword.fontSize || 14;
                    const isBold = d.keyword.bold || false;
                    row.eachCell(cell => cell.font = { size: fontSize, bold: isBold });
                });
            });
        }

        // ---------- 3. 列采集项分组 ----------
        const hasAnyColumn = results.some(r => r.data && r.data.hasColumn);
        if (!hasAnyColumn) {
            // 无列数据，直接导出
            const buffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            if (typeof saveAs === 'function') saveAs(blob, '合并统计.xlsx');
            else {
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = '合并统计.xlsx';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                setTimeout(() => URL.revokeObjectURL(link.href), 10000);
            }
            log('合并统计导出成功（无列数据）', 'success');
            return;
        }

        // 取第一个有列数据的文件作为模板
        let firstKw = null;
        for (let res of results) {
            if (res.data && res.data.columnData && res.data.columnData.keywords && res.data.columnData.keywords.length > 0) {
                firstKw = res.data.columnData.keywords;
                break;
            }
        }
        if (!firstKw) {
            const buffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            if (typeof saveAs === 'function') saveAs(blob, '合并统计.xlsx');
            else { /* 备用 */ }
            log('合并统计导出成功（无列数据）', 'success');
            return;
        }

        // 构建原始数据
        const allRows = [];
        results.forEach((res, fi) => {
            const rows = res.data.columnData.rows || [];
            const filename = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            rows.forEach(row => {
                let alignValue = null;
                if (hasAlign) {
                    const idx = parseInt(alignKeyIdx);
                    if (!isNaN(idx) && row.length > idx) {
                        alignValue = row[idx].value;
                    }
                }
                allRows.push({ filename, row, alignValue, fileIndex: fi });
            });
        });

        const groups = {};
        allRows.forEach(item => {
            let key = hasAlign ? (item.alignValue !== null && item.alignValue !== undefined ? String(item.alignValue) : '') : '';
            if (!key) key = '__no_align__';
            if (!groups[key]) groups[key] = [];
            groups[key].push(item);
        });

        const groupKeys = Object.keys(groups).sort((a, b) => {
            if (a === '__no_align__') return 1;
            if (b === '__no_align__') return -1;
            const aNum = parseFloat(a);
            const bNum = parseFloat(b);
            if (!isNaN(aNum) && !isNaN(bNum)) return aNum - bNum;
            return a.localeCompare(b);
        });

        // 列采集表头（1级）
        const colHeaders = ['分组键', '文件名'];
        firstKw.forEach((kw) => {
            let label = kw.keywordText || '';
            if (kw.valuePosition === 'left') label += ' ←' + kw.offset;
            else if (kw.valuePosition === 'right') label += ' →' + kw.offset;
            colHeaders.push(label);
            if (kw.addColorCol) colHeaders.push('结果');
        });
        addLevel1Row(colHeaders, {
            font: { bold: true, size: 12 },
            alignment: { vertical: 'middle', horizontal: 'center' },
            fill: { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD3D3D3' } }
        });

        // 文件背景色映射
        const bgColors = ['FFE6F3E6', 'FFFFF9E6', 'FFF0EDE6', 'FFF0E6F0', 'FFE6F0F0', 'FFF0E6E6'];
        const fileBgMap = {};
        results.forEach((res, fi) => {
            const filename = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            fileBgMap[filename] = bgColors[fi % bgColors.length];
        });

        // ---------- 遍历分组 ----------
        groupKeys.forEach(key => {
            const items = groups[key];
            const isExpanded = groupStates[key] !== undefined ? groupStates[key] : true; // 前端折叠状态

            // 计算最佳行（摘要）
            let bestItem = null;
            let bestPriority = 999;
            items.forEach(item => {
                let rowPriority = 999;
                firstKw.forEach((kw, idx) => {
                    if (kw.collectColor && item.row.length > idx) {
                        const color = item.row[idx].color_name || 'blank';
                        const p = getPriority(color, priorityOrder);
                        if (p < rowPriority) rowPriority = p;
                    }
                });
                if (rowPriority < bestPriority) {
                    bestPriority = rowPriority;
                    bestItem = item;
                }
            });
            if (!bestItem) return;

            const displayKey = (key === '__no_align__') ? '(未对齐)' : key;

            // --- 摘要行（1级，始终可见） ---
            const summaryValues = [displayKey, bestItem.filename];
            firstKw.forEach((kw, idx) => {
                const cell = (bestItem.row.length > idx) ? bestItem.row[idx] : null;
                const val = cell ? (cell.value !== null && cell.value !== undefined ? cell.value : '') : '';
                summaryValues.push(val);
                if (kw.addColorCol) {
                    const meaning = cell ? (cell.color_meaning || '') : '';
                    summaryValues.push(meaning);
                }
            });
            const summaryRow = addLevel1Row(summaryValues);
            const bg = fileBgMap[bestItem.filename] || 'FFFFFFFF';
            summaryRow.eachCell(cell => {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bg } };
                cell.font = { bold: true };
            });
            // 值列颜色
            let colPos = 3;
            firstKw.forEach((kw, idx) => {
                const cell = (bestItem.row.length > idx) ? bestItem.row[idx] : null;
                const valCell = summaryRow.getCell(colPos);
                if (kw.collectColor && cell && cell.color_name && cell.color_name !== 'blank') {
                    valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: getColorCss(cell.color_name).replace('#', 'FF') } };
                } else {
                    valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                }
                colPos++;
                if (kw.addColorCol) {
                    const colorCell = summaryRow.getCell(colPos);
                    const meaning = cell ? (cell.color_meaning || 'blank') : 'blank';
                    let bgHex = '#FFFFFF';
                    if (meaning === 'failed') bgHex = '#FFCCCC';
                    else if (meaning === 'passed') bgHex = '#CCFFCC';
                    else if (meaning === 'warning') bgHex = '#FFFFCC';
                    else if (meaning === 'signal missing') bgHex = '#CCE5FF';
                    else if (meaning === 'trigger not occurred') bgHex = '#FFD9B3';
                    colorCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgHex.replace('#', 'FF') } };
                    colPos++;
                }
            });

            // --- 详细行（2级，可折叠） ---
            items.forEach(item => {
                if (item === bestItem) return;
                const detailValues = ['', item.filename];
                firstKw.forEach((kw, idx) => {
                    const cell = (item.row.length > idx) ? item.row[idx] : null;
                    const val = cell ? (cell.value !== null && cell.value !== undefined ? cell.value : '') : '';
                    detailValues.push(val);
                    if (kw.addColorCol) {
                        const meaning = cell ? (cell.color_meaning || '') : '';
                        detailValues.push(meaning);
                    }
                });
                const detailRow = sheet.addRow(detailValues);
                const bgDetail = fileBgMap[item.filename] || 'FFFFFFFF';
                detailRow.eachCell(cell => cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgDetail } });
                // 值列颜色
                let colPosDetail = 3;
                firstKw.forEach((kw, idx) => {
                    const cell = (item.row.length > idx) ? item.row[idx] : null;
                    const valCell = detailRow.getCell(colPosDetail);
                    if (kw.collectColor && cell && cell.color_name && cell.color_name !== 'blank') {
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: getColorCss(cell.color_name).replace('#', 'FF') } };
                    } else {
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                    }
                    colPosDetail++;
                    if (kw.addColorCol) {
                        const colorCell = detailRow.getCell(colPosDetail);
                        const meaning = cell ? (cell.color_meaning || 'blank') : 'blank';
                        let bgHex = '#FFFFFF';
                        if (meaning === 'failed') bgHex = '#FFCCCC';
                        else if (meaning === 'passed') bgHex = '#CCFFCC';
                        else if (meaning === 'warning') bgHex = '#FFFFCC';
                        else if (meaning === 'signal missing') bgHex = '#CCE5FF';
                        else if (meaning === 'trigger not occurred') bgHex = '#FFD9B3';
                        colorCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgHex.replace('#', 'FF') } };
                        colPosDetail++;
                    }
                });
                // 设置层级为2
                detailRow.outlineLevel = 2;
                // 不设置 collapsed，由父级（摘要行）的折叠状态控制
            });
        });

        // 生成并下载
        const buffer = await workbook.xlsx.writeBuffer();
        const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });

        if (typeof saveAs === 'function') {
            saveAs(blob, '合并统计.xlsx');
        } else {
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = '合并统计.xlsx';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            setTimeout(() => URL.revokeObjectURL(link.href), 10000);
        }
        log('合并统计导出成功（正确分级）', 'success');
    } catch (e) {
        log('合并导出失败: ' + e.message, 'error');
        alert('导出失败，请查看日志（按Ctrl+Shift+I）\n' + e.message);
        console.error(e);
    }
}









async function exportMergedExcel() {
    try {
        if (typeof ExcelJS === 'undefined') {
            alert('ExcelJS 库未加载，请刷新页面重试');
            return;
        }
        if (typeof saveAs !== 'function') {
            alert('FileSaver 库未加载，将使用备用下载方式');
        }

        if (!statisticsResults) {
            alert('请先执行统计');
            return;
        }
        const results = statisticsResults.results;
        if (results.length < 2) {
            alert('需要至少两个文件才能导出合并结果');
            return;
        }

        const scheme = statisticsResults.scheme;
        const alignKeyIdx = scheme.alignBaseKey;
        const hasAlign = alignKeyIdx !== null && alignKeyIdx !== undefined && alignKeyIdx !== '';
        const priorityOrder = scheme.priorityOrder || ['green', 'blue', 'yellow', 'orange', 'red', 'blank'];

        const workbook = new ExcelJS.Workbook();
        const sheet = workbook.addWorksheet('合并对比');

        // ---------- 1. 标题（0级，始终可见） ----------
        const titleRow = sheet.addRow(['合并统计报告']);
        titleRow.font = { bold: true, size: 16 };
        titleRow.alignment = { vertical: 'middle', horizontal: 'center' };
        // 不设置 outlineLevel

        // ---------- 2. 单元格采集项（0级，始终可见） ----------
        const hasAnyCell = results.some(r => r.data && r.data.hasCell);
        if (hasAnyCell) {
            const headers = ['来源文件', '关键字', '值'];
            let hasColor = results.some(r => (r.data.cellData || []).some(d => d.color_indexed !== null));
            if (hasColor) headers.push('结果');
            const headerRow = sheet.addRow(headers);
            headerRow.font = { bold: true, size: 12 };
            headerRow.alignment = { vertical: 'middle', horizontal: 'center' };
            headerRow.eachCell(cell => {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD3D3D3' } };
            });
            // 不设置 outlineLevel

            const bgColors = ['FFE6F3E6', 'FFFFF9E6', 'FFF0EDE6', 'FFF0E6F0', 'FFE6F0F0', 'FFF0E6E6'];
            results.forEach((res, fi) => {
                const cellData = res.data.cellData || [];
                const displayName = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
                cellData.forEach(d => {
                    let label = d.keyword.keywordText || '';
                    if (d.keyword.valuePosition === 'left') label += ' ←' + d.keyword.offset;
                    else if (d.keyword.valuePosition === 'right') label += ' →' + d.keyword.offset;
                    const rowValues = [displayName, label, (d.value !== null && d.value !== undefined ? d.value : '')];
                    if (hasColor) rowValues.push(d.color_meaning || '');
                    const row = sheet.addRow(rowValues);
                    row.eachCell(cell => {
                        cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgColors[fi % bgColors.length] } };
                    });
                    const valCell = row.getCell(3);
                    if (d.color_name && d.color_name !== 'blank') {
                        const hex = getColorCss(d.color_name);
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                    } else {
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                    }
                    const fontSize = d.keyword.fontSize || 14;
                    const isBold = d.keyword.bold || false;
                    row.eachCell(cell => { cell.font = { size: fontSize, bold: isBold }; });
                    // 不设置 outlineLevel
                });
            });
        }

        // ---------- 3. 列采集项（仅此处使用分组层级） ----------
        const hasAnyColumn = results.some(r => r.data && r.data.hasColumn);
        if (!hasAnyColumn) {
            const buffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            if (typeof saveAs === 'function') saveAs(blob, '合并统计.xlsx');
            else {
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = '合并统计.xlsx';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                setTimeout(() => URL.revokeObjectURL(link.href), 10000);
            }
            log('合并统计导出成功（无列数据）', 'success');
            return;
        }

        // 取第一个有列数据的文件作为模板（强制对齐）
        let firstKw = null;
        for (let res of results) {
            if (res.data && res.data.columnData && res.data.columnData.keywords && res.data.columnData.keywords.length > 0) {
                firstKw = res.data.columnData.keywords;
                break;
            }
        }
        if (!firstKw) {
            const buffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            if (typeof saveAs === 'function') saveAs(blob, '合并统计.xlsx');
            else { /* 备用... */ }
            log('合并统计导出成功（无列数据）', 'success');
            return;
        }

        // 构建原始数据（按分组键归类）
        const allRows = [];
        results.forEach((res, fi) => {
            const rows = res.data.columnData.rows || [];
            const filename = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            rows.forEach(row => {
                let alignValue = null;
                if (hasAlign) {
                    const idx = parseInt(alignKeyIdx);
                    if (!isNaN(idx) && row.length > idx) {
                        alignValue = row[idx].value;
                    }
                }
                allRows.push({ filename, row, alignValue, fileIndex: fi });
            });
        });

        const groups = {};
        allRows.forEach(item => {
            let key = hasAlign ? (item.alignValue !== null && item.alignValue !== undefined ? String(item.alignValue) : '') : '';
            if (!key) key = '__no_align__';
            if (!groups[key]) groups[key] = [];
            groups[key].push(item);
        });

        const groupKeys = Object.keys(groups).sort((a, b) => {
            if (a === '__no_align__') return 1;
            if (b === '__no_align__') return -1;
            const aNum = parseFloat(a);
            const bNum = parseFloat(b);
            if (!isNaN(aNum) && !isNaN(bNum)) return aNum - bNum;
            return a.localeCompare(b);
        });

        // 列采集表头（0级，始终可见）
        const colHeaders = ['分组键', '文件名'];
        firstKw.forEach((kw) => {
            let label = kw.keywordText || '';
            if (kw.valuePosition === 'left') label += ' ←' + kw.offset;
            else if (kw.valuePosition === 'right') label += ' →' + kw.offset;
            colHeaders.push(label);
            if (kw.addColorCol) colHeaders.push('结果');
        });
        const headerRow = sheet.addRow(colHeaders);
        headerRow.font = { bold: true, size: 12 };
        headerRow.alignment = { vertical: 'middle', horizontal: 'center' };
        headerRow.eachCell(cell => {
            cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD3D3D3' } };
        });
        // 不设置 outlineLevel

        // 文件背景色映射
        const bgColors = ['FFE6F3E6', 'FFFFF9E6', 'FFF0EDE6', 'FFF0E6F0', 'FFE6F0F0', 'FFF0E6E6'];
        const fileBgMap = {};
        results.forEach((res, fi) => {
            const filename = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            fileBgMap[filename] = bgColors[fi % bgColors.length];
        });

        // ---------- 遍历分组，写入数据并设置层级 ----------
        groupKeys.forEach(key => {
            const items = groups[key];
            const isExpanded = groupStates[key] !== undefined ? groupStates[key] : true; // 前端折叠状态

            // 计算最佳行（用于摘要）
            let bestItem = null;
            let bestPriority = 999;
            items.forEach(item => {
                let rowPriority = 999;
                firstKw.forEach((kw, idx) => {
                    if (kw.collectColor && item.row.length > idx) {
                        const color = item.row[idx].color_name || 'blank';
                        const p = getPriority(color, priorityOrder);
                        if (p < rowPriority) rowPriority = p;
                    }
                });
                if (rowPriority < bestPriority) {
                    bestPriority = rowPriority;
                    bestItem = item;
                }
            });
            if (!bestItem) return;

            const displayKey = (key === '__no_align__') ? '(未对齐)' : key;

            // --- 摘要行（1级，不折叠） ---
            const summaryValues = [displayKey, bestItem.filename];
            firstKw.forEach((kw, idx) => {
                const cell = (bestItem.row.length > idx) ? bestItem.row[idx] : null;
                const val = cell ? (cell.value !== null && cell.value !== undefined ? cell.value : '') : '';
                summaryValues.push(val);
                if (kw.addColorCol) {
                    const meaning = cell ? (cell.color_meaning || '') : '';
                    summaryValues.push(meaning);
                }
            });
            const summaryRow = sheet.addRow(summaryValues);
            const bg = fileBgMap[bestItem.filename] || 'FFFFFFFF';
            summaryRow.eachCell(cell => {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bg } };
                cell.font = { bold: true };
            });
            // 值列颜色
            let colPos = 3;
            firstKw.forEach((kw, idx) => {
                const cell = (bestItem.row.length > idx) ? bestItem.row[idx] : null;
                const valCell = summaryRow.getCell(colPos);
                if (kw.collectColor && cell && cell.color_name && cell.color_name !== 'blank') {
                    const hex = getColorCss(cell.color_name);
                    valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                } else {
                    valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                }
                colPos++;
                if (kw.addColorCol) {
                    const colorCell = summaryRow.getCell(colPos);
                    const meaning = cell ? (cell.color_meaning || 'blank') : 'blank';
                    let bgHex = '#FFFFFF';
                    if (meaning === 'failed') bgHex = '#FFCCCC';
                    else if (meaning === 'passed') bgHex = '#CCFFCC';
                    else if (meaning === 'warning') bgHex = '#FFFFCC';
                    else if (meaning === 'signal missing') bgHex = '#CCE5FF';
                    else if (meaning === 'trigger not occurred') bgHex = '#FFD9B3';
                    colorCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgHex.replace('#', 'FF') } };
                    colPos++;
                }
            });
            // 设置层级
            summaryRow.outlineLevel = 1;
            // 摘要行不折叠（始终可见）
            summaryRow.collapsed = false;

            // --- 详细行（2级，由摘要行控制折叠） ---
            items.forEach(item => {
                if (item === bestItem) return;
                const detailValues = ['', item.filename];
                firstKw.forEach((kw, idx) => {
                    const cell = (item.row.length > idx) ? item.row[idx] : null;
                    const val = cell ? (cell.value !== null && cell.value !== undefined ? cell.value : '') : '';
                    detailValues.push(val);
                    if (kw.addColorCol) {
                        const meaning = cell ? (cell.color_meaning || '') : '';
                        detailValues.push(meaning);
                    }
                });
                const detailRow = sheet.addRow(detailValues);
                const bgDetail = fileBgMap[item.filename] || 'FFFFFFFF';
                detailRow.eachCell(cell => {
                    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgDetail } };
                });
                // 值列颜色
                let colPosDetail = 3;
                firstKw.forEach((kw, idx) => {
                    const cell = (item.row.length > idx) ? item.row[idx] : null;
                    const valCell = detailRow.getCell(colPosDetail);
                    if (kw.collectColor && cell && cell.color_name && cell.color_name !== 'blank') {
                        const hex = getColorCss(cell.color_name);
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                    } else {
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                    }
                    colPosDetail++;
                    if (kw.addColorCol) {
                        const colorCell = detailRow.getCell(colPosDetail);
                        const meaning = cell ? (cell.color_meaning || 'blank') : 'blank';
                        let bgHex = '#FFFFFF';
                        if (meaning === 'failed') bgHex = '#FFCCCC';
                        else if (meaning === 'passed') bgHex = '#CCFFCC';
                        else if (meaning === 'warning') bgHex = '#FFFFCC';
                        else if (meaning === 'signal missing') bgHex = '#CCE5FF';
                        else if (meaning === 'trigger not occurred') bgHex = '#FFD9B3';
                        colorCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgHex.replace('#', 'FF') } };
                        colPosDetail++;
                    }
                });
                // 设置层级
                detailRow.outlineLevel = 2;
                // 不设置 collapsed，由父级（摘要行）控制
            });
        });

        // 生成并下载
        const buffer = await workbook.xlsx.writeBuffer();
        const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });

        if (typeof saveAs === 'function') {
            saveAs(blob, '合并统计.xlsx');
        } else {
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = '合并统计.xlsx';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            setTimeout(() => URL.revokeObjectURL(link.href), 10000);
        }
        log('合并统计导出成功（仅列采集分组）', 'success');
    } catch (e) {
        log('合并导出失败: ' + e.message, 'error');
        alert('导出失败，请查看日志（按Ctrl+Shift+I）\n' + e.message);
        console.error(e);
    }
}











async function exportMergedExcel() {
    try {
        if (typeof ExcelJS === 'undefined') {
            alert('ExcelJS 库未加载，请刷新页面重试');
            return;
        }
        if (typeof saveAs !== 'function') {
            alert('FileSaver 库未加载，将使用备用下载方式');
        }

        if (!statisticsResults) {
            alert('请先执行统计');
            return;
        }
        const results = statisticsResults.results;
        if (results.length < 2) {
            alert('需要至少两个文件才能导出合并结果');
            return;
        }

        const scheme = statisticsResults.scheme;
        const alignKeyIdx = scheme.alignBaseKey;
        const hasAlign = alignKeyIdx !== null && alignKeyIdx !== undefined && alignKeyIdx !== '';
        const priorityOrder = scheme.priorityOrder || ['green', 'blue', 'yellow', 'orange', 'red', 'blank'];

        const workbook = new ExcelJS.Workbook();
        const sheet = workbook.addWorksheet('合并对比');

        // ---------- 标题（不参与分组） ----------
        const titleRow = sheet.addRow(['合并统计报告']);
        titleRow.font = { bold: true, size: 16 };
        titleRow.alignment = { vertical: 'middle', horizontal: 'center' };
        // 不设置 outlineLevel

        // ---------- 单元格采集项（不参与分组） ----------
        const hasAnyCell = results.some(r => r.data && r.data.hasCell);
        if (hasAnyCell) {
            const headers = ['来源文件', '关键字', '值'];
            let hasColor = results.some(r => (r.data.cellData || []).some(d => d.color_indexed !== null));
            if (hasColor) headers.push('结果');
            const headerRow = sheet.addRow(headers);
            headerRow.font = { bold: true, size: 12 };
            headerRow.alignment = { vertical: 'middle', horizontal: 'center' };
            headerRow.eachCell(cell => {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD3D3D3' } };
            });
            // 不设置 outlineLevel

            const bgColors = ['FFE6F3E6', 'FFFFF9E6', 'FFF0EDE6', 'FFF0E6F0', 'FFE6F0F0', 'FFF0E6E6'];
            results.forEach((res, fi) => {
                const cellData = res.data.cellData || [];
                const displayName = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
                cellData.forEach(d => {
                    let label = d.keyword.keywordText || '';
                    if (d.keyword.valuePosition === 'left') label += ' ←' + d.keyword.offset;
                    else if (d.keyword.valuePosition === 'right') label += ' →' + d.keyword.offset;
                    const rowValues = [displayName, label, (d.value !== null && d.value !== undefined ? d.value : '')];
                    if (hasColor) rowValues.push(d.color_meaning || '');
                    const row = sheet.addRow(rowValues);
                    row.eachCell(cell => {
                        cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgColors[fi % bgColors.length] } };
                    });
                    const valCell = row.getCell(3);
                    if (d.color_name && d.color_name !== 'blank') {
                        const hex = getColorCss(d.color_name);
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                    } else {
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                    }
                    const fontSize = d.keyword.fontSize || 14;
                    const isBold = d.keyword.bold || false;
                    row.eachCell(cell => { cell.font = { size: fontSize, bold: isBold }; });
                    // 不设置 outlineLevel
                });
            });
            // 单元格部分结束后，不加空行
        }

        // ---------- 列采集项（仅此处使用分组） ----------
        const hasAnyColumn = results.some(r => r.data && r.data.hasColumn);
        if (!hasAnyColumn) {
            const buffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            if (typeof saveAs === 'function') saveAs(blob, '合并统计.xlsx');
            else {
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = '合并统计.xlsx';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                setTimeout(() => URL.revokeObjectURL(link.href), 10000);
            }
            log('合并统计导出成功（无列数据）', 'success');
            return;
        }

        // 取第一个有列数据的文件作为模板
        let firstKw = null;
        for (let res of results) {
            if (res.data && res.data.columnData && res.data.columnData.keywords && res.data.columnData.keywords.length > 0) {
                firstKw = res.data.columnData.keywords;
                break;
            }
        }
        if (!firstKw) {
            const buffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            if (typeof saveAs === 'function') saveAs(blob, '合并统计.xlsx');
            else { /* 备用... */ }
            log('合并统计导出成功（无列数据）', 'success');
            return;
        }

        // 构建原始数据
        const allRows = [];
        results.forEach((res, fi) => {
            const rows = res.data.columnData.rows || [];
            const filename = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            rows.forEach(row => {
                let alignValue = null;
                if (hasAlign) {
                    const idx = parseInt(alignKeyIdx);
                    if (!isNaN(idx) && row.length > idx) {
                        alignValue = row[idx].value;
                    }
                }
                allRows.push({ filename, row, alignValue, fileIndex: fi });
            });
        });

        const groups = {};
        allRows.forEach(item => {
            let key = hasAlign ? (item.alignValue !== null && item.alignValue !== undefined ? String(item.alignValue) : '') : '';
            if (!key) key = '__no_align__';
            if (!groups[key]) groups[key] = [];
            groups[key].push(item);
        });

        const groupKeys = Object.keys(groups).sort((a, b) => {
            if (a === '__no_align__') return 1;
            if (b === '__no_align__') return -1;
            const aNum = parseFloat(a);
            const bNum = parseFloat(b);
            if (!isNaN(aNum) && !isNaN(bNum)) return aNum - bNum;
            return a.localeCompare(b);
        });

        // 列采集表头（不参与分组）
        const colHeaders = ['分组键', '文件名'];
        firstKw.forEach((kw) => {
            let label = kw.keywordText || '';
            if (kw.valuePosition === 'left') label += ' ←' + kw.offset;
            else if (kw.valuePosition === 'right') label += ' →' + kw.offset;
            colHeaders.push(label);
            if (kw.addColorCol) colHeaders.push('结果');
        });
        const headerRow = sheet.addRow(colHeaders);
        headerRow.font = { bold: true, size: 12 };
        headerRow.alignment = { vertical: 'middle', horizontal: 'center' };
        headerRow.eachCell(cell => {
            cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD3D3D3' } };
        });
        // 不设置 outlineLevel

        // 文件背景色映射
        const bgColors = ['FFE6F3E6', 'FFFFF9E6', 'FFF0EDE6', 'FFF0E6F0', 'FFE6F0F0', 'FFF0E6E6'];
        const fileBgMap = {};
        results.forEach((res, fi) => {
            const filename = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            fileBgMap[filename] = bgColors[fi % bgColors.length];
        });

        // 遍历分组
        groupKeys.forEach(key => {
            const items = groups[key];
            const isExpanded = groupStates[key] !== undefined ? groupStates[key] : true;

            // 计算最佳行
            let bestItem = null;
            let bestPriority = 999;
            items.forEach(item => {
                let rowPriority = 999;
                firstKw.forEach((kw, idx) => {
                    if (kw.collectColor && item.row.length > idx) {
                        const color = item.row[idx].color_name || 'blank';
                        const p = getPriority(color, priorityOrder);
                        if (p < rowPriority) rowPriority = p;
                    }
                });
                if (rowPriority < bestPriority) {
                    bestPriority = rowPriority;
                    bestItem = item;
                }
            });
            if (!bestItem) return;

            const displayKey = (key === '__no_align__') ? '(未对齐)' : key;

            // 摘要行（1级）
            const summaryValues = [displayKey, bestItem.filename];
            firstKw.forEach((kw, idx) => {
                const cell = (bestItem.row.length > idx) ? bestItem.row[idx] : null;
                const val = cell ? (cell.value !== null && cell.value !== undefined ? cell.value : '') : '';
                summaryValues.push(val);
                if (kw.addColorCol) {
                    const meaning = cell ? (cell.color_meaning || '') : '';
                    summaryValues.push(meaning);
                }
            });
            const summaryRow = sheet.addRow(summaryValues);
            const bg = fileBgMap[bestItem.filename] || 'FFFFFFFF';
            summaryRow.eachCell(cell => {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bg } };
                cell.font = { bold: true };
            });
            let colPos = 3;
            firstKw.forEach((kw, idx) => {
                const cell = (bestItem.row.length > idx) ? bestItem.row[idx] : null;
                const valCell = summaryRow.getCell(colPos);
                if (kw.collectColor && cell && cell.color_name && cell.color_name !== 'blank') {
                    const hex = getColorCss(cell.color_name);
                    valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                } else {
                    valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                }
                colPos++;
                if (kw.addColorCol) {
                    const colorCell = summaryRow.getCell(colPos);
                    const meaning = cell ? (cell.color_meaning || 'blank') : 'blank';
                    let bgHex = '#FFFFFF';
                    if (meaning === 'failed') bgHex = '#FFCCCC';
                    else if (meaning === 'passed') bgHex = '#CCFFCC';
                    else if (meaning === 'warning') bgHex = '#FFFFCC';
                    else if (meaning === 'signal missing') bgHex = '#CCE5FF';
                    else if (meaning === 'trigger not occurred') bgHex = '#FFD9B3';
                    colorCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgHex.replace('#', 'FF') } };
                    colPos++;
                }
            });
            // 设置摘要行层级 1，并根据前端折叠状态设置 collapsed
            summaryRow.outlineLevel = 1;
            summaryRow.collapsed = !isExpanded;

            // 详细行（2级）
            items.forEach(item => {
                if (item === bestItem) return;
                const detailValues = ['', item.filename];
                firstKw.forEach((kw, idx) => {
                    const cell = (item.row.length > idx) ? item.row[idx] : null;
                    const val = cell ? (cell.value !== null && cell.value !== undefined ? cell.value : '') : '';
                    detailValues.push(val);
                    if (kw.addColorCol) {
                        const meaning = cell ? (cell.color_meaning || '') : '';
                        detailValues.push(meaning);
                    }
                });
                const detailRow = sheet.addRow(detailValues);
                const bgDetail = fileBgMap[item.filename] || 'FFFFFFFF';
                detailRow.eachCell(cell => {
                    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgDetail } };
                });
                let colPosDetail = 3;
                firstKw.forEach((kw, idx) => {
                    const cell = (item.row.length > idx) ? item.row[idx] : null;
                    const valCell = detailRow.getCell(colPosDetail);
                    if (kw.collectColor && cell && cell.color_name && cell.color_name !== 'blank') {
                        const hex = getColorCss(cell.color_name);
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                    } else {
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                    }
                    colPosDetail++;
                    if (kw.addColorCol) {
                        const colorCell = detailRow.getCell(colPosDetail);
                        const meaning = cell ? (cell.color_meaning || 'blank') : 'blank';
                        let bgHex = '#FFFFFF';
                        if (meaning === 'failed') bgHex = '#FFCCCC';
                        else if (meaning === 'passed') bgHex = '#CCFFCC';
                        else if (meaning === 'warning') bgHex = '#FFFFCC';
                        else if (meaning === 'signal missing') bgHex = '#CCE5FF';
                        else if (meaning === 'trigger not occurred') bgHex = '#FFD9B3';
                        colorCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgHex.replace('#', 'FF') } };
                        colPosDetail++;
                    }
                });
                // 设置详细行层级 2
                detailRow.outlineLevel = 2;
                // 不需要设置 collapsed
            });
        });

        // 生成并下载
        const buffer = await workbook.xlsx.writeBuffer();
        const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });

        if (typeof saveAs === 'function') {
            saveAs(blob, '合并统计.xlsx');
        } else {
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = '合并统计.xlsx';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            setTimeout(() => URL.revokeObjectURL(link.href), 10000);
        }
        log('合并统计导出成功（仅列采集分组）', 'success');
    } catch (e) {
        log('合并导出失败: ' + e.message, 'error');
        alert('导出失败，请查看日志（按Ctrl+Shift+I）\n' + e.message);
        console.error(e);
    }
}













async function exportMergedExcel() {
    try {
        if (typeof ExcelJS === 'undefined') {
            alert('ExcelJS 库未加载，请刷新页面重试');
            return;
        }
        if (typeof saveAs !== 'function') {
            alert('FileSaver 库未加载，将使用备用下载方式');
        }

        if (!statisticsResults) {
            alert('请先执行统计');
            return;
        }
        const results = statisticsResults.results;
        if (results.length < 2) {
            alert('需要至少两个文件才能导出合并结果');
            return;
        }

        const scheme = statisticsResults.scheme;
        const alignKeyIdx = scheme.alignBaseKey;
        const hasAlign = alignKeyIdx !== null && alignKeyIdx !== undefined && alignKeyIdx !== '';
        const priorityOrder = scheme.priorityOrder || ['green', 'blue', 'yellow', 'orange', 'red', 'blank'];

        const workbook = new ExcelJS.Workbook();
        const sheet = workbook.addWorksheet('合并对比');

        // ==================== 添加 0 级标题行（始终可见） ====================
        const titleRow = sheet.addRow(['合并统计报告']);
        titleRow.font = { bold: true, size: 16 };
        titleRow.alignment = { vertical: 'middle', horizontal: 'center' };
        // 合并 A 到最后一列（根据列数动态设置）
        const colCount = 2 + results[0].data.columnData.keywords.reduce((sum, kw) => sum + (kw.addColorCol ? 2 : 1), 0);
        sheet.mergeCells(`A1:${String.fromCharCode(64 + colCount)}1`);
        titleRow.outlineLevel = 0;
        titleRow.collapsed = false;

        // ==================== 1. 单元格采集项（平铺，设为 1 级） ====================
        const hasAnyCell = results.some(r => r.data && r.data.hasCell);
        if (hasAnyCell) {
            const headers = ['来源文件', '关键字', '值'];
            let hasColor = results.some(r => (r.data.cellData || []).some(d => d.color_indexed !== null));
            if (hasColor) headers.push('结果');
            const headerRow = sheet.addRow(headers);
            headerRow.font = { bold: true, size: 12 };
            headerRow.alignment = { vertical: 'middle', horizontal: 'center' };
            headerRow.eachCell(cell => {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD3D3D3' } };
            });
            headerRow.outlineLevel = 1;
            headerRow.collapsed = false;

            const bgColors = ['FFE6F3E6', 'FFFFF9E6', 'FFF0EDE6', 'FFF0E6F0', 'FFE6F0F0', 'FFF0E6E6'];
            results.forEach((res, fi) => {
                const cellData = res.data.cellData || [];
                const displayName = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
                cellData.forEach(d => {
                    let label = d.keyword.keywordText || '';
                    if (d.keyword.valuePosition === 'left') label += ' ←' + d.keyword.offset;
                    else if (d.keyword.valuePosition === 'right') label += ' →' + d.keyword.offset;
                    const rowValues = [displayName, label, (d.value !== null && d.value !== undefined ? d.value : '')];
                    if (hasColor) rowValues.push(d.color_meaning || '');
                    const row = sheet.addRow(rowValues);
                    row.eachCell(cell => {
                        cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgColors[fi % bgColors.length] } };
                    });
                    const valCell = row.getCell(3);
                    if (d.color_name && d.color_name !== 'blank') {
                        const hex = getColorCss(d.color_name);
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                    } else {
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                    }
                    const fontSize = d.keyword.fontSize || 14;
                    const isBold = d.keyword.bold || false;
                    row.eachCell(cell => { cell.font = { size: fontSize, bold: isBold }; });
                    row.outlineLevel = 1;
                    row.collapsed = false;
                });
            });
        }

        // ==================== 2. 列采集项（分组，摘要 1 级，详细 2 级） ====================
        const hasAnyColumn = results.some(r => r.data && r.data.hasColumn);
        if (!hasAnyColumn) {
            const buffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            if (typeof saveAs === 'function') saveAs(blob, '合并统计.xlsx');
            else {
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = '合并统计.xlsx';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                setTimeout(() => URL.revokeObjectURL(link.href), 10000);
            }
            log('合并统计导出成功（无列数据）', 'success');
            return;
        }

        // 取第一个有列数据的文件作为模板（强制对齐）
        let firstKw = null;
        for (let res of results) {
            if (res.data && res.data.columnData && res.data.columnData.keywords && res.data.columnData.keywords.length > 0) {
                firstKw = res.data.columnData.keywords;
                break;
            }
        }
        if (!firstKw) {
            const buffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            if (typeof saveAs === 'function') saveAs(blob, '合并统计.xlsx');
            else { /* 备用... */ }
            log('合并统计导出成功（无列数据）', 'success');
            return;
        }

        // 构建原始数据（按分组键归类）
        const allRows = [];
        results.forEach((res, fi) => {
            const rows = res.data.columnData.rows || [];
            const filename = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            rows.forEach(row => {
                let alignValue = null;
                if (hasAlign) {
                    const idx = parseInt(alignKeyIdx);
                    if (!isNaN(idx) && row.length > idx) {
                        alignValue = row[idx].value;
                    }
                }
                allRows.push({ filename, row, alignValue, fileIndex: fi });
            });
        });

        const groups = {};
        allRows.forEach(item => {
            let key = hasAlign ? (item.alignValue !== null && item.alignValue !== undefined ? String(item.alignValue) : '') : '';
            if (!key) key = '__no_align__';
            if (!groups[key]) groups[key] = [];
            groups[key].push(item);
        });

        const groupKeys = Object.keys(groups).sort((a, b) => {
            if (a === '__no_align__') return 1;
            if (b === '__no_align__') return -1;
            const aNum = parseFloat(a);
            const bNum = parseFloat(b);
            if (!isNaN(aNum) && !isNaN(bNum)) return aNum - bNum;
            return a.localeCompare(b);
        });

        // 列表头
        const colHeaders = ['分组键', '文件名'];
        firstKw.forEach((kw) => {
            let label = kw.keywordText || '';
            if (kw.valuePosition === 'left') label += ' ←' + kw.offset;
            else if (kw.valuePosition === 'right') label += ' →' + kw.offset;
            colHeaders.push(label);
            if (kw.addColorCol) colHeaders.push('结果');
        });
        const headerRow = sheet.addRow(colHeaders);
        headerRow.font = { bold: true, size: 12 };
        headerRow.alignment = { vertical: 'middle', horizontal: 'center' };
        headerRow.eachCell(cell => {
            cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD3D3D3' } };
        });
        headerRow.outlineLevel = 1;
        headerRow.collapsed = false;

        const bgColors = ['FFE6F3E6', 'FFFFF9E6', 'FFF0EDE6', 'FFF0E6F0', 'FFE6F0F0', 'FFF0E6E6'];
        const fileBgMap = {};
        results.forEach((res, fi) => {
            const filename = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            fileBgMap[filename] = bgColors[fi % bgColors.length];
        });

        groupKeys.forEach(key => {
            const items = groups[key];
            const isExpanded = groupStates[key] !== undefined ? groupStates[key] : true; // 默认展开

            // 计算最佳行
            let bestItem = null;
            let bestPriority = 999;
            items.forEach(item => {
                let rowPriority = 999;
                firstKw.forEach((kw, idx) => {
                    if (kw.collectColor && item.row.length > idx) {
                        const color = item.row[idx].color_name || 'blank';
                        const p = getPriority(color, priorityOrder);
                        if (p < rowPriority) rowPriority = p;
                    }
                });
                if (rowPriority < bestPriority) {
                    bestPriority = rowPriority;
                    bestItem = item;
                }
            });
            if (!bestItem) return;

            const displayKey = (key === '__no_align__') ? '(未对齐)' : key;

            // --- 摘要行（1 级） ---
            const summaryValues = [displayKey, bestItem.filename];
            firstKw.forEach((kw, idx) => {
                const cell = (bestItem.row.length > idx) ? bestItem.row[idx] : null;
                const val = cell ? (cell.value !== null && cell.value !== undefined ? cell.value : '') : '';
                summaryValues.push(val);
                if (kw.addColorCol) {
                    const meaning = cell ? (cell.color_meaning || '') : '';
                    summaryValues.push(meaning);
                }
            });
            const summaryRow = sheet.addRow(summaryValues);
            const bg = fileBgMap[bestItem.filename] || 'FFFFFFFF';
            summaryRow.eachCell(cell => {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bg } };
                cell.font = { bold: true };
            });
            let colPos = 3;
            firstKw.forEach((kw, idx) => {
                const cell = (bestItem.row.length > idx) ? bestItem.row[idx] : null;
                const valCell = summaryRow.getCell(colPos);
                if (kw.collectColor && cell && cell.color_name && cell.color_name !== 'blank') {
                    const hex = getColorCss(cell.color_name);
                    valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                } else {
                    valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                }
                colPos++;
                if (kw.addColorCol) {
                    const colorCell = summaryRow.getCell(colPos);
                    const meaning = cell ? (cell.color_meaning || 'blank') : 'blank';
                    let bgHex = '#FFFFFF';
                    if (meaning === 'failed') bgHex = '#FFCCCC';
                    else if (meaning === 'passed') bgHex = '#CCFFCC';
                    else if (meaning === 'warning') bgHex = '#FFFFCC';
                    else if (meaning === 'signal missing') bgHex = '#CCE5FF';
                    else if (meaning === 'trigger not occurred') bgHex = '#FFD9B3';
                    colorCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgHex.replace('#', 'FF') } };
                    colPos++;
                }
            });
            summaryRow.outlineLevel = 1;
            summaryRow.collapsed = !isExpanded;

            // --- 详细行（2 级） ---
            items.forEach(item => {
                if (item === bestItem) return;
                const detailValues = ['', item.filename];
                firstKw.forEach((kw, idx) => {
                    const cell = (item.row.length > idx) ? item.row[idx] : null;
                    const val = cell ? (cell.value !== null && cell.value !== undefined ? cell.value : '') : '';
                    detailValues.push(val);
                    if (kw.addColorCol) {
                        const meaning = cell ? (cell.color_meaning || '') : '';
                        detailValues.push(meaning);
                    }
                });
                const detailRow = sheet.addRow(detailValues);
                const bgDetail = fileBgMap[item.filename] || 'FFFFFFFF';
                detailRow.eachCell(cell => {
                    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgDetail } };
                });
                let colPosDetail = 3;
                firstKw.forEach((kw, idx) => {
                    const cell = (item.row.length > idx) ? item.row[idx] : null;
                    const valCell = detailRow.getCell(colPosDetail);
                    if (kw.collectColor && cell && cell.color_name && cell.color_name !== 'blank') {
                        const hex = getColorCss(cell.color_name);
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                    } else {
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                    }
                    colPosDetail++;
                    if (kw.addColorCol) {
                        const colorCell = detailRow.getCell(colPosDetail);
                        const meaning = cell ? (cell.color_meaning || 'blank') : 'blank';
                        let bgHex = '#FFFFFF';
                        if (meaning === 'failed') bgHex = '#FFCCCC';
                        else if (meaning === 'passed') bgHex = '#CCFFCC';
                        else if (meaning === 'warning') bgHex = '#FFFFCC';
                        else if (meaning === 'signal missing') bgHex = '#CCE5FF';
                        else if (meaning === 'trigger not occurred') bgHex = '#FFD9B3';
                        colorCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgHex.replace('#', 'FF') } };
                        colPosDetail++;
                    }
                });
                detailRow.outlineLevel = 2;
                // 详细行不需要单独设置 collapsed，由父级（摘要行）控制
            });
        });

        // 生成文件并下载
        const buffer = await workbook.xlsx.writeBuffer();
        const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });

        if (typeof saveAs === 'function') {
            saveAs(blob, '合并统计.xlsx');
        } else {
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = '合并统计.xlsx';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            setTimeout(() => URL.revokeObjectURL(link.href), 10000);
        }
        log('合并统计导出成功（含分组层级）', 'success');
    } catch (e) {
        log('合并导出失败: ' + e.message, 'error');
        alert('导出失败，请查看日志（按Ctrl+Shift+I）\n' + e.message);
        console.error(e);
    }
}










async function exportMergedExcel() {
    try {
        if (typeof ExcelJS === 'undefined') {
            alert('ExcelJS 库未加载，请刷新页面重试');
            return;
        }
        if (typeof saveAs !== 'function') {
            alert('FileSaver 库未加载，将使用备用下载方式');
        }

        if (!statisticsResults) {
            alert('请先执行统计');
            return;
        }
        const results = statisticsResults.results;
        if (results.length < 2) {
            alert('需要至少两个文件才能导出合并结果');
            return;
        }

        const scheme = statisticsResults.scheme;
        const alignKeyIdx = scheme.alignBaseKey;
        const hasAlign = alignKeyIdx !== null && alignKeyIdx !== undefined && alignKeyIdx !== '';
        const priorityOrder = scheme.priorityOrder || ['green', 'blue', 'yellow', 'orange', 'red', 'blank'];

        const workbook = new ExcelJS.Workbook();
        const sheet = workbook.addWorksheet('合并对比');

        // ---------- 1. 单元格采集项（平铺，但设为层级1，始终可见） ----------
        const hasAnyCell = results.some(r => r.data && r.data.hasCell);
        if (hasAnyCell) {
            const headers = ['来源文件', '关键字', '值'];
            let hasColor = results.some(r => (r.data.cellData || []).some(d => d.color_indexed !== null));
            if (hasColor) headers.push('结果');
            const headerRow = sheet.addRow(headers);
            headerRow.font = { bold: true, size: 12 };
            headerRow.alignment = { vertical: 'middle', horizontal: 'center' };
            headerRow.eachCell(cell => {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD3D3D3' } };
            });
            headerRow.outlineLevel = 1;
            headerRow.collapsed = false;

            const bgColors = ['FFE6F3E6', 'FFFFF9E6', 'FFF0EDE6', 'FFF0E6F0', 'FFE6F0F0', 'FFF0E6E6'];
            results.forEach((res, fi) => {
                const cellData = res.data.cellData || [];
                const displayName = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
                cellData.forEach(d => {
                    let label = d.keyword.keywordText || '';
                    if (d.keyword.valuePosition === 'left') label += ' ←' + d.keyword.offset;
                    else if (d.keyword.valuePosition === 'right') label += ' →' + d.keyword.offset;
                    const rowValues = [displayName, label, (d.value !== null && d.value !== undefined ? d.value : '')];
                    if (hasColor) rowValues.push(d.color_meaning || '');
                    const row = sheet.addRow(rowValues);
                    row.eachCell(cell => {
                        cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgColors[fi % bgColors.length] } };
                    });
                    const valCell = row.getCell(3);
                    if (d.color_name && d.color_name !== 'blank') {
                        const hex = getColorCss(d.color_name);
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                    } else {
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                    }
                    const fontSize = d.keyword.fontSize || 14;
                    const isBold = d.keyword.bold || false;
                    row.eachCell(cell => { cell.font = { size: fontSize, bold: isBold }; });
                    row.outlineLevel = 1;
                    row.collapsed = false;
                });
            });
        }

        // ---------- 2. 列采集项（使用 Excel 分组功能） ----------
        const hasAnyColumn = results.some(r => r.data && r.data.hasColumn);
        if (!hasAnyColumn) {
            const buffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            if (typeof saveAs === 'function') saveAs(blob, '合并统计.xlsx');
            else {
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = '合并统计.xlsx';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                setTimeout(() => URL.revokeObjectURL(link.href), 10000);
            }
            log('合并统计导出成功（无列数据）', 'success');
            return;
        }

        let firstKw = null;
        for (let res of results) {
            if (res.data && res.data.columnData && res.data.columnData.keywords && res.data.columnData.keywords.length > 0) {
                firstKw = res.data.columnData.keywords;
                break;
            }
        }
        if (!firstKw) {
            const buffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            if (typeof saveAs === 'function') saveAs(blob, '合并统计.xlsx');
            else { /* 备用下载... */ }
            log('合并统计导出成功（无列数据）', 'success');
            return;
        }

        // 构建原始数据
        const allRows = [];
        results.forEach((res, fi) => {
            const rows = res.data.columnData.rows || [];
            const filename = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            rows.forEach(row => {
                let alignValue = null;
                if (hasAlign) {
                    const idx = parseInt(alignKeyIdx);
                    if (!isNaN(idx) && row.length > idx) {
                        alignValue = row[idx].value;
                    }
                }
                allRows.push({ filename, row, alignValue, fileIndex: fi });
            });
        });

        const groups = {};
        allRows.forEach(item => {
            let key = hasAlign ? (item.alignValue !== null && item.alignValue !== undefined ? String(item.alignValue) : '') : '';
            if (!key) key = '__no_align__';
            if (!groups[key]) groups[key] = [];
            groups[key].push(item);
        });

        const groupKeys = Object.keys(groups).sort((a, b) => {
            if (a === '__no_align__') return 1;
            if (b === '__no_align__') return -1;
            const aNum = parseFloat(a);
            const bNum = parseFloat(b);
            if (!isNaN(aNum) && !isNaN(bNum)) return aNum - bNum;
            return a.localeCompare(b);
        });

        // 列表头
        const colHeaders = ['分组键', '文件名'];
        firstKw.forEach((kw) => {
            let label = kw.keywordText || '';
            if (kw.valuePosition === 'left') label += ' ←' + kw.offset;
            else if (kw.valuePosition === 'right') label += ' →' + kw.offset;
            colHeaders.push(label);
            if (kw.addColorCol) colHeaders.push('结果');
        });
        const headerRow = sheet.addRow(colHeaders);
        headerRow.font = { bold: true, size: 12 };
        headerRow.alignment = { vertical: 'middle', horizontal: 'center' };
        headerRow.eachCell(cell => {
            cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD3D3D3' } };
        });
        headerRow.outlineLevel = 1;
        headerRow.collapsed = false;

        const bgColors = ['FFE6F3E6', 'FFFFF9E6', 'FFF0EDE6', 'FFF0E6F0', 'FFE6F0F0', 'FFF0E6E6'];
        const fileBgMap = {};
        results.forEach((res, fi) => {
            const filename = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            fileBgMap[filename] = bgColors[fi % bgColors.length];
        });

        groupKeys.forEach(key => {
            const items = groups[key];
            const isExpanded = groupStates[key] !== undefined ? groupStates[key] : true;

            let bestItem = null;
            let bestPriority = 999;
            items.forEach(item => {
                let rowPriority = 999;
                firstKw.forEach((kw, idx) => {
                    if (kw.collectColor && item.row.length > idx) {
                        const color = item.row[idx].color_name || 'blank';
                        const p = getPriority(color, priorityOrder);
                        if (p < rowPriority) rowPriority = p;
                    }
                });
                if (rowPriority < bestPriority) {
                    bestPriority = rowPriority;
                    bestItem = item;
                }
            });
            if (!bestItem) return;

            const displayKey = (key === '__no_align__') ? '(未对齐)' : key;

            // 摘要行
            const summaryValues = [displayKey, bestItem.filename];
            firstKw.forEach((kw, idx) => {
                const cell = (bestItem.row.length > idx) ? bestItem.row[idx] : null;
                const val = cell ? (cell.value !== null && cell.value !== undefined ? cell.value : '') : '';
                summaryValues.push(val);
                if (kw.addColorCol) {
                    const meaning = cell ? (cell.color_meaning || '') : '';
                    summaryValues.push(meaning);
                }
            });
            const summaryRow = sheet.addRow(summaryValues);
            const bg = fileBgMap[bestItem.filename] || 'FFFFFFFF';
            summaryRow.eachCell(cell => {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bg } };
                cell.font = { bold: true };
            });
            let colPos = 3;
            firstKw.forEach((kw, idx) => {
                const cell = (bestItem.row.length > idx) ? bestItem.row[idx] : null;
                const valCell = summaryRow.getCell(colPos);
                if (kw.collectColor && cell && cell.color_name && cell.color_name !== 'blank') {
                    const hex = getColorCss(cell.color_name);
                    valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                } else {
                    valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                }
                colPos++;
                if (kw.addColorCol) {
                    const colorCell = summaryRow.getCell(colPos);
                    const meaning = cell ? (cell.color_meaning || 'blank') : 'blank';
                    let bgHex = '#FFFFFF';
                    if (meaning === 'failed') bgHex = '#FFCCCC';
                    else if (meaning === 'passed') bgHex = '#CCFFCC';
                    else if (meaning === 'warning') bgHex = '#FFFFCC';
                    else if (meaning === 'signal missing') bgHex = '#CCE5FF';
                    else if (meaning === 'trigger not occurred') bgHex = '#FFD9B3';
                    colorCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgHex.replace('#', 'FF') } };
                    colPos++;
                }
            });
            summaryRow.outlineLevel = 1;
            summaryRow.collapsed = !isExpanded;

            // 详细行
            items.forEach(item => {
                if (item === bestItem) return;
                const detailValues = ['', item.filename];
                firstKw.forEach((kw, idx) => {
                    const cell = (item.row.length > idx) ? item.row[idx] : null;
                    const val = cell ? (cell.value !== null && cell.value !== undefined ? cell.value : '') : '';
                    detailValues.push(val);
                    if (kw.addColorCol) {
                        const meaning = cell ? (cell.color_meaning || '') : '';
                        detailValues.push(meaning);
                    }
                });
                const detailRow = sheet.addRow(detailValues);
                const bgDetail = fileBgMap[item.filename] || 'FFFFFFFF';
                detailRow.eachCell(cell => {
                    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgDetail } };
                });
                let colPosDetail = 3;
                firstKw.forEach((kw, idx) => {
                    const cell = (item.row.length > idx) ? item.row[idx] : null;
                    const valCell = detailRow.getCell(colPosDetail);
                    if (kw.collectColor && cell && cell.color_name && cell.color_name !== 'blank') {
                        const hex = getColorCss(cell.color_name);
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                    } else {
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                    }
                    colPosDetail++;
                    if (kw.addColorCol) {
                        const colorCell = detailRow.getCell(colPosDetail);
                        const meaning = cell ? (cell.color_meaning || 'blank') : 'blank';
                        let bgHex = '#FFFFFF';
                        if (meaning === 'failed') bgHex = '#FFCCCC';
                        else if (meaning === 'passed') bgHex = '#CCFFCC';
                        else if (meaning === 'warning') bgHex = '#FFFFCC';
                        else if (meaning === 'signal missing') bgHex = '#CCE5FF';
                        else if (meaning === 'trigger not occurred') bgHex = '#FFD9B3';
                        colorCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgHex.replace('#', 'FF') } };
                        colPosDetail++;
                    }
                });
                detailRow.outlineLevel = 2;
            });
        });

        const buffer = await workbook.xlsx.writeBuffer();
        const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });

        if (typeof saveAs === 'function') {
            saveAs(blob, '合并统计.xlsx');
        } else {
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = '合并统计.xlsx';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            setTimeout(() => URL.revokeObjectURL(link.href), 10000);
        }
        log('合并统计导出成功（分组层级已优化）', 'success');
    } catch (e) {
        log('合并导出失败: ' + e.message, 'error');
        alert('导出失败，请查看日志（按Ctrl+Shift+I）\n' + e.message);
        console.error(e);
    }
}
























async function exportMergedExcel() {
    try {
        if (typeof ExcelJS === 'undefined') {
            alert('ExcelJS 库未加载，请刷新页面重试');
            return;
        }
        if (typeof saveAs !== 'function') {
            alert('FileSaver 库未加载，将使用备用下载方式');
        }

        if (!statisticsResults) {
            alert('请先执行统计');
            return;
        }
        const results = statisticsResults.results;
        if (results.length < 2) {
            alert('需要至少两个文件才能导出合并结果');
            return;
        }

        const scheme = statisticsResults.scheme;
        const alignKeyIdx = scheme.alignBaseKey;
        const hasAlign = alignKeyIdx !== null && alignKeyIdx !== undefined && alignKeyIdx !== '';
        const priorityOrder = scheme.priorityOrder || ['green', 'blue', 'yellow', 'orange', 'red', 'blank'];

        const workbook = new ExcelJS.Workbook();
        const sheet = workbook.addWorksheet('合并对比');

        // ---------- 1. 单元格采集项（平铺，但设为层级1，始终可见） ----------
        const hasAnyCell = results.some(r => r.data && r.data.hasCell);
        if (hasAnyCell) {
            const headers = ['来源文件', '关键字', '值'];
            let hasColor = results.some(r => (r.data.cellData || []).some(d => d.color_indexed !== null));
            if (hasColor) headers.push('结果');
            const headerRow = sheet.addRow(headers);
            headerRow.font = { bold: true, size: 12 };
            headerRow.alignment = { vertical: 'middle', horizontal: 'center' };
            headerRow.eachCell(cell => {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD3D3D3' } };
            });
            // 表头行设为层级1，不折叠（始终显示）
            headerRow.outlineLevel = 1;
            headerRow.collapsed = false;

            const bgColors = ['FFE6F3E6', 'FFFFF9E6', 'FFF0EDE6', 'FFF0E6F0', 'FFE6F0F0', 'FFF0E6E6'];
            results.forEach((res, fi) => {
                const cellData = res.data.cellData || [];
                const displayName = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
                cellData.forEach(d => {
                    let label = d.keyword.keywordText || '';
                    if (d.keyword.valuePosition === 'left') label += ' ←' + d.keyword.offset;
                    else if (d.keyword.valuePosition === 'right') label += ' →' + d.keyword.offset;
                    const rowValues = [displayName, label, (d.value !== null && d.value !== undefined ? d.value : '')];
                    if (hasColor) rowValues.push(d.color_meaning || '');
                    const row = sheet.addRow(rowValues);
                    row.eachCell(cell => {
                        cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgColors[fi % bgColors.length] } };
                    });
                    const valCell = row.getCell(3);
                    if (d.color_name && d.color_name !== 'blank') {
                        const hex = getColorCss(d.color_name);
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                    } else {
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                    }
                    const fontSize = d.keyword.fontSize || 14;
                    const isBold = d.keyword.bold || false;
                    row.eachCell(cell => { cell.font = { size: fontSize, bold: isBold }; });
                    // 单元格数据行设为层级1，不折叠
                    row.outlineLevel = 1;
                    row.collapsed = false;
                });
            });
            // 单元格部分结束后，不添加空行，避免产生额外层级
        }

        // ---------- 2. 列采集项（使用 Excel 分组功能） ----------
        const hasAnyColumn = results.some(r => r.data && r.data.hasColumn);
        if (!hasAnyColumn) {
            const buffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            if (typeof saveAs === 'function') saveAs(blob, '合并统计.xlsx');
            else {
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = '合并统计.xlsx';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                setTimeout(() => URL.revokeObjectURL(link.href), 10000);
            }
            log('合并统计导出成功（无列数据）', 'success');
            return;
        }

        // 取第一个有列数据的文件作为模板（强制对齐）
        let firstKw = null;
        for (let res of results) {
            if (res.data && res.data.columnData && res.data.columnData.keywords && res.data.columnData.keywords.length > 0) {
                firstKw = res.data.columnData.keywords;
                break;
            }
        }
        if (!firstKw) {
            const buffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            if (typeof saveAs === 'function') saveAs(blob, '合并统计.xlsx');
            else { /* 备用下载... */ }
            log('合并统计导出成功（无列数据）', 'success');
            return;
        }

        // 构建原始数据（按分组键归类）
        const allRows = [];
        results.forEach((res, fi) => {
            const rows = res.data.columnData.rows || [];
            const filename = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            rows.forEach(row => {
                let alignValue = null;
                if (hasAlign) {
                    const idx = parseInt(alignKeyIdx);
                    if (!isNaN(idx) && row.length > idx) {
                        alignValue = row[idx].value;
                    }
                }
                allRows.push({ filename, row, alignValue, fileIndex: fi });
            });
        });

        // 分组
        const groups = {};
        allRows.forEach(item => {
            let key = hasAlign ? (item.alignValue !== null && item.alignValue !== undefined ? String(item.alignValue) : '') : '';
            if (!key) key = '__no_align__';
            if (!groups[key]) groups[key] = [];
            groups[key].push(item);
        });

        // 排序分组键
        const groupKeys = Object.keys(groups).sort((a, b) => {
            if (a === '__no_align__') return 1;
            if (b === '__no_align__') return -1;
            const aNum = parseFloat(a);
            const bNum = parseFloat(b);
            if (!isNaN(aNum) && !isNaN(bNum)) return aNum - bNum;
            return a.localeCompare(b);
        });

        // --- 全局表头（列部分的表头） ---
        const colHeaders = ['分组键', '文件名'];
        firstKw.forEach((kw) => {
            let label = kw.keywordText || '';
            if (kw.valuePosition === 'left') label += ' ←' + kw.offset;
            else if (kw.valuePosition === 'right') label += ' →' + kw.offset;
            colHeaders.push(label);
            if (kw.addColorCol) colHeaders.push('结果');
        });
        const headerRow = sheet.addRow(colHeaders);
        headerRow.font = { bold: true, size: 12 };
        headerRow.alignment = { vertical: 'middle', horizontal: 'center' };
        headerRow.eachCell(cell => {
            cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD3D3D3' } };
        });
        // 列表头设为层级1，不折叠
        headerRow.outlineLevel = 1;
        headerRow.collapsed = false;

        // 文件背景色映射
        const bgColors = ['FFE6F3E6', 'FFFFF9E6', 'FFF0EDE6', 'FFF0E6F0', 'FFE6F0F0', 'FFF0E6E6'];
        const fileBgMap = {};
        results.forEach((res, fi) => {
            const filename = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            fileBgMap[filename] = bgColors[fi % bgColors.length];
        });

        // --- 遍历分组，写入数据并设置分组层级 ---
        groupKeys.forEach(key => {
            const items = groups[key];
            const isExpanded = groupStates[key] !== undefined ? groupStates[key] : true; // 默认展开

            // 计算该组的最佳行（用于摘要行）
            let bestItem = null;
            let bestPriority = 999;
            items.forEach(item => {
                let rowPriority = 999;
                firstKw.forEach((kw, idx) => {
                    if (kw.collectColor && item.row.length > idx) {
                        const color = item.row[idx].color_name || 'blank';
                        const p = getPriority(color, priorityOrder);
                        if (p < rowPriority) rowPriority = p;
                    }
                });
                if (rowPriority < bestPriority) {
                    bestPriority = rowPriority;
                    bestItem = item;
                }
            });
            if (!bestItem) return;

            const displayKey = (key === '__no_align__') ? '(未对齐)' : key;

            // 1. 写入摘要行（分组键 + 最佳行的文件名和数据）
            const summaryValues = [displayKey, bestItem.filename];
            firstKw.forEach((kw, idx) => {
                const cell = (bestItem.row.length > idx) ? bestItem.row[idx] : null;
                const val = cell ? (cell.value !== null && cell.value !== undefined ? cell.value : '') : '';
                summaryValues.push(val);
                if (kw.addColorCol) {
                    const meaning = cell ? (cell.color_meaning || '') : '';
                    summaryValues.push(meaning);
                }
            });
            const summaryRow = sheet.addRow(summaryValues);
            // 设置摘要行背景色
            const bg = fileBgMap[bestItem.filename] || 'FFFFFFFF';
            summaryRow.eachCell(cell => {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bg } };
                cell.font = { bold: true };
            });
            // 摘要行值列的颜色
            let colPos = 3;
            firstKw.forEach((kw, idx) => {
                const cell = (bestItem.row.length > idx) ? bestItem.row[idx] : null;
                const valCell = summaryRow.getCell(colPos);
                if (kw.collectColor && cell && cell.color_name && cell.color_name !== 'blank') {
                    const hex = getColorCss(cell.color_name);
                    valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                } else {
                    valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                }
                colPos++;
                if (kw.addColorCol) {
                    const colorCell = summaryRow.getCell(colPos);
                    const meaning = cell ? (cell.color_meaning || 'blank') : 'blank';
                    let bgHex = '#FFFFFF';
                    if (meaning === 'failed') bgHex = '#FFCCCC';
                    else if (meaning === 'passed') bgHex = '#CCFFCC';
                    else if (meaning === 'warning') bgHex = '#FFFFCC';
                    else if (meaning === 'signal missing') bgHex = '#CCE5FF';
                    else if (meaning === 'trigger not occurred') bgHex = '#FFD9B3';
                    colorCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgHex.replace('#', 'FF') } };
                    colPos++;
                }
            });

            // 摘要行设为层级1，并根据 groupStates 控制折叠
            summaryRow.outlineLevel = 1;
            summaryRow.collapsed = !isExpanded;

            // 2. 写入该组所有详细行
            items.forEach(item => {
                if (item === bestItem) return; // 跳过最佳行
                const detailValues = ['', item.filename]; // 分组键留空
                firstKw.forEach((kw, idx) => {
                    const cell = (item.row.length > idx) ? item.row[idx] : null;
                    const val = cell ? (cell.value !== null && cell.value !== undefined ? cell.value : '') : '';
                    detailValues.push(val);
                    if (kw.addColorCol) {
                        const meaning = cell ? (cell.color_meaning || '') : '';
                        detailValues.push(meaning);
                    }
                });
                const detailRow = sheet.addRow(detailValues);
                const bgDetail = fileBgMap[item.filename] || 'FFFFFFFF';
                detailRow.eachCell(cell => {
                    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgDetail } };
                });
                // 详细行值列颜色
                let colPosDetail = 3;
                firstKw.forEach((kw, idx) => {
                    const cell = (item.row.length > idx) ? item.row[idx] : null;
                    const valCell = detailRow.getCell(colPosDetail);
                    if (kw.collectColor && cell && cell.color_name && cell.color_name !== 'blank') {
                        const hex = getColorCss(cell.color_name);
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                    } else {
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                    }
                    colPosDetail++;
                    if (kw.addColorCol) {
                        const colorCell = detailRow.getCell(colPosDetail);
                        const meaning = cell ? (cell.color_meaning || 'blank') : 'blank';
                        let bgHex = '#FFFFFF';
                        if (meaning === 'failed') bgHex = '#FFCCCC';
                        else if (meaning === 'passed') bgHex = '#CCFFCC';
                        else if (meaning === 'warning') bgHex = '#FFFFCC';
                        else if (meaning === 'signal missing') bgHex = '#CCE5FF';
                        else if (meaning === 'trigger not occurred') bgHex = '#FFD9B3';
                        colorCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgHex.replace('#', 'FF') } };
                        colPosDetail++;
                    }
                });
                // 详细行设为层级2，不单独折叠（由父级控制）
                detailRow.outlineLevel = 2;
            });
        });

        // 生成文件并下载
        const buffer = await workbook.xlsx.writeBuffer();
        const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });

        if (typeof saveAs === 'function') {
            saveAs(blob, '合并统计.xlsx');
        } else {
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = '合并统计.xlsx';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            setTimeout(() => URL.revokeObjectURL(link.href), 10000);
        }
        log('合并统计导出成功（分组层级已优化）', 'success');
    } catch (e) {
        log('合并导出失败: ' + e.message, 'error');
        alert('导出失败，请查看日志（按Ctrl+Shift+I）\n' + e.message);
        console.error(e);
    }
}













async function exportMergedExcel() {
    try {
        if (typeof ExcelJS === 'undefined') {
            alert('ExcelJS 库未加载，请刷新页面重试');
            return;
        }
        if (typeof saveAs !== 'function') {
            alert('FileSaver 库未加载，将使用备用下载方式');
        }

        if (!statisticsResults) {
            alert('请先执行统计');
            return;
        }
        const results = statisticsResults.results;
        if (results.length < 2) {
            alert('需要至少两个文件才能导出合并结果');
            return;
        }

        const scheme = statisticsResults.scheme;
        const alignKeyIdx = scheme.alignBaseKey;
        const hasAlign = alignKeyIdx !== null && alignKeyIdx !== undefined && alignKeyIdx !== '';
        const priorityOrder = scheme.priorityOrder || ['green', 'blue', 'yellow', 'orange', 'red', 'blank'];

        const workbook = new ExcelJS.Workbook();
        const sheet = workbook.addWorksheet('合并对比');

        // ---------- 1. 单元格采集项（平铺，但设为层级1，始终可见） ----------
        const hasAnyCell = results.some(r => r.data && r.data.hasCell);
        if (hasAnyCell) {
            const headers = ['来源文件', '关键字', '值'];
            let hasColor = results.some(r => (r.data.cellData || []).some(d => d.color_indexed !== null));
            if (hasColor) headers.push('结果');
            const headerRow = sheet.addRow(headers);
            headerRow.font = { bold: true, size: 12 };
            headerRow.alignment = { vertical: 'middle', horizontal: 'center' };
            headerRow.eachCell(cell => {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD3D3D3' } };
            });
            // 表头行设为层级1，不折叠（始终显示）
            headerRow.outlineLevel = 1;
            headerRow.collapsed = false;

            const bgColors = ['FFE6F3E6', 'FFFFF9E6', 'FFF0EDE6', 'FFF0E6F0', 'FFE6F0F0', 'FFF0E6E6'];
            results.forEach((res, fi) => {
                const cellData = res.data.cellData || [];
                const displayName = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
                cellData.forEach(d => {
                    let label = d.keyword.keywordText || '';
                    if (d.keyword.valuePosition === 'left') label += ' ←' + d.keyword.offset;
                    else if (d.keyword.valuePosition === 'right') label += ' →' + d.keyword.offset;
                    const rowValues = [displayName, label, (d.value !== null && d.value !== undefined ? d.value : '')];
                    if (hasColor) rowValues.push(d.color_meaning || '');
                    const row = sheet.addRow(rowValues);
                    row.eachCell(cell => {
                        cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgColors[fi % bgColors.length] } };
                    });
                    const valCell = row.getCell(3);
                    if (d.color_name && d.color_name !== 'blank') {
                        const hex = getColorCss(d.color_name);
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
                    } else {
                        valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFFFFF' } };
                    }
                    const fontSize = d.keyword.fontSize || 14;
                    const isBold = d.keyword.bold || false;
                    row.eachCell(cell => { cell.font = { size: fontSize, bold: isBold }; });
                    // 单元格数据行设为层级1，不折叠
                    row.outlineLevel = 1;
                    row.collapsed = false;
                });
            });
            // 单元格部分结束后，不添加空行，避免产生额外层级
        }

        // ---------- 2. 列采集项（使用 Excel 分组功能） ----------
        const hasAnyColumn = results.some(r => r.data && r.data.hasColumn);
        if (!hasAnyColumn) {
            const buffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            if (typeof saveAs === 'function') saveAs(blob, '合并统计.xlsx');
            else {
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = '合并统计.xlsx';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                setTimeout(() => URL.revokeObjectURL(link.href), 10000);
            }
            log('合并统计导出成功（无列数据）', 'success');
            return;
        }

        // 取第一个有列数据的文件作为模板（强制对齐）
        let firstKw = null;
        for (let res of results) {
            if (res.data && res.data.columnData && res.data.columnData.keywords && res.data.columnData.keywords.length > 0) {
                firstKw = res.data.columnData.keywords;
                break;
            }
        }
        if (!firstKw) {
            const buffer = await workbook.xlsx.writeBuffer();
            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            if (typeof saveAs === 'function') saveAs(blob, '合并统计.xlsx');
            else { /* 备用下载... */ }
            log('合并统计导出成功（无列数据）', 'success');
            return;
        }

        // 构建原始数据（按分组键归类）
        const allRows = [];
        results.forEach((res, fi) => {
            const rows = res.data.columnData.rows || [];
            const filename = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            rows.forEach(row => {
                let alignValue = null;
                if (hasAlign) {
                    const idx = parseInt(alignKeyIdx);
                    if (!isNaN(idx) && row.length > idx) {
                        alignValue = row[idx].value;
                    }
                }
                allRows.push({ filename, row, alignValue, fileIndex: fi });
