        // 排序分组键
        const groupKeys = Object.keys(groups).sort((a, b) => {
            if (a === '__no_align__') return 1;
            if (b === '__no_align__') return -1;
            const aNum = parseFloat(a);
            const bNum = parseFloat(b);
            if (!isNaN(aNum) && !isNaN(bNum)) return aNum - bNum;
            return a.localeCompare(b);
        });

        // --- 全局表头（列部分的表头） ---
        const colHeaders = ['分组键', '文件名'];
        firstKw.forEach((kw) => {
            let label = kw.keywordText || '';
            if (kw.valuePosition === 'left') label += ' ←' + kw.offset;
            else if (kw.valuePosition === 'right') label += ' →' + kw.offset;
            colHeaders.push(label);
            if (kw.addColorCol) colHeaders.push('结果');
        });
        const headerRow = sheet.addRow(colHeaders);
        headerRow.font = { bold: true, size: 12 };
        headerRow.alignment = { vertical: 'middle', horizontal: 'center' };
        headerRow.eachCell(cell => {
            cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD3D3D3' } };
        });
        // 列表头设为层级1，不折叠
        headerRow.outlineLevel = 1;
        headerRow.collapsed = false;

        // 文件背景色映射
        const bgColors = ['FFE6F3E6', 'FFFFF9E6', 'FFF0EDE6', 'FFF0E6F0', 'FFE6F0F0', 'FFF0E6E6'];
        const fileBgMap = {};
        results.forEach((res, fi) => {
            const filename = res.folder ? `${res.folder}/${res.originalName || res.name}` : (res.name || res.originalName || '文件');
            fileBgMap[filename] = bgColors[fi % bgColors.length];
        });

        // --- 遍历分组，写入数据并设置分组层级 ---
        groupKeys.forEach(key => {
            const items = groups[key];
            const isExpanded = groupStates[key] !== undefined ? groupStates[key] : true; // 默认展开

            // 计算该组的最佳行（用于摘要行）
            let bestItem = null;
            let bestPriority = 999;
            items.forEach(item => {
                let rowPriority = 999;
                firstKw.forEach((kw, idx) => {
                    if (kw.collectColor && item.row.length > idx) {
                        const color = item.row[idx].color_name || 'blank';
                        const p = getPriority(color, priorityOrder);
                        if (p < rowPriority) rowPriority = p;
                    }
                });
                if (rowPriority < bestPriority) {
                    bestPriority = rowPriority;
                    bestItem = item;
                }
            });
            if (!bestItem) return;

            const displayKey = (key === '__no_align__') ? '(未对齐)' : key;

            // 1. 写入摘要行（分组键 + 最佳行的文件名和数据）
            const summaryValues = [displayKey, bestItem.filename];
            firstKw.forEach((kw, idx) => {
                const cell = (bestItem.row.length > idx) ? bestItem.row[idx] : null;
                const val = cell ? (cell.value !== null && cell.value !== undefined ? cell.value : '') : '';
                summaryValues.push(val);
