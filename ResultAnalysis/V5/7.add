                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bg } };
                cell.font = { bold: true };
            });
            // 摘要行值列的颜色
            let colPos = 3;
            firstKw.forEach((kw, idx) => {
                const cell = (bestItem.row.length > idx) ? bestItem.row[idx] : null;
                const valCell = summaryRow.getCell(colPos);
                if (kw.collectColor && cell && cell.color_name && cell.color_name !== 'blank') {
                    const hex = getColorCss(cell.color_name);
                    valCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: hex.replace('#', 'FF') } };
