import sys
import os
import json
import re
from PyQt5.QtWidgets import (QApplication, QMainWindow, QWidget, QVBoxLayout, 
                             QHBoxLayout, QPushButton, QTableWidget, QTableWidgetItem, 
                             QHeaderView, QComboBox, QCheckBox, QFileDialog, QMessageBox,
                             QLabel, QLineEdit) # 引入 QLineEdit
from PyQt5.QtCore import Qt, QThread, pyqtSignal
from PyQt5.QtGui import QDragEnterEvent, QDropEvent, QFont
import openpyxl

# ================= 配置 =================
CONFIG_FILE = "fa_config.json"
SHEET_NAME = "IPN"
TARGET_COL_NAME = "Kategorie"
TARGET_CELL_KEYWORD = "FA"

class ExcelWorker(QThread):
    data_loaded = pyqtSignal(list, str)
    
    def __init__(self, file_path, parent=None):
        super().__init__(parent)
        self.file_path = file_path

    def run(self):
        try:
            wb = openpyxl.load_workbook(self.file_path, data_only=True)
            if SHEET_NAME not in wb.sheetnames:
                self.data_loaded.emit([], f"错误：Sheet页 '{SHEET_NAME}' 不存在！")
                return

            ws = wb[SHEET_NAME]
            config = self.load_config()
            data_rows = []
            
            # 1. 找到 Kategorie 列的索引 (1-based)
            kategorie_col_idx = None
            for col_idx, cell in enumerate(next(ws.iter_rows(min_row=1, max_row=1)), start=1):
                if cell.value == TARGET_COL_NAME:
                    kategorie_col_idx = col_idx
                    break

            if kategorie_col_idx is None:
                self.data_loaded.emit([], f"错误：未找到列名为 '{TARGET_COL_NAME}' 的列！")
                return

            # 2. 遍历该列，检索内容完全等于 "FA" 的单元格
            col_cells = ws[f"{openpyxl.utils.get_column_letter(kategorie_col_idx)}"]
            for row_idx, cell in enumerate(col_cells, start=1):
                if row_idx == 1: continue # 跳过表头
                
                if cell.value == TARGET_CELL_KEYWORD:
                    # 获取左右单元格数据
                    left_cell = ws.cell(row=row_idx, column=kategorie_col_idx - 1).value if kategorie_col_idx > 1 else ""
                    right_cell = ws.cell(row=row_idx, column=kategorie_col_idx + 1).value
                    
                    right_str = str(right_cell) if right_cell else ""
                    matches = re.findall(r'FA="([^"]*)"', right_str)
                    
                    if matches:
                        current_fa_val = matches[0].strip()
                        data_rows.append({
                            'row_idx': row_idx,
                            'left_val': left_cell,        # ID
                            'middle_val': TARGET_CELL_KEYWORD, # 识别行
                            'right_raw': right_str,       # FA列内容 (可能包含换行)
                            'current_fa_val': current_fa_val  # 当前FA（键名）
                        })

            self.data_loaded.emit(data_rows, self.file_path)
        except Exception as e:
            self.data_loaded.emit([], f"读取错误：{str(e)}")

    def load_config(self):
        if os.path.exists(CONFIG_FILE):
            try:
                with open(CONFIG_FILE, 'r', encoding='utf-8') as f:
                    return json.load(f)
            except:
                return {}
        return {}

class FAReplacerApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.current_file_path = None
        self.data_store = []
        self.config_data = {}
        self.initUI()
        self.load_config_from_json()
        self.update_batch_combo()

    def initUI(self):
        self.setWindowTitle("FA 键名批量替换工具")
        self.setGeometry(100, 100, 1100, 650)
        self.setAcceptDrops(True)

        main_widget = QWidget()
        self.setCentralWidget(main_widget)
        layout = QVBoxLayout(main_widget)

        # 1. 顶部工具栏
        toolbar = QHBoxLayout()
        
        self.btn_load = QPushButton("📂 加载 Excel")
        self.btn_load.clicked.connect(self.load_excel)
        
        self.btn_refresh = QPushButton("🔄 刷新")
        self.btn_refresh.clicked.connect(self.refresh_data)
        
        # 全选/取消全选 按钮
        self.btn_select_all = QPushButton("✅ 全选/取消")
        self.btn_select_all.clicked.connect(self.toggle_select_all)
        
        # 批量替换设置
        self.batch_combo = QComboBox()
        self.batch_combo.setMinimumWidth(120)
        self.btn_batch_apply = QPushButton("⬇️ 应用至所有行")
        self.btn_batch_apply.clicked.connect(self.apply_batch_to_all)
        
        self.btn_replace = QPushButton("✍️ 执行更换")
        self.btn_replace.clicked.connect(self.execute_replacement)
        
        toolbar.addWidget(self.btn_load)
        toolbar.addWidget(self.btn_refresh)
        toolbar.addWidget(self.btn_select_all)
        toolbar.addWidget(QLabel("批量设:"))
        toolbar.addWidget(self.batch_combo)
        toolbar.addWidget(self.btn_batch_apply)
        toolbar.addWidget(self.btn_replace)
        toolbar.addStretch()
        layout.addLayout(toolbar)

        # 2. 文件路径显示区和清除按钮 (新增功能)
        file_bar = QHBoxLayout()
        
        file_bar.addWidget(QLabel("文件路径:"))
        
        self.path_display = QLineEdit()
        self.path_display.setReadOnly(True) # 只读，但允许复制路径
        self.path_display.setPlaceholderText("未加载 Excel 文件")
        self.path_display.setStyleSheet("QLineEdit { border: 1px solid #ccc; border-radius: 3px; background: #f5f5f5; padding: 3px; }")
        file_bar.addWidget(self.path_display)
        
        self.btn_clear = QPushButton("✕")
        self.btn_clear.setFixedSize(26, 26)
        self.btn_clear.setToolTip("卸载当前 Excel 文件")
        self.btn_clear.clicked.connect(self.clear_excel)
        file_bar.addWidget(self.btn_clear)
        
        layout.addLayout(file_bar)

        # 3. 状态提示区
        self.status_label = QLabel("拖拽 Excel 文件到窗口任意位置加载 (需包含 'IPN' Sheet页和 'Kategorie' 列)")
        self.status_label.setStyleSheet("color: #666; padding: 5px; border: 1px dashed #aaa; background: #f9f9f9;")
        self.status_label.setAlignment(Qt.AlignCenter)
        layout.addWidget(self.status_label)

        # 4. 数据表格
        self.table = QTableWidget()
        self.table.setColumnCount(7)
        self.table.setHorizontalHeaderLabels(["勾选", "ID", "识别行", "FA", "当前FA", "替换", "待修改行"])
        
        self.table.setWordWrap(True)

        header = self.table.horizontalHeader()
        header.setSectionResizeMode(0, QHeaderView.ResizeToContents)
        header.setSectionResizeMode(1, QHeaderView.ResizeToContents)
        header.setSectionResizeMode(2, QHeaderView.ResizeToContents)
        header.setSectionResizeMode(3, QHeaderView.Stretch)
        header.setSectionResizeMode(4, QHeaderView.ResizeToContents)
        header.setSectionResizeMode(5, QHeaderView.ResizeToContents)
        header.setSectionResizeMode(6, QHeaderView.ResizeToContents)
        
        self.table.setColumnHidden(6, True)
        layout.addWidget(self.table)

    def load_config_from_json(self):
        if os.path.exists(CONFIG_FILE):
            try:
                with open(CONFIG_FILE, 'r', encoding='utf-8') as f:
                    self.config_data = json.load(f)
            except Exception as e:
                QMessageBox.warning(self, "配置警告", f"加载 {CONFIG_FILE} 失败。错误: {e}")
                self.config_data = {}
        else:
            QMessageBox.information(self, "提示", f"未找到配置文件 {CONFIG_FILE}，请创建并填入键值对。\n例如: {{ \"AUDI\": \"奥迪\" }}")
            self.config_data = {}

    def update_batch_combo(self):
        self.batch_combo.clear()
        self.batch_combo.addItems(list(self.config_data.keys()))

    # ================= 拖拽逻辑 =================
    def dragEnterEvent(self, event: QDragEnterEvent):
        if event.mimeData().hasUrls():
            event.acceptProposedAction()

    def dropEvent(self, event: QDropEvent):
        urls = event.mimeData().urls()
        if urls:
            file_path = urls[0].toLocalFile()
            if file_path.lower().endswith(('.xlsx', '.xls')):
                self.process_file(file_path)
            else:
                self.status_label.setText("⚠️ 请拖入 .xlsx 或 .xls 格式的 Excel 文件")

    # ================= 核心加载与渲染逻辑 =================
    def load_excel(self):
        file_path, _ = QFileDialog.getOpenFileName(self, "选择 Excel 文件", "", "Excel Files (*.xlsx *.xls)")
        if file_path:
            self.process_file(file_path)

    def process_file(self, file_path):
        self.clear_excel() # 加载前先清空当前数据
        self.current_file_path = file_path
        self.path_display.setText(file_path) # 路径显示
        self.status_label.setText(f"正在读取: {os.path.basename(file_path)} ...")
        
        self.worker = ExcelWorker(file_path)
        self.worker.data_loaded.connect(self.on_data_loaded)
        self.worker.start()

    def on_data_loaded(self, data_rows, msg):
        # 如果点击清除后数据才返回，忽略它
        if not self.current_file_path:
            return

        if not data_rows:
            self.status_label.setText(f"❌ {msg}")
            QMessageBox.warning(self, "提示", msg)
            self.clear_excel() # 读取失败，自动清除错误数据
            return
        
        self.data_store = data_rows
        self.render_table(data_rows)
        self.status_label.setText(f"✅ 加载成功！在 'Kategorie' 列找到 {len(data_rows)} 个 'FA' 配置。")

    def render_table(self, data_rows):
        self.table.setRowCount(len(data_rows))
        config_keys = list(self.config_data.keys())

        for row_idx, item in enumerate(data_rows):
            # 1. 复选框
            chk = QCheckBox()
            chk.setChecked(True)
            chk_widget = QWidget()
            chk_layout = QHBoxLayout(chk_widget)
            chk_layout.addWidget(chk)
            chk_layout.setAlignment(Qt.AlignCenter)
            chk_layout.setContentsMargins(0,0,0,0)
            self.table.setCellWidget(row_idx, 0, chk_widget)

            self.table.setItem(row_idx, 1, QTableWidgetItem(str(item['left_val']))) 
            self.table.setItem(row_idx, 2, QTableWidgetItem(str(item['middle_val']))) 
            
            fa_item = QTableWidgetItem(item['right_raw'])
            fa_font = QFont("Microsoft YaHei", 8)
            fa_item.setFont(fa_font)
            self.table.setItem(row_idx, 3, fa_item)
            
            self.table.setItem(row_idx, 4, QTableWidgetItem(item['current_fa_val'])) 

            combo = QComboBox()
            combo.addItems(config_keys)
            if item['current_fa_val'] in config_keys:
                combo.setCurrentText(item['current_fa_val'])
            combo_widget = QWidget()
            combo_layout = QHBoxLayout(combo_widget)
            combo_layout.addWidget(combo)
            combo_layout.setAlignment(Qt.AlignCenter)
            combo_layout.setContentsMargins(0,0,0,0)
            self.table.setCellWidget(row_idx, 5, combo_widget)

            self.table.setItem(row_idx, 6, QTableWidgetItem(str(item['row_idx'])))
        
        self.table.resizeRowsToContents()

    # ================= 新增：清除文件功能 =================
    def clear_excel(self):
        """卸载当前文件并清空界面"""
        self.current_file_path = None
        self.data_store = []
        self.table.setRowCount(0)
        self.path_display.clear()
        self.status_label.setText("已卸载当前 Excel 文件，可重新加载或拖拽。")

    # ================= 批量交互功能 =================
    def toggle_select_all(self):
        rows = self.table.rowCount()
        if rows == 0: return
        
        chk_widget_first = self.table.cellWidget(0, 0)
        first_chk = chk_widget_first.findChild(QCheckBox) if chk_widget_first else None
        new_state = not (first_chk and first_chk.isChecked())
        
        for i in range(rows):
            chk_widget = self.table.cellWidget(i, 0)
            if chk_widget:
                chk = chk_widget.findChild(QCheckBox)
                if chk:
                    chk.setChecked(new_state)

    def apply_batch_to_all(self):
        rows = self.table.rowCount()
        if rows == 0:
            QMessageBox.information(self, "提示", "表格当前没有数据！")
            return
            
        selected_key = self.batch_combo.currentText()
        for i in range(rows):
            combo_widget = self.table.cellWidget(i, 5)
            if combo_widget:
                combo = combo_widget.findChild(QComboBox)
                if combo:
                    index = combo.findText(selected_key)
                    if index >= 0:
                        combo.setCurrentIndex(index)

    # ================= 刷新与替换逻辑 =================
    def refresh_data(self):
        if self.current_file_path:
            self.process_file(self.current_file_path)
        else:
            QMessageBox.information(self, "提示", "请先加载一个 Excel 文件！")

    def execute_replacement(self):
        if not self.data_store or not self.current_file_path:
            QMessageBox.warning(self, "提示", "请先加载并解析 Excel 数据！")
            return

        updates = []
        rows_to_update = self.table.rowCount()
        
        for i in range(rows_to_update):
            chk_widget = self.table.cellWidget(i, 0)
            if chk_widget:
                chk = chk_widget.findChild(QCheckBox)
                if not chk or not chk.isChecked():
                    continue
            
            combo_widget = self.table.cellWidget(i, 5)
            if not combo_widget: continue
            combo = combo_widget.findChild(QComboBox)
            new_fa_val = combo.currentText()

            row_idx = int(self.table.item(i, 6).text())
            raw_content = self.table.item(i, 3).text()
            
            updates.append({
                'row_idx': row_idx,
                'raw': raw_content,
                'new_fa_val': new_fa_val
            })

        if not updates:
            QMessageBox.information(self, "提示", "未勾选任何需要修改的行！")
            return

        try:
            wb = openpyxl.load_workbook(self.current_file_path)
            ws = wb[SHEET_NAME]
            
            kategorie_col_idx = None
            for idx, cell in enumerate(next(ws.iter_rows(min_row=1, max_row=1)), start=1):
                if cell.value == TARGET_COL_NAME:
                    kategorie_col_idx = idx
                    break
            
            if kategorie_col_idx is None:
                QMessageBox.critical(self, "错误", "内部错误：无法找到 Kategorie 列！")
                return

            for upd in updates:
                cell = ws.cell(row=upd['row_idx'], column=kategorie_col_idx + 1)
                old_text = upd['raw']
                new_text = re.sub(r'FA="([^"]*)"', f'FA="{upd["new_fa_val"]}"', old_text)
                cell.value = new_text

            wb.save(self.current_file_path)
            
            QMessageBox.information(self, "成功", f"成功替换了 {len(updates)} 条数据！即将重新加载 Excel 刷新。")
            self.process_file(self.current_file_path) 

        except Exception as e:
            QMessageBox.critical(self, "严重错误", f"写入文件时失败: {str(e)}")

if __name__ == '__main__':
    app = QApplication(sys.argv)
    window = FAReplacerApp()
    window.show()
    sys.exit(app.exec_())