1737685	Passed	25.05.2026 qz629N: Passed.Manually evaluated as passed ML need updeate Required targetcurve[CN_stack_DFT_ModelCN_stack_DFT_stack]==180d, t=AdcLow_AdmissGuid_128+0.5s: Expected value delay with 3.29s (GER 1777543 result:3.315s)
1737686	Passed	25.05.2026 qz629N: Passed. Manually evaluated as passed
1737689	Passed	LimitSteaterAccelerationRequest always 0 compare with GER TS 1777543
1737951	Passed	25.05.2026 qz715a: passed. Automatically passed
1737952	Passed	25.05.2026 qz715a: passed. Automatically passed
1737963	Passed	25.05.2026 qz715a: passed.manually evaluated as pass
1737965	Passed	19.05.2026 qz715a:max(excepded14+16), GER 1779087 result:16.0039
1754198	Passed	25.05.2026 qz629N: Passed. Manually evaluated as passed. Compare with GER TS 1779087
1760607	Passed	Stimulation time out, but all required signal value passed
1757611	Passed	25.05.2026 qz715a: Passed. Automatically passed
1757613	Passed	25.05.2026 qz715a: Passed. Automatically passed
1737233	Passed	25.05.2026 qz715a: Passed. Automatically passed
1734835	Passed	25.05.2026 qz715a: passed. Automatically passed
1734836	Passed	25.05.2026 qz715a: passed. Automatically passed
1734838	Passed	25.05.2026 qz715a: passed. Automatically passed
1734841	Passed	25.05.2026 qz715a: passed. Automatically passed`;

    const idMap = {};
    caseData.split('\n').forEach(line=>{
        const parts = line.trim().split(/\t+/);
        const cid = parts[0]?.trim();
        if(!cid) return;
        idMap[cid] = {
            result: parts[1]?.trim() || '',
            remark: parts.slice(2).join('\t').trim() || ''
        };
    });

    console.log(`✅ 已加载 ${Object.keys(idMap).length} 条Case`);

    const processed = new WeakSet();

    function render(){
        const rows = document.querySelectorAll('.slick-row');
        let matchCount = 0;

        rows.forEach(row=>{
            if(processed.has(row)) return;

            const cells = row.querySelectorAll('.slick-cell');
            let matchedId = null;

            // 先匹配ID
            for(const cell of cells){
                const pureText = cell.textContent.trim().replace(/\s+/g,'');
                if(idMap[pureText]){
                    matchedId = pureText;
                    break;
                }
            }

            if(!matchedId) return;
            matchCount++;

            // 先清掉本行旧的辅助列，避免重复叠加重叠
            row.querySelectorAll('.temp-aux-col').forEach(el=>el.remove());

            // 新建首列辅助单元格
            const resCol = document.createElement('div');
            resCol.className = 'temp-aux-col slick-cell';
            resCol.style = 'float:left;background:#d4edda;border:1px solid #28a745;padding:6px 6px;cursor:pointer;width:140px;word-break:break-all;margin-right:4px;z-index:999;';
            resCol.textContent = idMap[matchedId].result;
            resCol.onclick = ()=>{
                navigator.clipboard.writeText(resCol.textContent);
                alert('✅ 复制结果成功');
            };

            const remCol = document.createElement('div');
            remCol.className = 'temp-aux-col slick-cell';
            remCol.style = 'float:left;background:#cce5ff;border:1px solid #007bff;padding:6px 6px;cursor:pointer;width:380px;white-space:pre-wrap;word-break:break-all;margin-right:4px;z-index:999;';
            remCol.textContent = idMap[matchedId].remark;
            remCol.onclick = ()=>{
                navigator.clipboard.writeText(remCol.textContent);
                alert('✅ 复制备注成功');
            };

            // ✅ 插入到【本行最开头 首列位置】
            row.prepend(resCol, remCol);
            processed.add(row);
        });

        console.log(`✅ 本轮新增匹配 ${matchCount} 条，累计 ${processed.size} 条`);
    }

    // 延迟渲染+兜底重试
    setTimeout(render, 1000);
    setTimeout(render, 2500);
    setTimeout(render, 4500);

    // 滚动/懒加载自动更新
    let timer = null;
    new MutationObserver(()=>{
        clearTimeout(timer);
        timer = setTimeout(render, 350);
    }).observe(document.body, {childList:true, subtree:true});

    window.addEventListener('scroll', ()=>{
        clearTimeout(timer);
        timer = setTimeout(render, 400);
    });

    console.log("🚀 首列插入专属脚本运行完成");
})();
