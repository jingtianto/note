1734835	Passed	25.05.2026 qz715a: passed. Automatically passed
1734836	Passed	25.05.2026 qz715a: passed. Automatically passed
1734838	Passed	25.05.2026 qz715a: passed. Automatically passed
1734841	Passed	25.05.2026 qz715a: passed. Automatically passed`;

    // ==================== 智能解析（支持备注内换行） ====================
    function parseCaseData(rawText) {
        const lines = rawText.split(/\r?\n/);
        const idMap = {};
        let currentId = null;
        let currentResult = null;
        let currentRemark = [];

        for (const line of lines) {
            const trimmed = line.trim();
            if (trimmed === '') continue;

            // 匹配行首：数字 + 制表符/空格 + 结果单词（Passed/Failed等）
            const match = trimmed.match(/^(\d+)[\t\s]+(\S+)/);
            if (match) {
                // 保存上一个 Case
                if (currentId !== null) {
                    idMap[currentId] = {
                        result: currentResult,
                        remark: currentRemark.join('\n').trim()
                    };
                }
                // 开始新 Case
                currentId = match[1];
                currentResult = match[2];
                const rest = trimmed.substring(match[0].length).trim();
                currentRemark = rest ? [rest] : [];
            } else {
                // 续行：追加到上一个 Case 的备注
                if (currentId !== null) {
                    currentRemark.push(trimmed);
                }
            }
        }
        // 保存最后一个
        if (currentId !== null) {
            idMap[currentId] = {
                result: currentResult,
                remark: currentRemark.join('\n').trim()
            };
        }
        return idMap;
    }

    const idMap = parseCaseData(caseData);
    console.log(`✅ 成功加载 ${Object.keys(idMap).length} 条Case数据（支持多行备注）`);

    // ==================== 辅助函数 ====================
    function copyToClip(text, label) {
        navigator.clipboard.writeText(text).then(() => {
            alert(`✅ 已复制${label}`);
        }).catch(() => {
            alert(`❌ 复制${label}失败，请手动复制`);
        });
    }

    // 创建悬浮层（包含 ID、结果、备注 三列，完全脱离表格流，无重叠）
    function createFloatingBadge(id, result, remark, targetCell) {
        const wrapper = document.createElement('div');
        wrapper.className = 'slick-extra-floating';
        wrapper.style.cssText = `
            position: fixed;
            background: white;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-shadow: 2px 2px 8px rgba(0,0,0,0.2);
            z-index: 100000;
            display: inline-flex;
            gap: 6px;
            padding: 4px 8px;
            pointer-events: auto;
            white-space: nowrap;
        `;

        // ID 徽章（灰色）
        const idSpan = document.createElement('span');
        idSpan.textContent = id;
        idSpan.style.cssText = `
            background: #e9ecef;
            border: 1px solid #6c757d;
            padding: 2px 8px;
            border-radius: 12px;
            cursor: pointer;
            font-size: 11px;
            font-weight: 500;
        `;
        idSpan.title = '点击复制 Case ID';
        idSpan.onclick = (e) => {
            e.stopPropagation();
            copyToClip(id, 'Case ID');
        };

        // 结果徽章（绿色）
        const resSpan = document.createElement('span');
        resSpan.textContent = result;
        resSpan.style.cssText = `
            background: #d4edda;
            border: 1px solid #28a745;
            padding: 2px 8px;
            border-radius: 12px;
            cursor: pointer;
            font-size: 11px;
            font-weight: 500;
        `;
        resSpan.title = '点击复制执行结果';
        resSpan.onclick = (e) => {
            e.stopPropagation();
            copyToClip(result, '执行结果');
        };

        // 备注徽章（蓝色，长文本截断）
        const shortRemark = remark.length > 30 ? remark.substring(0, 30) + '…' : remark;
        const remSpan = document.createElement('span');
        remSpan.textContent = shortRemark;
        remSpan.style.cssText = `
            background: #cce5ff;
            border: 1px solid #007bff;
            padding: 2px 8px;
            border-radius: 12px;
            cursor: pointer;
            font-size: 11px;
            max-width: 250px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        `;
        remSpan.title = remark;  // 悬浮显示完整备注（含换行）
        remSpan.onclick = (e) => {
            e.stopPropagation();
            copyToClip(remark, '完整备注');
        };

        wrapper.appendChild(idSpan);
        wrapper.appendChild(resSpan);
        wrapper.appendChild(remSpan);
        document.body.appendChild(wrapper);

        // 动态定位（始终显示在目标单元格右侧）
        function updatePosition() {
            const rect = targetCell.getBoundingClientRect();
            wrapper.style.left = rect.right + 5 + 'px';
            wrapper.style.top = rect.top + 'px';
        }
        updatePosition();

        // 滚动 / 窗口缩放时重新定位
        const updateHandler = () => updatePosition();
        window.addEventListener('scroll', updateHandler, true);
        window.addEventListener('resize', updateHandler);

        // 清理函数（移除时注销事件）
        wrapper._cleanup = () => {
            window.removeEventListener('scroll', updateHandler, true);
            window.removeEventListener('resize', updateHandler);
        };
        return wrapper;
    }

    // WeakMap 存储每个单元格对应的悬浮层及清理函数
    let floatingMap = new WeakMap();

    function updateOrCreateFloating(cell, matchedId) {
        const { result, remark } = idMap[matchedId];
        let entry = floatingMap.get(cell);
        if (entry) {
            // 更新现有悬浮层（内容可能变化）
            const wrapper = entry.wrapper;
            const children = wrapper.children; // [idSpan, resSpan, remSpan]
            if (children.length >= 3) {
                const resSpan = children[1];
                const remSpan = children[2];
                if (resSpan.textContent !== result) {
                    resSpan.textContent = result;
                    resSpan.onclick = (e) => {
                        e.stopPropagation();
                        copyToClip(result, '执行结果');
                    };
                }
                const newShortRemark = remark.length > 30 ? remark.substring(0, 30) + '…' : remark;
                if (remSpan.textContent !== newShortRemark) {
                    remSpan.textContent = newShortRemark;
                    remSpan.title = remark;
                    remSpan.onclick = (e) => {
                        e.stopPropagation();
                        copyToClip(remark, '完整备注');
                    };
                }
            }
            // 更新位置
            const rect = cell.getBoundingClientRect();
            wrapper.style.left = rect.right + 5 + 'px';
            wrapper.style.top = rect.top + 'px';
        } else {
            // 创建新的悬浮层
            const wrapper = createFloatingBadge(matchedId, result, remark, cell);
            floatingMap.set(cell, { wrapper, cleanup: wrapper._cleanup });
        }
    }

    // ==================== 核心渲染（匹配 ID 并挂载悬浮层） ====================
    function render() {
        const rows = document.querySelectorAll('.slick-row');
        let matchCount = 0;

        rows.forEach(row => {
            const cells = row.querySelectorAll('.slick-cell');
            let targetCell = null;
            let matchedId = null;

            for (const cell of cells) {
                const cleanText = cell.textContent.trim().replace(/\s+/g, '');
                if (idMap[cleanText]) {
                    matchedId = cleanText;
                    targetCell = cell;
                    break;
                }
            }
            if (!targetCell) return;
            matchCount++;
            updateOrCreateFloating(targetCell, matchedId);
        });

        if (matchCount) console.log(`✅ 已处理 ${matchCount} 行，悬浮三列（ID/结果/备注）已显示`);
    }

    // ==================== 自动监听表格变化（分页、滚动、筛选） ====================
    setTimeout(render, 800);
    setTimeout(render, 2000);
    setTimeout(render, 4000);

    let timer = null;
    new MutationObserver(() => {
        clearTimeout(timer);
        timer = setTimeout(render, 300);
    }).observe(document.body, { childList: true, subtree: true });

    window.addEventListener('scroll', () => {
        clearTimeout(timer);
        timer = setTimeout(render, 400);
    });

    console.log("🚀 已启动 Slick Grid 三列辅助浮层（支持多行备注，无重叠）");
})();