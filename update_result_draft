(function(){
// 你的截图里完整Case数据
const caseData = `1734833	Passed	25.05.2026 qz715a: passed. Manually evaluated as pass. P_ADcLow_AdmissGuid==64d Trigger not same. With GER TS(1782001) Next: TA need to be fixed, all other evaluations are met
