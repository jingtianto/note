1734841	Passed	25.05.2026 qz715a: passed. Automatically passed`;

    // 构建ID映射字典
    const idMap = {};
    caseData.split('\n').forEach(line=>{
        const parts = line.trim().split(/\t+/);
        const cid = parts[0]?.trim();
        if(!cid) return;
        idMap[cid] = {
            result: parts[1]?.trim() || '',
            remark: parts.slice(2).join('\t').trim() || ''
        };
    });

    console.log(`✅ 成功加载 ${Object.keys(idMap).length} 条Case数据`);

    const processed = new WeakSet();

    // Slick Grid专属渲染函数
    function render(){
        // 精准匹配 slick-grid 所有行
        const rows = document.querySelectorAll('.slick-row');
        let matchCount = 0;

        rows.forEach(row=>{
            if(processed.has(row)) return;

            // 获取当前行所有单元格
            const cells = row.querySelectorAll('.slick-cell');
            let targetCell = null;
            let matchedId = null;

            // 精准匹配纯数字CaseID
            for(const cell of cells){
                const text = cell.textContent.trim().replace(/\s+/g,'');
                if(idMap[text]){
                    matchedId = text;
                    targetCell = cell;
                    break;
                }
            }

            if(!targetCell) return;
            matchCount++;

            // 新建结果辅助列
            const resCol = document.createElement('div');
            resCol.style = 'display:inline-block;background:#d4edda;border:1px solid #28a745;padding:6px 8px;cursor:pointer;max-width:300px;word-break:break-all;margin:0 4px;';
            resCol.textContent = idMap[matchedId].result;
            resCol.onclick = ()=>{
                navigator.clipboard.writeText(resCol.textContent);
                alert('✅ 已复制执行结果');
            };

            // 新建备注辅助列（完美保留长文本+换行）
            const remCol = document.createElement('div');
            remCol.style = 'display:inline-block;background:#cce5ff;border:1px solid #007bff;padding:6px 8px;cursor:pointer;max-width:600px;white-space:pre-wrap;word-break:break-all;margin:0 4px;';
            remCol.textContent = idMap[matchedId].remark;
            remCol.onclick = ()=>{
                navigator.clipboard.writeText(remCol.textContent);
                alert('✅ 已复制完整备注');
            };

            // 插入到ID单元格右侧
            targetCell.after(resCol, remCol);
            processed.add(row);
        });

        console.log(`✅ 本次匹配成功填充 ${matchCount} 条，累计 ${processed.size} 条`);
    }

    // 等待Slick Grid完全渲染，多次兜底执行
    setTimeout(render, 800);
    setTimeout(render, 2000);
    setTimeout(render, 4000);

    // 监听滚动懒加载、分页、表格刷新
    let timer = null;
    new MutationObserver(()=>{
        clearTimeout(timer);
        timer = setTimeout(render, 300);
    }).observe(document.body, {childList:true, subtree:true});

    // 滚动页面自动填充新加载的行
    window.addEventListener('scroll', ()=>{
        clearTimeout(timer);
        timer = setTimeout(render, 400);
    });

    console.log("🚀 Slick Grid专属脚本已启动，滚动自动识别新行");
})();
