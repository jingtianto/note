1737685	Passed	25.05.2026 qz629N: Passed.Manually evaluated as passed ML need updeate Required targetcurve[CN_stack_DFT_ModelCN_stack_DFT_stack]==180d, t=AdcLow_AdmissGuid_128+0.5s: Expected value delay with 3.29s (GER 1777543 result:3.315s)
1737686	Passed	25.05.2026 qz629N: Passed. Manually evaluated as passed
1737689	Passed	LimitSteaterAccelerationRequest always 0 compare with GER TS 1777543
1737951	Passed	25.05.2026 qz715a: passed. Automatically passed
1737952	Passed	25.05.2026 qz715a: passed. Automatically passed
1737963	Passed	25.05.2026 qz715a: passed.manually evaluated as pass
1737965	Passed	19.05.2026 qz715a:max(excepded14+16), GER 1779087 result:16.0039
1754198	Passed	25.05.2026 qz629N: Passed. Manually evaluated as passed. Compare with GER TS 1779087
1760607	Passed	Stimulation time out, but all required signal value passed
1757611	Passed	25.05.2026 qz715a: Passed. Automatically passed
1757613	Passed	25.05.2026 qz715a: Passed. Automatically passed
1737233	Passed	25.05.2026 qz715a: Passed. Automatically passed
1734835	Passed	25.05.2026 qz715a: passed. Automatically passed
1734836	Passed	25.05.2026 qz715a: passed. Automatically passed
1734838	Passed	25.05.2026 qz715a: passed. Automatically passed
1734841	Passed	25.05.2026 qz715a: passed. Automatically passed`;

    // 构建 ID -> {result, remark} 映射
    const idMap = {};
    caseData.split('\n').forEach(line => {
        const parts = line.trim().split(/\t+/);
        const cid = parts[0]?.trim();
        if (!cid) return;
        idMap[cid] = {
            result: parts[1]?.trim() || '',
            remark: parts.slice(2).join('\t').trim() || ''
        };
    });
    console.log(`✅ 已加载 ${Object.keys(idMap).length} 条Case数据`);

    // ==================== 辅助函数 ====================
    function copyToClip(text, label) {
        navigator.clipboard.writeText(text).then(() => {
            alert(`✅ 已复制${label}`);
        }).catch(() => {
            alert(`❌ 复制${label}失败，请手动复制`);
        });
    }

    // 创建悬浮层（包含 ID、结果、备注 三列）
    function createFloatingBadge(id, result, remark, targetCell) {
        const wrapper = document.createElement('div');
        wrapper.className = 'slick-extra-floating';
        wrapper.style.cssText = `
            position: fixed;
            background: white;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-shadow: 2px 2px 8px rgba(0,0,0,0.2);
            z-index: 100000;
            display: inline-flex;
            gap: 6px;
            padding: 4px 8px;
            pointer-events: auto;
            white-space: nowrap;
        `;

        // ID 徽章（灰色背景，用于核对）
        const idSpan = document.createElement('span');
        idSpan.textContent = id;
        idSpan.style.cssText = `
            background: #e9ecef;
            border: 1px solid #6c757d;
            padding: 2px 8px;
            border-radius: 12px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 500;
        `;
        idSpan.title = '点击复制 Case ID';
        idSpan.onclick = (e) => {
            e.stopPropagation();
            copyToClip(id, 'Case ID');
        };

        // 结果徽章（绿色）
        const resSpan = document.createElement('span');
        resSpan.textContent = result;
        resSpan.style.cssText = `
            background: #d4edda;
            border: 1px solid #28a745;
            padding: 2px 8px;
            border-radius: 12px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 500;
        `;
        resSpan.title = '点击复制执行结果';
        resSpan.onclick = (e) => {
            e.stopPropagation();
            copyToClip(result, '执行结果');
        };

        // 备注徽章（蓝色，长文本截断）
        const shortRemark = remark.length > 30 ? remark.substring(0, 30) + '…' : remark;
        const remSpan = document.createElement('span');
        remSpan.textContent = shortRemark;
        remSpan.style.cssText = `
            background: #cce5ff;
            border: 1px solid #007bff;
            padding: 2px 8px;
            border-radius: 12px;
            cursor: pointer;
            font-size: 12px;
            max-width: 300px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        `;
        remSpan.title = remark;
        remSpan.onclick = (e) => {
            e.stopPropagation();
            copyToClip(remark, '完整备注');
        };

        wrapper.appendChild(idSpan);
        wrapper.appendChild(resSpan);
        wrapper.appendChild(remSpan);
        document.body.appendChild(wrapper);

        // 定位到目标单元格的右侧
        function updatePosition() {
            const rect = targetCell.getBoundingClientRect();
            wrapper.style.left = rect.right + 5 + 'px';
            wrapper.style.top = rect.top + 'px';
        }
        updatePosition();

        // 监听滚动和窗口变化更新位置
        const updateHandler = () => updatePosition();
        window.addEventListener('scroll', updateHandler, true);
        window.addEventListener('resize', updateHandler);

        // 清理函数
        wrapper._cleanup = () => {
            window.removeEventListener('scroll', updateHandler, true);
            window.removeEventListener('resize', updateHandler);
        };
        return wrapper;
    }

    let floatingMap = new WeakMap(); // cell -> {wrapper, cleanup}

    function updateOrCreateFloating(cell, matchedId) {
        const { result, remark } = idMap[matchedId];
        let entry = floatingMap.get(cell);
        if (entry) {
            // 更新现有悬浮层内容（ID不会变，但结果和备注可能变）
            const wrapper = entry.wrapper;
            const children = wrapper.children; // [idSpan, resSpan, remSpan]
            if (children.length >= 3) {
                const resSpan = children[1];
                const remSpan = children[2];
                if (resSpan.textContent !== result) {
                    resSpan.textContent = result;
                    resSpan.onclick = (e) => {
                        e.stopPropagation();
                        copyToClip(result, '执行结果');
                    };
                }
                const newShortRemark = remark.length > 30 ? remark.substring(0, 30) + '…' : remark;
                if (remSpan.textContent !== newShortRemark) {
                    remSpan.textContent = newShortRemark;
                    remSpan.title = remark;
                    remSpan.onclick = (e) => {
                        e.stopPropagation();
                        copyToClip(remark, '完整备注');
                    };
                }
            }
            // 更新位置
            const rect = cell.getBoundingClientRect();
            wrapper.style.left = rect.right + 5 + 'px';
            wrapper.style.top = rect.top + 'px';
        } else {
            // 创建新的悬浮层，传入 matchedId 作为 ID 显示
            const wrapper = createFloatingBadge(matchedId, result, remark, cell);
            floatingMap.set(cell, { wrapper, cleanup: wrapper._cleanup });
        }
    }

    // ==================== 核心渲染 ====================
    function render() {
        const rows = document.querySelectorAll('.slick-row');
        let matchCount = 0;

        rows.forEach(row => {
            const cells = row.querySelectorAll('.slick-cell');
            let targetCell = null;
            let matchedId = null;

            for (const cell of cells) {
                const cleanText = cell.textContent.trim().replace(/\s+/g, '');
                if (idMap[cleanText]) {
                    matchedId = cleanText;
                    targetCell = cell;
                    break;
                }
            }

            if (!targetCell) return;
            matchCount++;
            updateOrCreateFloating(targetCell, matchedId);
        });

        if (matchCount) console.log(`✅ 已处理 ${matchCount} 行，悬浮三列（ID/结果/备注）已显示`);
    }

    // ==================== 启动监听 ====================
    setTimeout(render, 800);
    setTimeout(render, 2000);
    setTimeout(render, 4000);

    let timer = null;
    new MutationObserver(() => {
        clearTimeout(timer);
        timer = setTimeout(render, 300);
    }).observe(document.body, { childList: true, subtree: true });

    window.addEventListener('scroll', () => {
        clearTimeout(timer);
        timer = setTimeout(render, 400);
    });

    console.log("🚀 已启动 Slick Grid 三列辅助浮层（ID + 结果 + 备注），无重叠");
})();